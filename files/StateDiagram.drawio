<mxfile host="app.diagrams.net" agent="Antigravity IDE / UML 2.5 High-Readability Zero-Collision Edition" pages="3">
  <diagram id="diag_st01" name="State-01: Vòng Đời Giao Dịch Chi Tiêu">
    <mxGraphModel dx="1719" dy="1071" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#4a6b82;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;align=center;arcSize=6;" value="&lt;b style=&#39;font-size:18px;&#39;&gt;BIỂU ĐỒ TRẠNG THÁI STATE-01: VÒNG ĐỜI GIAO DỊCH CHI TIÊU (EXPENSE ENTITY LIFECYCLE)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:14px;color:#3b5998;&#39;&gt;Chuẩn UML 2.5 State Machine mô tả vòng đời thực thể giao dịch từ Nháp (DRAFT) đến Hoàn tất (COMPLETED) hoặc Hủy (CANCELLED)&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="1600" x="60" y="25" as="geometry" />
        </mxCell>
        <mxCell id="st1_start" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2c3e50;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="86" y="260" as="geometry" />
        </mxCell>
        <mxCell id="st1_draft" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;DRAFT (Nháp)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;entry / Khởi tạo Form &amp; nạp dữ liệu OCR&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="240" x="200" y="130" as="geometry" />
        </mxCell>
        <mxCell id="st1_verified" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;VERIFIED (Đã Xác Minh)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;entry / Đối soát số học khớp Delta=0&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="250" x="558" y="270" as="geometry" />
        </mxCell>
        <mxCell id="st1_choice" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="1018" y="220" as="geometry" />
        </mxCell>
        <mxCell id="st1_completed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;COMPLETED (Hoàn Tất)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;entry / Khấu trừ tiền ví &amp; ghi sổ cái&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="240" x="1252" y="270" as="geometry" />
        </mxCell>
        <mxCell id="st1_end_comp" parent="1" style="ellipse;html=1;shape=endState;fillColor=#2c3e50;strokeColor=#2c3e50;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1617" y="220" as="geometry" />
        </mxCell>
        <mxCell id="st1_pending" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;PENDING_COOLING_OFF&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;entry / Khóa 24h &amp; chưa trừ ví&lt;br&gt;do / Kích hoạt đếm ngược 24:00:00&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="270" x="825" y="470" as="geometry" />
        </mxCell>
        <mxCell id="st1_choice_24h" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="1018" y="680" as="geometry" />
        </mxCell>
        <mxCell id="st1_cancelled" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;CANCELLED (Đã Hủy)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;entry / Hủy bản ghi giao dịch&lt;br&gt;alert / Chúc mừng tiết kiệm tiền&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="250" x="475" y="680" as="geometry" />
        </mxCell>
        <mxCell id="st1_end_canc" parent="1" style="ellipse;html=1;shape=endState;fillColor=#2c3e50;strokeColor=#2c3e50;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="305" y="680" as="geometry" />
        </mxCell>
        <mxCell id="t1_1" edge="1" parent="1" source="st1_start" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="st1_draft" value="Chụp ảnh hóa đơn / Khởi tạo Form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1_2" edge="1" parent="1" source="st1_draft" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="st1_verified" value="Kiểm toán số học [Delta == 0] / Gắn cờ hợp lệ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1_3" edge="1" parent="1" source="st1_verified" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="st1_choice" value="Xác nhận Form / Thẩm định ngưỡng">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1_4a" edge="1" parent="1" source="st1_choice" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="st1_completed" value="[Chi thường: &lt;= 3 triệu] / Khấu trừ ví">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1_4b" edge="1" parent="1" source="st1_choice" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="[Chi lớn: &gt; 3 triệu] / Kích hoạt khóa 24h">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1038" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t1_5" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="st1_choice_24h" value="Hết hạn 24h [Cron nhắc nhở] / Hỏi quyết định">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1038" y="555" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t1_6a" edge="1" parent="1" source="st1_choice_24h" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="st1_cancelled" value="[Chọn Hủy: Tiết kiệm] / Hủy giao dịch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1_6b" edge="1" parent="1" source="st1_choice_24h" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="st1_completed" value="[Chọn Mua: Có suy xét] / Khấu trừ ví">
          <mxGeometry relative="1" x="-0.0542" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
