          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag_st02" name="State-02: Vòng Đời Kế Hoạch Trả Nợ">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#4a6b82;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;align=center;arcSize=6;" value="&lt;b style=&#39;font-size:18px;&#39;&gt;BIỂU ĐỒ TRẠNG THÁI STATE-02: VÒNG ĐỜI KẾ HOẠCH TRẢ NỢ CÁ NHÂN (DEBT PLAN LIFECYCLE)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:14px;color:#3b5998;&#39;&gt;Chuẩn UML 2.5 State Machine mô tả chiến lược trả nợ (Snowball / Avalanche), chu kỳ tăng tốc và quản trị rủi ro nợ&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="1600" x="60" y="25" as="geometry" />
        </mxCell>
        <mxCell id="st2_start" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2c3e50;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="86" y="370" as="geometry" />
        </mxCell>
        <mxCell id="st2_plan" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;PLANNING (Khởi Tạo)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;entry / Liệt kê nợ &amp; lãi suất&lt;br&gt;do / Chọn chiến lược Snowball / Avalanche&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="260" x="230" y="265" as="geometry" />
        </mxCell>
        <mxCell id="st2_active" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;ACTIVE (Đang Thực Thi)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;do / Trả nợ định kỳ hàng tháng&lt;br&gt;do / Khấu trừ gốc &amp; lãi theo thứ tự&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="260" x="610" y="370" as="geometry" />
        </mxCell>
        <mxCell id="st2_accel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;ACCELERATED (Tăng Tốc)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;entry / Nhận thưởng hoặc dư ngân sách&lt;br&gt;do / Dồn thêm tiền trả sớm nợ ưu tiên&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="260" x="990" y="180" as="geometry" />
        </mxCell>
        <mxCell id="st2_overdue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;OVERDUE_RISK (Báo Động)&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;entry / Trễ hạn thanh toán &gt; 15 ngày&lt;br&gt;do / Cảnh báo &amp; thắt lưng buộc bụng&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="260" x="990" y="570" as="geometry" />
        </mxCell>
        <mxCell id="st2_settled" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=15;fontColor=#2c3e50;align=center;verticalAlign=middle;" value="&lt;b style=&#39;font-size:16px;&#39;&gt;SETTLED / PAID_OFF&lt;/b&gt;&lt;br&gt;&lt;i style=&#39;font-size:13px;color:#2c3e50;&#39;&gt;entry / Toàn bộ dư nợ sạch về 0 VNĐ&lt;br&gt;alert / Chúc mừng tự do tài chính&lt;/i&gt;" vertex="1">
          <mxGeometry height="85" width="250" x="1310" y="370" as="geometry" />
        </mxCell>
        <mxCell id="st2_end" parent="1" style="ellipse;html=1;shape=endState;fillColor=#2c3e50;strokeColor=#2c3e50;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1620" y="520" as="geometry" />
        </mxCell>
        <mxCell id="t2_1" edge="1" parent="1" source="st2_start" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="st2_plan" value="Khởi tạo mục tiêu xóa nợ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2_2" edge="1" parent="1" source="st2_plan" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="st2_active" value="Xác nhận kế hoạch [Bắt đầu chu kỳ]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2_5a" edge="1" parent="1" source="st2_active" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="st2_settled" value="Khoản nợ cuối cùng sạch [Dư nợ = 0]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2_6" edge="1" parent="1" source="st2_settled" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="st2_end" value="Hoàn tất mục tiêu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2_3a" edge="1" parent="1" source="st2_active" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="st2_accel" value="Có thặng dư [Dồn tiền thêm]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2_3b" edge="1" parent="1" source="st2_accel" style="edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2c3e50;strokeWidth=1.5;fontFamily=Segoe UI, Arial, sans-serif;fontSize=14;fontColor=#2c3e50;labelBackgroundColor=#ffffff;labelBorderColor=none;spacing=4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" target="st2_active" value="Hết tiền dư [Về trả định kỳ]">
