<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ExpenseTracker.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ExpenseTracker.Maui"
    xmlns:views="clr-namespace:ExpenseTracker.Maui.Views"
    Title="DuoNoPro"
    FlyoutBehavior="Flyout"
    FlyoutWidth="330"
    FlyoutBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0B0F19}">

    <!-- ======================================================== -->
    <!-- LUXURY FINTECH FLYOUT HEADER                             -->
    <!-- ======================================================== -->
    <Shell.FlyoutHeader>
        <Border BackgroundColor="#1E1B4B" Padding="20,44,20,20" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0.0" />
                    <GradientStop Color="#1E1B4B" Offset="0.5" />
                    <GradientStop Color="#312E81" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <VerticalStackLayout Spacing="14">
                <!-- App Identity & Pro Badge -->
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Border WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 14"
                            StrokeThickness="0" BackgroundColor="#4F46E5">
                        <Label Text="💎" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="DuoNoPro" FontSize="18" FontAttributes="Bold" TextColor="#FFFFFF" />
                        <Border BackgroundColor="#3730A3" StrokeShape="RoundRectangle 6" Padding="6,2" HorizontalOptions="Start">
                            <Label Text="✨ FINTECH PRO" FontSize="9" FontAttributes="Bold" TextColor="#A5B4FC" />
                        </Border>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Daily Safe Spending (DSA) Indicator Chip -->
                <Border BackgroundColor="#111827" Stroke="#312E81" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="HẠN MỨC AN TOÀN (DSA)" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                            <Label Text="450,000 đ / ngày" FontSize="13" FontAttributes="Bold" TextColor="#10B981" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="🟢 0ms" FontSize="11" TextColor="#6EE7B7" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <!-- ======================================================== -->
    <!-- CUSTOM LUXURY FLYOUT ITEM TEMPLATE                       -->
    <!-- ======================================================== -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="44" Padding="16,4" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- ======================================================== -->
    <!-- NHÓM 1: TÀI CHÍNH CỐT LÕI (CORE FINANCE)                 -->
    <!-- ======================================================== -->
    <FlyoutItem Title="👛  Quản Lý Đa Ví (Tổng Quan)" Route="WalletsPage">
        <ShellContent ContentTemplate="{DataTemplate views:WalletsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="💸  Chi Tiêu &amp; Khoản Chi" Route="ExpensesPage">
        <ShellContent ContentTemplate="{DataTemplate views:ExpensesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="💰  Thu Nhập Cá Nhân" Route="IncomesPage">
        <ShellContent ContentTemplate="{DataTemplate views:IncomesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="🔄  Thu Nhập Định Kỳ" Route="RecurringIncomesPage">
        <ShellContent ContentTemplate="{DataTemplate views:RecurringIncomesPage}" />
    </FlyoutItem>

    <!-- ======================================================== -->
    <!-- NHÓM 2: TRÍ TUỆ NHÂN TẠO & TIỆN ÍCH (AI VISION)          -->
    <!-- ======================================================== -->
    <FlyoutItem Title="🧾  Quét Hóa Đơn AI OCR" Route="ReceiptOcrPage">
        <ShellContent ContentTemplate="{DataTemplate views:ReceiptOcrPage}" />
    </FlyoutItem>

    <FlyoutItem Title="📑  Bóc Tách Phiếu Lương" Route="PayslipOcrPage">
        <ShellContent ContentTemplate="{DataTemplate views:PayslipOcrPage}" />
    </FlyoutItem>

    <FlyoutItem Title="⚡  Tiện Ích &amp; VietQR" Route="SmartUtilitiesPage">
        <ShellContent ContentTemplate="{DataTemplate views:SmartUtilitiesPage}" />
    </FlyoutItem>

    <!-- ======================================================== -->
    <!-- NHÓM 3: KỶ LUẬT NGÂN SÁCH (BUDGET & SAVINGS)             -->
    <!-- ======================================================== -->
    <FlyoutItem Title="📊  Ngân Sách &amp; Hạn Mức DSA" Route="BudgetsPage">
        <ShellContent ContentTemplate="{DataTemplate views:BudgetsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="🎯  Mục Tiêu Tích Lũy" Route="SavingsGoalsPage">
        <ShellContent ContentTemplate="{DataTemplate views:SavingsGoalsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="🏷️  Cây Danh Mục Thu Chi" Route="CategoriesPage">
        <ShellContent ContentTemplate="{DataTemplate views:CategoriesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="⚙️  Quy Tắc Tự Động Hóa" Route="AutoRulesPage">
        <ShellContent ContentTemplate="{DataTemplate views:AutoRulesPage}" />
    </FlyoutItem>

    <!-- ======================================================== -->
    <!-- NHÓM 4: TÂM LÝ HÀNH VI & DỰ BÁO (BEHAVIORAL FINANCE)     -->
    <!-- ======================================================== -->
    <FlyoutItem Title="💡  Cú Hích Thaler Nudge" Route="NudgeFeedPage">
        <ShellContent ContentTemplate="{DataTemplate views:NudgeFeedPage}" />
    </FlyoutItem>

    <FlyoutItem Title="⏳  Khoảng Trễ 24h Mua Sắm" Route="CoolingOffHubPage">
        <ShellContent ContentTemplate="{DataTemplate views:CoolingOffHubPage}" />
    </FlyoutItem>

    <FlyoutItem Title="📈  Dự Báo Dòng Tiền &amp; Rủi Ro" Route="ForecastingPage">
        <ShellContent ContentTemplate="{DataTemplate views:ForecastingPage}" />
    </FlyoutItem>

    <FlyoutItem Title="📑  Báo Cáo Tài Chính Đa Chiều" Route="ReportsPage">
        <ShellContent ContentTemplate="{DataTemplate views:ReportsPage}" />
    </FlyoutItem>

    <!-- ======================================================== -->
    <!-- NHÓM 5: THIẾT LẬP & TÀI KHOẢN (SYSTEM & SECURITY)        -->
    <!-- ======================================================== -->
    <FlyoutItem Title="🔔  Lịch Sử &amp; Thông Báo" Route="NotificationHistoryPage">
        <ShellContent ContentTemplate="{DataTemplate views:NotificationHistoryPage}" />
    </FlyoutItem>

    <FlyoutItem Title="⚙️  Cài Đặt Máy Chủ &amp; Demo" Route="SettingsPage">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="👤  Tài Khoản &amp; Đăng Nhập" Route="LoginPage">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
    </FlyoutItem>

</Shell>
