<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ExpenseTracker.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ExpenseTracker.Maui.Views"
    Title="DuoNoPro Finance"
    FlyoutBehavior="Flyout"
    FlyoutWidth="330"
    FlyoutBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0B0F17}"
    Shell.TabBarIsVisible="False">

    <Shell.FlyoutHeader>
        <Border Padding="20,44,20,20" StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0.0" />
                    <GradientStop Color="#1E1B4B" Offset="0.6" />
                    <GradientStop Color="#312E81" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <VerticalStackLayout Spacing="14">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Border WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 14"
                            StrokeThickness="0" BackgroundColor="#4F46E5">
                        <Image Source="ic_diamond.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="DuoNoPro Finance" FontSize="17" FontAttributes="Bold" TextColor="#FFFFFF" />
                        <Border BackgroundColor="#3730A3" StrokeShape="RoundRectangle 6" Padding="8,3" HorizontalOptions="Start">
                            <Label Text="TÀI CHÍNH THÔNG MINH" FontSize="9" FontAttributes="Bold" TextColor="#A5B4FC" />
                        </Border>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border BackgroundColor="#111827" Stroke="#312E81" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="HẠN MỨC TIÊU DÙNG HÔM NAY" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" />
                            <Label Text="450.000 đ / ngày" FontSize="14" FontAttributes="Bold" TextColor="#10B981" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#064E3B" StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                            <Label Text="AN TOÀN" FontSize="10" TextColor="#6EE7B7" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="46" Padding="16,4" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Image Grid.Column="0"
                       Source="{Binding FlyoutIcon}"
                       WidthRequest="22" HeightRequest="22"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- CÁC TRANG CỐT LÕI (DÙNG FLYOUTITEM, HOÀN TOÀN KHÔNG DÙNG TABBAR ĐỂ TRÁNH LỖI CHỒNG THANH ĐÁY) -->
    <FlyoutItem Title="Tổng Quan Đa Ví" FlyoutIcon="ic_wallet.svg" Route="WalletsPage">
        <ShellContent ContentTemplate="{DataTemplate views:WalletsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Quản Lý &amp; Thiết Lập Các Ví" FlyoutIcon="ic_wallet.svg" Route="ManageWalletsPage">
        <ShellContent ContentTemplate="{DataTemplate views:ManageWalletsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Sổ Chi Tiêu Cá Nhân" FlyoutIcon="ic_expense.svg" Route="ExpensesPage">
        <ShellContent ContentTemplate="{DataTemplate views:ExpensesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Thu Nhập Cá Nhân" FlyoutIcon="ic_income.svg" Route="IncomesPage">
        <ShellContent ContentTemplate="{DataTemplate views:IncomesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Nguồn Thu Định Kỳ" FlyoutIcon="ic_rules.svg" Route="RecurringIncomesPage">
        <ShellContent ContentTemplate="{DataTemplate views:RecurringIncomesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Ngân Sách &amp; Hạn Mức An Toàn" FlyoutIcon="ic_budget.svg" Route="BudgetsPage">
        <ShellContent ContentTemplate="{DataTemplate views:BudgetsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mục Tiêu Tiết Kiệm Tích Lũy" FlyoutIcon="ic_savings.svg" Route="SavingsGoalsPage">
        <ShellContent ContentTemplate="{DataTemplate views:SavingsGoalsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Danh Mục Thu Chi" FlyoutIcon="ic_category.svg" Route="CategoriesPage">
        <ShellContent ContentTemplate="{DataTemplate views:CategoriesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Quy Tắc Tự Động Phân Loại" FlyoutIcon="ic_rules.svg" Route="AutoRulesPage">
        <ShellContent ContentTemplate="{DataTemplate views:AutoRulesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Báo Cáo &amp; Phân Tích Tài Chính" FlyoutIcon="ic_reports.svg" Route="ReportsPage">
        <ShellContent ContentTemplate="{DataTemplate views:ReportsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Cú Hích Tài Chính Thaler" FlyoutIcon="ic_nudge.svg" Route="NudgeFeedPage">
        <ShellContent ContentTemplate="{DataTemplate views:NudgeFeedPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Khoảng Trễ Mua Sắm 24 Giờ" FlyoutIcon="ic_cooling.svg" Route="CoolingOffHubPage">
        <ShellContent ContentTemplate="{DataTemplate views:CoolingOffHubPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Thử Nghiệm Mua Sắm Trước Khi Chi" FlyoutIcon="ic_forecast.svg" Route="ForecastingPage">
        <ShellContent ContentTemplate="{DataTemplate views:ForecastingPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Lộ Trình Sạch Nợ (Snowball/Avalanche)" FlyoutIcon="ic_debt.svg" Route="DebtOptimizerPage">
        <ShellContent ContentTemplate="{DataTemplate views:DebtOptimizerPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Quỹ Dự Phòng Khẩn Cấp" FlyoutIcon="ic_shield.svg" Route="EmergencyFundPage">
        <ShellContent ContentTemplate="{DataTemplate views:EmergencyFundPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Bẫy Thuê Bao &amp; Chi Phí Định Kỳ" FlyoutIcon="ic_subscription.svg" Route="SubscriptionsPage">
        <ShellContent ContentTemplate="{DataTemplate views:SubscriptionsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Quét Hóa Đơn AI OCR" FlyoutIcon="ic_ocr.svg" Route="ReceiptOcrPage">
        <ShellContent ContentTemplate="{DataTemplate views:ReceiptOcrPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Quét Bảng Lương Payslip" FlyoutIcon="ic_reports.svg" Route="PayslipOcrPage">
        <ShellContent ContentTemplate="{DataTemplate views:PayslipOcrPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mã Chuyển Khoản Nhanh VietQR" FlyoutIcon="ic_card.svg" Route="SmartUtilitiesPage">
        <ShellContent ContentTemplate="{DataTemplate views:SmartUtilitiesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Thông Báo Từ Hệ Thống" FlyoutIcon="ic_bell.svg" Route="NotificationHistoryPage">
        <ShellContent ContentTemplate="{DataTemplate views:NotificationHistoryPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Cài Đặt Hệ Thống &amp; Bảo Mật" FlyoutIcon="ic_settings.svg" Route="SettingsPage">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Hồ Sơ &amp; Đăng Xuất" FlyoutIcon="ic_user.svg" Route="LoginPage">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Đăng Nhập Nhanh" FlyoutItemIsVisible="False" Route="QuickLoginPage">
        <ShellContent ContentTemplate="{DataTemplate views:QuickLoginPage}" />
    </FlyoutItem>

</Shell>