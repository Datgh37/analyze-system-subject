<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             x:Class="ExpenseTracker.Maui.Views.QuickLoginPage"
             x:DataType="vm:QuickLoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <ScrollView>
        <VerticalStackLayout Spacing="28" Padding="24,50,24,36" MaximumWidthRequest="460" VerticalOptions="Center">
            
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        WidthRequest="32"
                        HeightRequest="32"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
                    <Image Source="ic_diamond.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="DuoNoPro Finance" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border Stroke="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 46"
                        WidthRequest="92"
                        HeightRequest="92"
                        HorizontalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource Neutral800}}">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" 
                                Offset="0,4" Radius="12" Opacity="0.25" />
                    </Border.Shadow>
                    <Image Source="ic_user.svg"
                           WidthRequest="44"
                           HeightRequest="44"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="{Binding GreetingText}" 
                       FontSize="13" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <Label Text="{Binding UserFullName}" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                <Label Text="{Binding UserEmail}" 
                       FontSize="12" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource FintechCard}" Padding="24,28">
                <VerticalStackLayout Spacing="18" HorizontalOptions="Center">

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 40"
                            WidthRequest="80"
                            HeightRequest="80"
                            HorizontalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
                        <Border.Shadow>
                            <Shadow Brush="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" 
                                    Offset="0,6" Radius="16" Opacity="0.3" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ScanBiometricCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image Source="ic_shield.svg" 
                                   WidthRequest="40" 
                                   HeightRequest="40" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                            <ActivityIndicator IsRunning="{Binding IsScanning}"
                                               IsVisible="{Binding IsScanning}"
                                               Color="#FFFFFF"
                                               WidthRequest="36"
                                               HeightRequest="36"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Xác Thực Sinh Trắc Học" 
                               FontSize="15" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        
                        <Label Text="{Binding StatusMessage}" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Text="Chạm Để Quét Lại"
                            Command="{Binding ScanBiometricCommand}"
                            IsVisible="{Binding CanRetry}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource Neutral800}}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="38"
                            Padding="18,0"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Button Text="Đăng Nhập Bằng Mật Khẩu" 
                        Command="{Binding UsePasswordCommand}"
                        Style="{StaticResource FintechButtonPrimary}"
                        HeightRequest="46" />

                <Button Text="Sử Dụng Tài Khoản Khác" 
                        Command="{Binding SwitchAccountCommand}"
                        Style="{StaticResource FintechButtonSecondary}"
                        HeightRequest="42" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>