<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels.Autonomous"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Autonomous"
             xmlns:views="clr-namespace:ExpenseTracker.Maui.Views.Autonomous"
             x:Class="ExpenseTracker.Maui.Views.Autonomous.ActionInboxView"
             x:DataType="vm:ActionInboxViewModel">

    <VerticalStackLayout Spacing="8">
        <Border Stroke="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral800}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource CardBgDark}}"
                Padding="10,8">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Thử nghiệm giao dịch nhanh"
                           FontAttributes="Bold"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="5 Ngân hàng"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                           VerticalOptions="Center" />
                </Grid>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="6">
                        <Button Text="ACB (-350k)"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="32"
                                Padding="10,0"
                                CornerRadius="16"
                                BackgroundColor="{AppThemeBinding Light=#E0F2FE, Dark=#075985}"
                                TextColor="{AppThemeBinding Light=#0284C7, Dark=#BAE6FD}"
                                Command="{Binding SimulateBankNotificationCommand}"
                                CommandParameter="ACB" />

                        <Button Text="MoMo (-85k)"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="32"
                                Padding="10,0"
                                CornerRadius="16"
                                BackgroundColor="{AppThemeBinding Light=#FCE7F3, Dark=#831843}"
                                TextColor="{AppThemeBinding Light=#DB2777, Dark=#FBCFE8}"
                                Command="{Binding SimulateBankNotificationCommand}"
                                CommandParameter="MOMO" />

                        <Button Text="Techcombank (-120k)"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="32"
                                Padding="10,0"
                                CornerRadius="16"
                                BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#7F1D1D}"
                                TextColor="{AppThemeBinding Light=#DC2626, Dark=#FECACA}"
                                Command="{Binding SimulateBankNotificationCommand}"
                                CommandParameter="TCB" />

                        <Button Text="Vietcombank (-500k)"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="32"
                                Padding="10,0"
                                CornerRadius="16"
                                BackgroundColor="{AppThemeBinding Light=#DCFCE7, Dark=#14532D}"
                                TextColor="{AppThemeBinding Light=#16A34A, Dark=#BBF7D0}"
                                Command="{Binding SimulateBankNotificationCommand}"
                                CommandParameter="VCB" />

                        <Button Text="MBBank (-200k)"
                                FontSize="11"
                                FontAttributes="Bold"
                                HeightRequest="32"
                                Padding="10,0"
                                CornerRadius="16"
                                BackgroundColor="{AppThemeBinding Light=#EDE9FE, Dark=#4C1D95}"
                                TextColor="{AppThemeBinding Light=#7C3AED, Dark=#DDD6FE}"
                                Command="{Binding SimulateBankNotificationCommand}"
                                CommandParameter="MB" />
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Spacing="8"
                             IsVisible="{Binding HasPendingActions}">
            <Grid ColumnDefinitions="*,Auto" Padding="2,0">
                <Label Grid.Column="0"
                       Text="{Binding ActionCount, StringFormat='Giao dịch cần xác nhận ({0})'}"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="Làm mới"
                        FontSize="11"
                        FontAttributes="Bold"
                        HeightRequest="30"
                        Padding="12,0"
                        CornerRadius="15"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource Neutral800}}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                        Command="{Binding LoadInboxCommand}" />
            </Grid>

            <Border Stroke="{StaticResource Emerald500}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Emerald100}, Dark={StaticResource Neutral900}}"
                    Padding="10,6"
                    IsVisible="{Binding ActionStatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                <Label Text="{Binding ActionStatusMessage}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Emerald700}, Dark={StaticResource Emerald500}}" />
            </Border>

            <VerticalStackLayout Spacing="8"
                                 BindableLayout.ItemsSource="{Binding PendingActions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:AutonomousActionModel">
                        <views:SmartActionCardView
                            BindingContext="{Binding .}"
                            QuickCommitCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:ActionInboxViewModel}}, Path=QuickCommitCommand}"
                            DismissCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:ActionInboxViewModel}}, Path=DismissCommand}"
                            NavigateCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:ActionInboxViewModel}}, Path=NavigateToSecondaryCommand}"
                            SelectChoiceCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:ActionInboxViewModel}}, Path=SelectChoiceCommand}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>