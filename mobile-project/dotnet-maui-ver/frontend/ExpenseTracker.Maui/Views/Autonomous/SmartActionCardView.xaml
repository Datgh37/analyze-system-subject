<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Autonomous"
             x:Class="ExpenseTracker.Maui.Views.Autonomous.SmartActionCardView"
             x:Name="thisCard"
             x:DataType="models:AutonomousActionModel">

    <!-- WIRED-FRAME ONLY: Clean structure and data binding, ready for visual UI styling -->
    <Border Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 10"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
            Padding="14"
            Margin="0,0,0,10">
        
        <VerticalStackLayout Spacing="10">
            <!-- Header Row: Category Badge + Bank/Time Subtitle + Dismiss Button -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <!-- Category Badge -->
                <Border Grid.Column="0"
                        Stroke="Transparent"
                        BackgroundColor="{Binding Display.BadgeColor}"
                        StrokeShape="RoundRectangle 6"
                        Padding="8,3">
                    <Label Text="{Binding Display.BadgeText}"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />
                </Border>

                <!-- Bank Source and Time Subtitle -->
                <Label Grid.Column="1"
                       Text="{Binding Display.Subtitle}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                       VerticalOptions="Center" />

                <!-- Dismiss Button -->
                <Button Grid.Column="2"
                        Text="✕"
                        FontSize="12"
                        WidthRequest="28"
                        HeightRequest="28"
                        Padding="0"
                        CornerRadius="14"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                        Command="{Binding Source={x:Reference thisCard}, Path=DismissCommand}"
                        CommandParameter="{Binding .}" />
            </Grid>

            <!-- Title & Monetary Amount -->
            <Label Text="{Binding Display.Title}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

            <!-- ACTION BUTTONS ROW -->
            <VerticalStackLayout Spacing="8">
                <!-- Case A: High Confidence -> 1-Tap Quick Commit + Navigate -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                      IsVisible="{Binding PrimaryAction, Converter={StaticResource NullToFalseConverter}}">
                    <!-- Primary 1-Tap Quick Commit Button -->
                    <Button Grid.Column="0"
                            Text="{Binding PrimaryAction.Label, StringFormat='✓ {0}'}"
                            FontAttributes="Bold"
                            FontSize="13"
                            HeightRequest="38"
                            CornerRadius="8"
                            BackgroundColor="{AppThemeBinding Light=#10B981, Dark=#059669}"
                            TextColor="#FFFFFF"
                            Command="{Binding Source={x:Reference thisCard}, Path=QuickCommitCommand}"
                            CommandParameter="{Binding .}" />

                    <!-- Secondary Change / Navigate Button -->
                    <Button Grid.Column="1"
                            Text="{Binding SecondaryAction.Label}"
                            FontSize="13"
                            HeightRequest="38"
                            CornerRadius="8"
                            BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#334155}"
                            TextColor="{AppThemeBinding Light=#334155, Dark=#F8FAFC}"
                            Command="{Binding Source={x:Reference thisCard}, Path=NavigateCommand}"
                            CommandParameter="{Binding .}" />
                </Grid>

                <!-- Case B: Jev Choice Disambiguation (Peer Options) -->
                <VerticalStackLayout Spacing="6"
                                     IsVisible="{Binding Choices, Converter={StaticResource NullToFalseConverter}}">
                    <Label Text="Chọn danh mục đúng:" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding Choices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ActionChoiceModel">
                                <Button TextTransform="None"
                                        FontSize="12"
                                        HeightRequest="34"
                                        Padding="12,0"
                                        CornerRadius="6"
                                        BackgroundColor="{AppThemeBinding Light=#E0E7FF, Dark=#312E81}"
                                        TextColor="{AppThemeBinding Light=#4338CA, Dark=#E0E7FF}"
                                        Command="{Binding Source={x:Reference thisCard}, Path=SelectChoiceCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Text>
                                        <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="Label" />
                                            <Binding Path="FormattedProbability" />
                                        </MultiBinding>
                                    </Button.Text>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
