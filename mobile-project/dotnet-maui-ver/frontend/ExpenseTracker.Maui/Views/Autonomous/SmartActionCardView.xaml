<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Autonomous"
             x:Class="ExpenseTracker.Maui.Views.Autonomous.SmartActionCardView"
             x:Name="thisCard"
             x:DataType="models:AutonomousActionModel">

    <Border Stroke="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral800}}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
            Padding="16"
            Margin="0,0,0,10">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light={StaticResource Neutral900}, Dark=#000000}" 
                    Offset="0,2" Radius="8" 
                    Opacity="{AppThemeBinding Light=0.03, Dark=0.2}" />
        </Border.Shadow>
        
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="{Binding Display.BadgeColor}"
                        StrokeShape="RoundRectangle 20"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        Padding="10,4">
                    <Label Text="{Binding Display.BadgeText}"
                           FontSize="11"
                           FontAttributes="Bold"
                           LineBreakMode="NoWrap"
                           TextColor="#FFFFFF" />
                </Border>

                <Label Grid.Column="1"
                       Text="{Binding Display.Subtitle}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />

                <Button Grid.Column="2"
                        Text="Bỏ qua"
                        FontSize="11"
                        FontAttributes="Bold"
                        HeightRequest="28"
                        Padding="10,0"
                        CornerRadius="14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral800}}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        Command="{Binding Source={x:Reference thisCard}, Path=DismissCommand}"
                        CommandParameter="{Binding .}" />
            </Grid>

            <Label Text="{Binding Display.Title}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                      IsVisible="{Binding PrimaryAction, Converter={StaticResource NullToFalseConverter}}">
                    <Button Grid.Column="0"
                            Text="{Binding PrimaryAction.Label}"
                            FontAttributes="Bold"
                            FontSize="13"
                            HeightRequest="40"
                            CornerRadius="10"
                            BackgroundColor="{StaticResource Emerald500}"
                            TextColor="#FFFFFF"
                            Command="{Binding Source={x:Reference thisCard}, Path=QuickCommitCommand}"
                            CommandParameter="{Binding .}">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Emerald500}" Offset="0,2" Radius="6" Opacity="0.25" />
                        </Button.Shadow>
                    </Button>

                    <Button Grid.Column="1"
                            Text="{Binding SecondaryAction.Label}"
                            FontSize="13"
                            HeightRequest="40"
                            CornerRadius="10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral800}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                            Command="{Binding Source={x:Reference thisCard}, Path=NavigateCommand}"
                            CommandParameter="{Binding .}" />
                </Grid>

                <VerticalStackLayout Spacing="6"
                                     IsVisible="{Binding Choices, Converter={StaticResource NullToFalseConverter}}">
                    <Label Text="Gợi ý danh mục:" 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding Choices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ActionChoiceModel">
                                <Button TextTransform="None"
                                        FontSize="12"
                                        HeightRequest="36"
                                        Padding="14,0"
                                        CornerRadius="8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource Neutral800}}"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                        FontAttributes="Bold"
                                        Command="{Binding Source={x:Reference thisCard}, Path=SelectChoiceCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Text>
                                        <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="Label" />
                                            <Binding Path="FormattedProbability" />
                                        </MultiBinding>
                                    </Button.Text>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>