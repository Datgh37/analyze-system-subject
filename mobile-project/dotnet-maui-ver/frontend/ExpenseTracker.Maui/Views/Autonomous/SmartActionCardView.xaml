<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Autonomous"
             x:Class="ExpenseTracker.Maui.Views.Autonomous.SmartActionCardView"
             x:Name="thisCard"
             x:DataType="models:AutonomousActionModel">

    <!-- Smart Action Card: 1-Tap Quick Commit (Confidence >= 0.85) or Jev Choice (0.50..0.85) -->
    <Border Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
            Padding="16"
            Margin="0,0,0,10">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                    Offset="0,2" Radius="8" 
                    Opacity="{AppThemeBinding Light=0.03, Dark=0.2}" />
        </Border.Shadow>
        
        <VerticalStackLayout Spacing="10">
            <!-- Header Row: Category Badge + Bank/Time Subtitle + Dismiss Button -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <!-- Category Badge (Sleek Pill) -->
                <Border Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="{Binding Display.BadgeColor}"
                        StrokeShape="RoundRectangle 20"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        Padding="10,4">
                    <Label Text="{Binding Display.BadgeText}"
                           FontSize="11"
                           FontAttributes="Bold"
                           LineBreakMode="NoWrap"
                           TextColor="#FFFFFF" />
                </Border>

                <!-- Bank Source and Time Subtitle -->
                <Label Grid.Column="1"
                       Text="{Binding Display.Subtitle}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />

                <!-- Dismiss Button (Circular Touchpoint) -->
                <Button Grid.Column="2"
                        Text="✕"
                        FontSize="11"
                        FontAttributes="Bold"
                        WidthRequest="28"
                        HeightRequest="28"
                        Padding="0"
                        CornerRadius="14"
                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                        TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                        Command="{Binding Source={x:Reference thisCard}, Path=DismissCommand}"
                        CommandParameter="{Binding .}" />
            </Grid>

            <!-- Title & Monetary Amount -->
            <Label Text="{Binding Display.Title}"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

            <!-- ACTION BUTTONS ROW -->
            <VerticalStackLayout Spacing="8">
                <!-- Case A: High Confidence -> 1-Tap Quick Commit + Navigate -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                      IsVisible="{Binding PrimaryAction, Converter={StaticResource NullToFalseConverter}}">
                    <!-- Primary 1-Tap Quick Commit Button -->
                    <Button Grid.Column="0"
                            Text="{Binding PrimaryAction.Label, StringFormat='✓ {0}'}"
                            FontAttributes="Bold"
                            FontSize="13"
                            HeightRequest="40"
                            CornerRadius="10"
                            BackgroundColor="{AppThemeBinding Light=#10B981, Dark=#059669}"
                            TextColor="#FFFFFF"
                            Command="{Binding Source={x:Reference thisCard}, Path=QuickCommitCommand}"
                            CommandParameter="{Binding .}">
                        <Button.Shadow>
                            <Shadow Brush="#10B981" Offset="0,2" Radius="6" Opacity="0.25" />
                        </Button.Shadow>
                    </Button>

                    <!-- Secondary Change / Navigate Button -->
                    <Button Grid.Column="1"
                            Text="{Binding SecondaryAction.Label}"
                            FontSize="13"
                            HeightRequest="40"
                            CornerRadius="10"
                            BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                            TextColor="{AppThemeBinding Light=#334155, Dark=#F8FAFC}"
                            Command="{Binding Source={x:Reference thisCard}, Path=NavigateCommand}"
                            CommandParameter="{Binding .}" />
                </Grid>

                <!-- Case B: Jev Choice Disambiguation (Peer Options) -->
                <VerticalStackLayout Spacing="6"
                                     IsVisible="{Binding Choices, Converter={StaticResource NullToFalseConverter}}">
                    <Label Text="Chọn danh mục đúng:" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding Choices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ActionChoiceModel">
                                <Button TextTransform="None"
                                        FontSize="12"
                                        HeightRequest="36"
                                        Padding="14,0"
                                        CornerRadius="8"
                                        BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#312E81}"
                                        TextColor="{AppThemeBinding Light=#4338CA, Dark=#E0E7FF}"
                                        FontAttributes="Bold"
                                        Command="{Binding Source={x:Reference thisCard}, Path=SelectChoiceCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Text>
                                        <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="Label" />
                                            <Binding Path="FormattedProbability" />
                                        </MultiBinding>
                                    </Button.Text>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
