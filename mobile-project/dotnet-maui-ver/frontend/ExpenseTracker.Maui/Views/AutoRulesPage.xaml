<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.AutoRules"
             xmlns:components="clr-namespace:ExpenseTracker.Maui.Views.Components"
             x:Class="ExpenseTracker.Maui.Views.AutoRulesPage"
             x:DataType="vm:AutoRulesViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12,16,28" Spacing="16" MaximumWidthRequest="640">

                <!-- 1. HERO CARD: QUY TẮC TỰ ĐỘNG PHÂN LOẠI THÔNG MINH -->
                <Border Stroke="{AppThemeBinding Light=#4338CA, Dark=#6366F1}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 24"
                        Padding="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0.0" />
                            <GradientStop Color="#1E1B4B" Offset="0.5" />
                            <GradientStop Color="#312E81" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#312E81" Offset="0,6" Radius="20" Opacity="0.35" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Image Source="ic_rules.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                <Label Text="TỰ ĐỘNG HÓA DANH MỤC" FontSize="11" FontAttributes="Bold" TextColor="#A5B4FC" CharacterSpacing="1" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#4338CA" Padding="8,3" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                <Label Text="MATCH TỪ KHÓA" FontSize="10" FontAttributes="Bold" TextColor="#E0E7FF" />
                            </Border>
                        </Grid>

                        <Label Text="Phân Loại Giao Dịch Tự Động" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />
                        <Label Text="Nhận diện các từ khóa quen thuộc (Grab, Highlands, Siêu thị WinMart...) để tự động gán đúng danh mục thu chi ngay khi phát sinh giao dịch."
                               FontSize="12" TextColor="#C7D2FE" />
                    </VerticalStackLayout>
                </Border>

                <!-- THÔNG BÁO LỖI (NẾU CÓ) -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                        Stroke="#FECACA" StrokeShape="RoundRectangle 12" Padding="14,10">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- 2. FORM THIẾT LẬP QUY TẮC MỚI -->
                <Border Style="{StaticResource FintechCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="THIẾT LẬP QUY TẮC MỚI" Style="{StaticResource FintechCardTitleStyle}" />

                        <!-- TỪ KHÓA -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Từ khóa nhận diện (*)" Style="{StaticResource FintechCaptionStyle}" />
                            <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                    Padding="14,4">
                                <Entry Placeholder="Ví dụ: WinMart, GrabFood, Highlands, Shopee..."
                                       Text="{Binding NewKeywordPattern}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- DANH MỤC TỰ ĐỘNG GÁN -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Danh mục tự động gán (*)" Style="{StaticResource FintechCaptionStyle}" />
                            <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                    Padding="10,2">
                                <Picker Title="-- Chọn danh mục đích --"
                                        ItemsSource="{Binding AvailableCategories}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedCategory}"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- ĐỘ ƯU TIÊN VÀ TÙY CHỌN -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Thứ tự ưu tiên" Style="{StaticResource FintechCaptionStyle}" />
                                <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                        Padding="12,4">
                                    <Entry Placeholder="Ví dụ: 1"
                                           Text="{Binding PriorityOrder}"
                                           Keyboard="Numeric"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                           BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Tùy chọn khớp" Style="{StaticResource FintechCaptionStyle}" />
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HeightRequest="44">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <CheckBox IsChecked="{Binding IsRegex}" Color="{StaticResource FintechPrimary}" VerticalOptions="Center" />
                                        <Label Text="Regex" FontSize="12" TextColor="{StaticResource FintechTextMuted}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <CheckBox IsChecked="{Binding IsCaseSensitive}" Color="{StaticResource FintechPrimary}" VerticalOptions="Center" />
                                        <Label Text="Hoa/Thường" FontSize="12" TextColor="{StaticResource FintechTextMuted}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="+ Thêm Quy Tắc Tự Động"
                                Command="{Binding CreateRuleCommand}"
                                Style="{StaticResource FintechPrimaryBtnStyle}"
                                HeightRequest="48"
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. DANH SÁCH QUY TẮC HIỆN TẠI -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,6,2,0" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="QUY TẮC ĐANG KÍCH HOẠT" Style="{StaticResource FintechSectionTitleStyle}" />
                    <Label Grid.Column="1" Text="Tự động áp dụng" FontSize="11" TextColor="{StaticResource FintechTextMuted}" VerticalOptions="Center" />
                </Grid>

                <CollectionView ItemsSource="{Binding Rules}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border Style="{StaticResource FintechCardStyle}" Padding="24">
                            <Label Text="Chưa có quy tắc tự động nào được thiết lập."
                                   HorizontalOptions="Center"
                                   Style="{StaticResource FintechCaptionStyle}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AutoRuleModel">
                            <Border Style="{StaticResource FintechCardStyle}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                            <Border BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                                    Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                                <Label Text="{Binding PriorityOrder, StringFormat='Ưu tiên #{0}'}"
                                                       FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FintechPrimary}" />
                                            </Border>
                                            <Border BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}"
                                                    Padding="6,2" StrokeShape="RoundRectangle 6" StrokeThickness="0" IsVisible="{Binding IsRegex}">
                                                <Label Text="REGEX" FontSize="10" FontAttributes="Bold" TextColor="#D97706" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="Xóa"
                                                TextColor="#EF4444"
                                                BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#450A0A}"
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                HeightRequest="30"
                                                Padding="12,0"
                                                CornerRadius="8"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AutoRulesViewModel}}, Path=DeleteRuleCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <!-- THẺ THÔNG MINH: NẾU TỪ KHÓA -> GÁN DANH MỤC -->
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                                            Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="12,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="Nếu có:" FontSize="12" TextColor="{StaticResource FintechTextMuted}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding KeywordPattern}" FontAttributes="Bold" FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                                   LineBreakMode="TailTruncation" VerticalOptions="Center" />

                                            <Label Grid.Column="2" Text="➔" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource FintechPrimary}" VerticalOptions="Center" />

                                            <Border Grid.Column="3" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                                                    Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Start">
                                                <Label Text="{Binding TargetCategoryName}" TextColor="{StaticResource FintechIncome}" FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DUY NHẤT 1 THANH BOTTOM BAR BỒNG BỀNH -->
        <components:BottomNavDockView Grid.Row="1" ActiveTab="Home" />
    </Grid>
</ContentPage>