<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:receipts="clr-namespace:ExpenseTracker.Maui.Models.Receipts"
             x:Class="ExpenseTracker.Maui.Views.ReceiptOcrPage"
             x:DataType="vm:ReceiptOcrViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Title & Introduction -->
            <Label Text="Bóc Tách Hóa Đơn Bán Lẻ AI Vision OCR (UC-03.07/03.08)" FontSize="18" FontAttributes="Bold" />
            <Label Text="Chụp ảnh hoặc chọn file hóa đơn siêu thị (Winmart, Co.opmart, Lotte...). AI Vision tự động bóc tách từng món hàng, phân loại danh mục và kiểm toán công thức số học (Δ ≤ 1.000 đ)."
                   FontSize="12" TextColor="Gray" />

            <!-- Input Actions Grid: OCR Button & Voice STT Box -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <!-- Action 1: Upload Receipt Image -->
                <Button Grid.Column="0"
                        Text="📷 Chọn Ảnh / PDF Hóa Đơn"
                        Command="{Binding PickAndParseReceiptCommand}"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold" />

                <!-- Action 2: Voice Input Quick Parse -->
                <Button Grid.Column="1"
                        Text="🎤 Nhận Diện Khẩu Lệnh"
                        Command="{Binding ParseVoiceExpenseCommand}"
                        BackgroundColor="#7C3AED"
                        TextColor="White"
                        FontAttributes="Bold" />
            </Grid>

            <!-- Voice Quick Input Entry (UC-03.11) -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Khẩu lệnh giọng nói / Text nhanh (VD: 'Ăn trưa 45 nghìn tiền mặt'):" FontSize="11" TextColor="Gray" />
                <Entry Text="{Binding VoiceTranscriptInput}" 
                       Placeholder="Nhập câu khẩu lệnh hoặc giọng nói chi tiêu..." 
                       FontSize="13" />
            </VerticalStackLayout>

            <Label Text="{Binding SelectedFileName, StringFormat='Tệp đã chọn: {0}'}"
                   FontSize="12"
                   IsVisible="{Binding SelectedFileName, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <!-- Status Banner -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="#059669"
                   FontAttributes="Bold"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

            <!-- Mathematical Audit Discrepancy Banner (UC-03.08 Step 4 & Exception E1) -->
            <Border Stroke="#F59E0B" BackgroundColor="#FEF3C7" Padding="12" StrokeShape="RoundRectangle 6"
                    IsVisible="{Binding IsMathDiscrepancy}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="⚠️ CẢNH BÁO SAI LỆCH SỐ HỌC (UC-03.08 E1)"
                           FontAttributes="Bold"
                           TextColor="#B45309"
                           FontSize="13" />
                    <Label Text="{Binding AuditWarningMessage}"
                           TextColor="#92400E"
                           FontSize="12" />
                    <Label Text="{Binding DiscrepancyAmount, StringFormat='Mức chênh lệch số học: {0:N0} đ'}"
                           FontAttributes="Bold"
                           TextColor="#B45309"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding HasError}" />

            <!-- Receipt Breakdown & Itemized Details (Human-in-the-loop review) -->
            <Border Stroke="#D1D5DB" Padding="14" StrokeShape="RoundRectangle 8"
                    IsVisible="{Binding HasParsedData}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Bảng Đối Soát Hóa Đơn &amp; Danh Mục (Receipt Items Review)" 
                           FontAttributes="Bold" FontSize="16" TextColor="#111827" />

                    <!-- Merchant & Date -->
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Cửa hàng / Siêu thị:" FontSize="12" TextColor="Gray" />
                            <Entry Text="{Binding MerchantName}" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Ngày hóa đơn:" FontSize="12" TextColor="Gray" />
                            <DatePicker Date="{Binding InvoiceDate}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Itemized List -->
                    <Label Text="Danh mục từng món hàng đã bóc tách:" FontAttributes="Bold" FontSize="13" Margin="0,4,0,0" />
                    
                    <CollectionView ItemsSource="{Binding Items}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="receipts:ParsedReceiptItemModel">
                                <Border Stroke="#E5E7EB" Padding="8" Margin="0,3" StrokeShape="RoundRectangle 6" BackgroundColor="#F9FAFB">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding ItemName}" FontAttributes="Bold" FontSize="13" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding TotalPrice, StringFormat='{0:N0} đ'}" FontAttributes="Bold" TextColor="#DC2626" FontSize="13" />
                                        
                                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding DisplayQuantityPrice}" FontSize="11" TextColor="Gray" />
                                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#EEF2FF" Padding="6,2" StrokeShape="RoundRectangle 4" Stroke="Transparent">
                                            <Label Text="{Binding CategoryBadge}" FontSize="10" TextColor="#4F46E5" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Financial Math Summary -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" Margin="0,6,0,0">
                        <Label Grid.Row="0" Grid.Column="0" Text="Tiền hàng (SubTotal):" FontSize="12" TextColor="Gray" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal, StringFormat='{0:N0} đ'}" HorizontalOptions="End" FontSize="12" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Thuế VAT:" FontSize="12" TextColor="Gray" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding TaxAmount, StringFormat='{0:N0} đ'}" HorizontalOptions="End" FontSize="12" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Chiết khấu / Giảm giá:" FontSize="12" TextColor="Gray" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='-{0:N0} đ'}" HorizontalOptions="End" FontSize="12" TextColor="#059669" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,4" />

                    <!-- Total Amount -->
                    <Grid ColumnDefinitions="*,*">
                        <Label Grid.Column="0" Text="Tổng thanh toán:" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding TotalAmount}" Keyboard="Numeric" FontAttributes="Bold" FontSize="15" TextColor="#DC2626" HorizontalTextAlignment="End" />
                    </Grid>

                    <!-- Ledger Destination Options -->
                    <Label Text="Thiết Lập Sổ Cái Ghi Nhận" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0" TextColor="#111827" />

                    <!-- Wallet Picker -->
                    <Label Text="Ví thanh toán nguồn:" FontSize="12" TextColor="Gray" />
                    <Picker ItemsSource="{Binding Wallets}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedWallet}" />

                    <!-- Category Picker -->
                    <Label Text="Danh mục chi tiêu chính:" FontSize="12" TextColor="Gray" />
                    <Picker ItemsSource="{Binding ExpenseCategories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}" />

                    <!-- Options: Essential 50/30/20 & Continuous Learning Loop -->
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding IsEssential}" />
                        <Label Text="Chi tiêu thiết yếu (Quy tắc 50/30/20 Needs)" VerticalOptions="Center" FontSize="13" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding RememberRules}" />
                        <Label Text="Ghi nhớ quy tắc phân loại tự động cho món hàng này lần sau" VerticalOptions="Center" FontSize="13" TextColor="#2563EB" />
                    </HorizontalStackLayout>

                    <Label Text="Ghi chú chi tiêu:" FontSize="12" TextColor="Gray" />
                    <Entry Text="{Binding Note}" FontSize="13" />

                    <!-- Confirm Button -->
                    <Button Text="💾 Xác Nhận Lưu Vào Sổ Cái &amp; Trừ Tiền Ví"
                            Command="{Binding ConfirmReceiptCommand}"
                            BackgroundColor="#059669"
                            TextColor="White"
                            FontAttributes="Bold"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
