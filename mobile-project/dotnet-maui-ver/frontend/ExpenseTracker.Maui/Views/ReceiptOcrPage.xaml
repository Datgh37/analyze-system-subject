<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:receipts="clr-namespace:ExpenseTracker.Maui.Models.Receipts"
             x:Class="ExpenseTracker.Maui.Views.ReceiptOcrPage"
             x:DataType="vm:ReceiptOcrViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,100" Spacing="16" MaximumWidthRequest="720">

            <Border Style="{StaticResource FintechHeroCard}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Image Source="ic_ocr.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Text="QUÉT HÓA ĐƠN AI"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#A5B4FC"
                                   CharacterSpacing="1.2"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#3730A3"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent">
                            <Label Text="ĐỐI SOÁT TỰ ĐỘNG"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#E0E7FF" />
                        </Border>
                    </Grid>

                    <Label Text="Bóc Tách Hóa Đơn &amp; Nhập Tự Động"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />

                    <Label Text="Chụp ảnh hoặc tải hóa đơn siêu thị (WinMart, Co.opmart...), hóa đơn tiền điện/nước. Trí tuệ nhân tạo sẽ tự động bóc tách từng món hàng, phân loại danh mục và kiểm tra tính chính xác của hóa đơn."
                           FontSize="12"
                           TextColor="#C7D2FE"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0"
                        Style="{StaticResource FintechCard}"
                        Padding="10,12">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="ic_camera.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label Text="Chụp Ảnh"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Center" />
                        <Label Text="Máy ảnh điện thoại"
                               FontSize="9"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                               HorizontalOptions="Center" />
                        <Button Text="Chụp Ngay"
                                Command="{Binding CaptureReceiptWithCameraCommand}"
                                Style="{StaticResource FintechButtonPrimary}"
                                FontSize="11"
                                HeightRequest="36"
                                Padding="4,0" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource FintechCard}"
                        Padding="10,12">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="ic_card.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label Text="Tải Hóa Đơn"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Center" />
                        <Label Text="Từ thư viện ảnh"
                               FontSize="9"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                               HorizontalOptions="Center" />
                        <Button Text="Chọn Tệp"
                                Command="{Binding PickAndParseReceiptCommand}"
                                Style="{StaticResource FintechButtonSecondary}"
                                FontSize="11"
                                HeightRequest="36"
                                Padding="4,0" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource FintechCard}"
                        Padding="10,12">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="ic_mic.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label Text="Khẩu Lệnh"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Center" />
                        <Label Text="Giọng nói tiếng Việt"
                               FontSize="9"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                               HorizontalOptions="Center" />
                        <Button Text="Nhận Diện"
                                Command="{Binding ParseVoiceExpenseCommand}"
                                Style="{StaticResource FintechButtonSecondary}"
                                FontSize="11"
                                HeightRequest="36"
                                Padding="4,0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource FintechCard}"
                    Padding="14"
                    IsVisible="{Binding HasCapturedImage}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Image Source="ic_camera.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Text="Ảnh Hóa Đơn Xem Trước"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="Chụp Lại"
                                Command="{Binding CaptureReceiptWithCameraCommand}"
                                Style="{StaticResource FintechButtonSecondary}"
                                FontSize="11" Padding="10,2" HeightRequest="30" />
                    </Grid>
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            BackgroundColor="#000000">
                        <Image Source="{Binding CapturedImagePreview}"
                               Aspect="AspectFit"
                               MaximumHeightRequest="260"
                               HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                            <Image Source="ic_mic.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Text="Nhập Nhanh Bằng Giọng Nói"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1"
                               Text="GIỌNG NÓI"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryLight}" />
                    </Grid>

                    <Border Style="{StaticResource FintechInput}">
                        <Entry Text="{Binding VoiceTranscriptInput}" 
                               Placeholder="Ví dụ: 'Ăn trưa cơm tấm 45 nghìn tiền mặt ví chính'..." 
                               FontSize="13" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E293B}"
                    Stroke="#BFDBFE"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    IsVisible="{Binding SelectedFileName, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Image Grid.Column="0" Source="ic_category.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding SelectedFileName}" FontSize="12" LineBreakMode="MiddleTruncation" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="Đã sẵn sàng" TextColor="#2563EB" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" Margin="0,10">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryLight}" WidthRequest="32" HeightRequest="32" />
                <Label Text="{Binding StatusMessage, FallbackValue='Đang xử lý bóc tách qua trí tuệ nhân tạo...'}" 
                       TextColor="{StaticResource PrimaryLight}"
                       FontSize="12"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#064E3B}"
                    Stroke="#BBF7D0"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#16A34A" VerticalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           TextColor="{AppThemeBinding Light=#15803D, Dark=#86EFAC}"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    IsVisible="{Binding HasError}">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#B91C1C"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}"
                    Padding="18"
                    IsVisible="{Binding HasParsedData}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Bảng Đối Soát Hóa Đơn &amp; Danh Mục" 
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Kiểm tra và chỉnh sửa chi tiết các món hàng trước khi lưu vào sổ chi tiêu"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 6"
                                Stroke="Transparent"
                                VerticalOptions="Center">
                            <Label Text="ĐỐI SOÁT" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource PrimaryLight}" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Cửa hàng / Đơn vị:" FontSize="12" FontAttributes="Bold" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Entry Text="{Binding MerchantName}" FontSize="13" FontAttributes="Bold" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Ngày hóa đơn:" FontSize="12" FontAttributes="Bold" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <DatePicker Date="{Binding InvoiceDate}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Danh sách từng món hàng đã bóc tách:"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Thêm Món"
                                Command="{Binding AddNewItemCommand}"
                                Style="{StaticResource FintechButtonSecondary}"
                                FontSize="11" Padding="8,2" HeightRequest="30" />
                    </Grid>
                    
                    <CollectionView ItemsSource="{Binding Items}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="receipts:ParsedReceiptItemModel">
                                <Border Style="{StaticResource FintechCard}"
                                        Padding="12"
                                        Margin="0,3">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                        <Entry Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ItemName}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding TotalPrice, StringFormat='{0:N0} đ'}"
                                                   FontAttributes="Bold"
                                                   TextColor="#F43F5E"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                                            <Button Text="Xóa"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReceiptOcrViewModel}}, Path=RemoveItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="10"
                                                    HeightRequest="26"
                                                    Padding="6,0"
                                                    BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#7F1D1D}"
                                                    TextColor="#DC2626"
                                                    CornerRadius="6" />
                                        </HorizontalStackLayout>
                                        
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                            <Label Text="SL:" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" VerticalOptions="Center" />
                                            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeShape="RoundRectangle 6" Padding="4,0" HeightRequest="26">
                                                <Entry Text="{Binding Quantity}" Keyboard="Numeric" FontSize="11" WidthRequest="36" HorizontalTextAlignment="Center" />
                                            </Border>
                                            <Label Text="x Đơn giá:" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" VerticalOptions="Center" Margin="4,0,0,0" />
                                            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeShape="RoundRectangle 6" Padding="6,0" HeightRequest="26">
                                                <Entry Text="{Binding UnitPrice}" Keyboard="Numeric" FontSize="11" WidthRequest="70" HorizontalTextAlignment="End" />
                                            </Border>
                                            <Button Text="Cập nhật"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReceiptOcrViewModel}}, Path=UpdateItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="10" HeightRequest="26" Padding="6,0"
                                                    Style="{StaticResource FintechButtonSecondary}" />
                                        </HorizontalStackLayout>

                                        <Border Grid.Row="1" Grid.Column="1"
                                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#312E81}"
                                                Padding="8,2"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="Transparent"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding CategoryBadge}"
                                                   FontSize="10"
                                                   TextColor="{StaticResource PrimaryLight}"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                            Stroke="#FECACA"
                            IsVisible="{Binding IsMathDiscrepancy}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="CẢNH BÁO CHÊNH LỆCH TỔNG TIỀN"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#B91C1C" />
                            <Label Text="{Binding AuditWarningMessage}"
                                   FontSize="11" LineBreakMode="WordWrap"
                                   TextColor="#991B1B" />
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8"
                            BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#064E3B}"
                            Stroke="#BBF7D0"
                            IsVisible="{Binding IsMathDiscrepancy, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="Tổng tiền các món hàng khớp 100% với hóa đơn"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="#15803D" VerticalOptions="Center" />
                    </Border>

                    <Border Style="{StaticResource FintechCard}" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="Tiền hàng:" FontSize="12" Style="{StaticResource FintechLabelCaption}" />
                                <Label Grid.Column="1" Text="{Binding SubTotal, StringFormat='{0:N0} đ'}" HorizontalOptions="End" FontSize="12" FontAttributes="Bold" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="Thuế VAT:" FontSize="12" Style="{StaticResource FintechLabelCaption}" />
                                <Label Grid.Column="1" Text="{Binding TaxAmount, StringFormat='{0:N0} đ'}" HorizontalOptions="End" FontSize="12" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="Chiết khấu / Giảm giá:" FontSize="12" Style="{StaticResource FintechLabelCaption}" />
                                <Label Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='-{0:N0} đ'}" HorizontalOptions="End" FontSize="12" TextColor="#10B981" FontAttributes="Bold" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,2" />

                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="TỔNG THANH TOÁN:" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                                <Border Grid.Column="1" Style="{StaticResource FintechInput}">
                                    <Entry Text="{Binding TotalAmount}"
                                           Keyboard="Numeric"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="#F43F5E"
                                           HorizontalTextAlignment="End" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Thiết Lập Sổ Chi Tiêu Ghi Nhận"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ví thanh toán nguồn:" FontSize="12" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Picker ItemsSource="{Binding Wallets}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedWallet}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Danh mục chi tiêu chính:" FontSize="12" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Picker ItemsSource="{Binding ExpenseCategories}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedCategory}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4,0,0" VerticalOptions="Center">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEssential}" Color="{StaticResource PrimaryLight}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Chi tiêu thiết yếu (thuộc nhóm 50% nhu cầu thiết yếu)"
                                   VerticalOptions="Center"
                                   FontSize="13" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <CheckBox Grid.Column="0" IsChecked="{Binding RememberRules}" Color="{StaticResource PrimaryLight}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Ghi nhớ quy tắc phân loại tự động cho món hàng này lần sau"
                                   VerticalOptions="Center"
                                   FontSize="13" LineBreakMode="WordWrap"
                                   TextColor="{StaticResource PrimaryLight}"
                                   FontAttributes="Bold" />
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ghi chú chi tiêu:" FontSize="12" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Entry Text="{Binding Note}" FontSize="13" Placeholder="Ghi chú thêm..." />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Xác Nhận Lưu Vào Sổ &amp; Trừ Tiền Ví"
                                Command="{Binding ConfirmReceiptCommand}"
                                Style="{StaticResource FintechButtonPrimary}"
                                BackgroundColor="#10B981"
                                HeightRequest="48"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>