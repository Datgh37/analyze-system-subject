<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:receipts="clr-namespace:ExpenseTracker.Maui.Models.Receipts"
             x:Class="ExpenseTracker.Maui.Views.ReceiptOcrPage"
             x:DataType="vm:ReceiptOcrViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="18" MaximumWidthRequest="720">

            <!-- ========================================== -->
            <!-- 1. HERO BANNER: AI VISION MULTIMODAL OCR   -->
            <!-- ========================================== -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="22"
                    Shadow="{Shadow Brush='#4F46E5', Offset='0,10', Radius=20, Opacity=0.25}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E1B4B" Offset="0.0" />
                        <GradientStop Color="#312E81" Offset="0.5" />
                        <GradientStop Color="#4C1D95" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Image Source="ic_ocr.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Text="GEMINI 2.5 FLASH VISION"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#A5B4FC"
                                   CharacterSpacing="1.2"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#3730A3"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent">
                            <Label Text="Δ ≤ 1.000 đ AUDIT"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#E0E7FF" />
                        </Border>
                    </Grid>

                    <Label Text="Bóc Tách Hóa Đơn &amp; Khẩu Lệnh AI"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />

                    <Label Text="Chụp ảnh camera native hoặc tải hóa đơn siêu thị (WinMart, Co.opmart, Lotte...) và hóa đơn điện/nước. AI tự động bóc tách từng món hàng, phân loại danh mục và kiểm toán công thức số học thời gian thực."
                           FontSize="12"
                           TextColor="#C7D2FE"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- ========================================== -->
            <!-- 2. INPUT ACTIONS: CAMERA / PICKER / VOICE  -->
            <!-- ========================================== -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <!-- Action 1: Native Camera Capture -->
                <Border Grid.Column="0"
                        Style="{StaticResource ModernCard}"
                        Padding="10,12"
                        Stroke="{AppThemeBinding Light='#C7D2FE', Dark='#312E81'}">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="ic_camera.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label Text="Chụp Ảnh"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light='#1E1B4B', Dark='#E0E7FF'}"
                               HorizontalOptions="Center" />
                        <Label Text="Camera điện thoại"
                               FontSize="9"
                               TextColor="{AppThemeBinding Light='#6B7280', Dark='#94A3B8'}"
                               HorizontalOptions="Center" />
                        <Button Text="Chụp Ngay"
                                Command="{Binding CaptureReceiptWithCameraCommand}"
                                BackgroundColor="#4F46E5"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="11"
                                CornerRadius="8"
                                HeightRequest="36"
                                Padding="4,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Action 2: Upload File / Gallery -->
                <Border Grid.Column="1"
                        Style="{StaticResource ModernCard}"
                        Padding="10,12"
                        Stroke="{AppThemeBinding Light='#C7D2FE', Dark='#312E81'}">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="ic_ocr.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label Text="Tải Hóa Đơn"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light='#1E1B4B', Dark='#E0E7FF'}"
                               HorizontalOptions="Center" />
                        <Label Text="Thư viện / PDF"
                               FontSize="9"
                               TextColor="{AppThemeBinding Light='#6B7280', Dark='#94A3B8'}"
                               HorizontalOptions="Center" />
                        <Button Text="Chọn Tệp"
                                Command="{Binding PickAndParseReceiptCommand}"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="11"
                                CornerRadius="8"
                                HeightRequest="36"
                                Padding="4,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Action 3: Voice Input Quick Parse -->
                <Border Grid.Column="2"
                        Style="{StaticResource ModernCard}"
                        Padding="10,12"
                        Stroke="{AppThemeBinding Light='#DDD6FE', Dark='#4C1D95'}">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="ic_mic.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                        <Label Text="Khẩu Lệnh AI"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light='#4C1D95', Dark='#EDE9FE'}"
                               HorizontalOptions="Center" />
                        <Label Text="Giọng nói tiếng Việt"
                               FontSize="9"
                               TextColor="{AppThemeBinding Light='#6B7280', Dark='#94A3B8'}"
                               HorizontalOptions="Center" />
                        <Button Text="Nhận Diện"
                                Command="{Binding ParseVoiceExpenseCommand}"
                                BackgroundColor="#7C3AED"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="11"
                                CornerRadius="8"
                                HeightRequest="36"
                                Padding="4,0" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- RECEIPT IMAGE PREVIEW CARD                 -->
            <!-- ========================================== -->
            <Border Style="{StaticResource ModernCard}"
                    Padding="14"
                    IsVisible="{Binding HasCapturedImage}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Image Source="ic_camera.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Text="Ảnh Hóa Đơn Xem Trước"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light='#1E293B', Dark='#F1F5F9'}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="Chụp Lại"
                                Command="{Binding CaptureReceiptWithCameraCommand}"
                                FontSize="11" Padding="10,2" HeightRequest="30"
                                BackgroundColor="{AppThemeBinding Light='#F1F5F9', Dark='#334155'}"
                                TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}"
                                CornerRadius="6" />
                    </Grid>
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                            BackgroundColor="{AppThemeBinding Light='#000000', Dark='#000000'}">
                        <Image Source="{Binding CapturedImagePreview}"
                               Aspect="AspectFit"
                               MaximumHeightRequest="260"
                               HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Voice Quick Input Entry -->
            <Border Style="{StaticResource ModernCard}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                            <Image Source="ic_mic.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Text="Nhập Nhanh Bằng Giọng Nói"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light='#1E293B', Dark='#F1F5F9'}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1"
                               Text="GIỌNG NÓI AI"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#7C3AED" />
                    </Grid>

                    <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,4"
                            BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                        <Entry Text="{Binding VoiceTranscriptInput}" 
                               Placeholder="Ví dụ: 'Ăn trưa bún bò 45 nghìn tiền mặt ví chính'..." 
                               FontSize="13"
                               TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Selected File Badge -->
            <Border BackgroundColor="{AppThemeBinding Light='#EFF6FF', Dark='#1E293B'}"
                    Stroke="#BFDBFE"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    IsVisible="{Binding SelectedFileName, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Image Grid.Column="0" Source="ic_ocr.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding SelectedFileName}" FontSize="12" LineBreakMode="MiddleTruncation" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="Đã sẵn sàng" TextColor="#2563EB" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Loading Indicator -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" Margin="0,10">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#4F46E5" WidthRequest="32" HeightRequest="32" />
                <Label Text="{Binding StatusMessage, FallbackValue='Đang xử lý bóc tách qua AI Vision...'}" 
                       TextColor="#4F46E5"
                       FontSize="12"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Status Banner -->
            <Border BackgroundColor="{AppThemeBinding Light='#F0FDF4', Dark='#064E3B'}"
                    Stroke="#BBF7D0"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#16A34A" VerticalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           TextColor="{AppThemeBinding Light='#15803D', Dark='#86EFAC'}"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Error Banner -->
            <Border BackgroundColor="#FEF2F2"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    IsVisible="{Binding HasError}">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#B91C1C"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- ========================================== -->
            <!-- 4. RECEIPT BREAKDOWN & ITEMIZED DETAILS   -->
            <!-- ========================================== -->
            <Border Style="{StaticResource ModernCard}"
                    Padding="18"
                    IsVisible="{Binding HasParsedData}">
                <VerticalStackLayout Spacing="16">
                    <!-- Section Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Bảng Đối Soát Hóa Đơn &amp; Danh Mục" 
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" />
                            <Label Text="Human-in-the-loop: Kiểm tra và chỉnh sửa trước khi lưu sổ cái (UC-03.08)"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                Style="{StaticResource PillBadge}"
                                VerticalOptions="Center">
                            <Label Text="OCR REVIEW" FontSize="10" FontAttributes="Bold" TextColor="#4F46E5" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}" />

                    <!-- Merchant & Date -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Cửa hàng / Đơn vị phát hành:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                            <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,2"
                                    BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                                <Entry Text="{Binding MerchantName}" FontSize="13" FontAttributes="Bold" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Ngày hóa đơn:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                            <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,2"
                                    BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                                <DatePicker Date="{Binding InvoiceDate}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Itemized List Header with Add Item button -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Danh sách từng món hàng đã bóc tách:"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light='#1E293B', Dark='#F1F5F9'}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Thêm Món"
                                Command="{Binding AddNewItemCommand}"
                                FontSize="11" Padding="8,2" HeightRequest="30"
                                BackgroundColor="{AppThemeBinding Light='#EFF6FF', Dark='#1E3A8A'}"
                                TextColor="{AppThemeBinding Light='#1D4ED8', Dark='#BFDBFE'}"
                                FontAttributes="Bold"
                                CornerRadius="6" />
                    </Grid>
                    
                    <!-- Itemized List with In-place Editing -->
                    <CollectionView ItemsSource="{Binding Items}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="receipts:ParsedReceiptItemModel">
                                <Border Stroke="{AppThemeBinding Light='#E5E7EB', Dark='#334155'}"
                                        Padding="12"
                                        Margin="0,3"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#1E293B'}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                        <!-- Row 0: Item Name & Delete Button -->
                                        <Entry Grid.Row="0" Grid.Column="0"
                                               Text="{Binding ItemName}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding TotalPrice, StringFormat='{0:N0} đ'}"
                                                   FontAttributes="Bold"
                                                   TextColor="#F43F5E"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                                            <Button Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReceiptOcrViewModel}}, Path=RemoveItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="10"
                                                    HeightRequest="26" WidthRequest="26"
                                                    Padding="0"
                                                    BackgroundColor="{AppThemeBinding Light='#FEE2E2', Dark='#7F1D1D'}"
                                                    TextColor="#DC2626"
                                                    CornerRadius="13" />
                                        </HorizontalStackLayout>
                                        
                                        <!-- Row 1: Quantity x UnitPrice with In-Place Edit -->
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                            <Label Text="SL:" FontSize="11" TextColor="{AppThemeBinding Light='#6B7280', Dark='#94A3B8'}" VerticalOptions="Center" />
                                            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#CBD5E1', Dark='#475569'}" StrokeShape="RoundRectangle 6" Padding="4,0" HeightRequest="26">
                                                <Entry Text="{Binding Quantity}" Keyboard="Numeric" FontSize="11" WidthRequest="36" HorizontalTextAlignment="Center" />
                                            </Border>
                                            <Label Text="x Đơn giá:" FontSize="11" TextColor="{AppThemeBinding Light='#6B7280', Dark='#94A3B8'}" VerticalOptions="Center" Margin="4,0,0,0" />
                                            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#CBD5E1', Dark='#475569'}" StrokeShape="RoundRectangle 6" Padding="6,0" HeightRequest="26">
                                                <Entry Text="{Binding UnitPrice}" Keyboard="Numeric" FontSize="11" WidthRequest="70" HorizontalTextAlignment="End" />
                                            </Border>
                                            <Button Text="Cập nhật"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReceiptOcrViewModel}}, Path=UpdateItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="10" HeightRequest="26" Padding="6,0"
                                                    BackgroundColor="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                                    TextColor="{AppThemeBinding Light='#334155', Dark='#F1F5F9'}"
                                                    CornerRadius="6" />
                                        </HorizontalStackLayout>

                                        <!-- Row 1 Column 1: Category Badge -->
                                        <Border Grid.Row="1" Grid.Column="1"
                                                BackgroundColor="{AppThemeBinding Light='#EEF2FF', Dark='#312E81'}"
                                                Padding="8,2"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="Transparent"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding CategoryBadge}"
                                                   FontSize="10"
                                                   TextColor="{AppThemeBinding Light='#4F46E5', Dark='#A5B4FC'}"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Mathematical Audit Engine Status Badge (UC-03.08) -->
                    <Border StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light='#FEF2F2', Dark='#450A0A'}"
                            Stroke="#FECACA"
                            IsVisible="{Binding IsMathDiscrepancy}">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Image Source="ic_warning.svg" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                <Label Text="CẢNH BÁO SAI LỆCH SỐ HỌC (UC-03.08)"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#B91C1C" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding AuditWarningMessage}"
                                   FontSize="11" LineBreakMode="WordWrap"
                                   TextColor="#991B1B" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Perfect Match Audit Badge -->
                    <Border StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8"
                            BackgroundColor="{AppThemeBinding Light='#F0FDF4', Dark='#064E3B'}"
                            Stroke="#BBF7D0"
                            IsVisible="{Binding IsMathDiscrepancy, Converter={StaticResource InvertedBoolConverter}}">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Image Source="ic_check.svg" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                            <Label Text="Kiểm toán số học khớp 100% (Δ ≤ 1.000 đ) — Độ tin cậy AI cao"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#15803D" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Financial Math Summary Box -->
                    <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light='#F1F5F9', Dark='#1E293B'}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="Tiền hàng (SubTotal):" FontSize="12" TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                                <Label Grid.Column="1" Text="{Binding SubTotal, StringFormat='{0:N0} đ'}" HorizontalOptions="End" FontSize="12" FontAttributes="Bold" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="Thuế VAT:" FontSize="12" TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                                <Label Grid.Column="1" Text="{Binding TaxAmount, StringFormat='{0:N0} đ'}" HorizontalOptions="End" FontSize="12" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="Chiết khấu / Giảm giá:" FontSize="12" TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                                <Label Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='-{0:N0} đ'}" HorizontalOptions="End" FontSize="12" TextColor="#10B981" FontAttributes="Bold" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#CBD5E1', Dark='#475569'}" Margin="0,2" />

                            <!-- Grand Total Amount -->
                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="TỔNG THANH TOÁN:" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" />
                                <Border Grid.Column="1"
                                        Stroke="{AppThemeBinding Light='#FDA4AF', Dark='#9F1239'}"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,2"
                                        BackgroundColor="{AppThemeBinding Light='#FFF1F2', Dark='#4C0519'}">
                                    <Entry Text="{Binding TotalAmount}"
                                           Keyboard="Numeric"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="#F43F5E"
                                           HorizontalTextAlignment="End" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ========================================== -->
                    <!-- 5. LEDGER DESTINATION OPTIONS              -->
                    <!-- ========================================== -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Thiết Lập Sổ Cái Ghi Nhận"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" />

                        <!-- Wallet Picker -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ví thanh toán nguồn:" FontSize="12" TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                            <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0"
                                    BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                                <Picker ItemsSource="{Binding Wallets}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedWallet}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Category Picker -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Danh mục chi tiêu chính:" FontSize="12" TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                            <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,0"
                                    BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                                <Picker ItemsSource="{Binding ExpenseCategories}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedCategory}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Options: Essential 50/30/20 & Continuous Learning Loop -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4,0,0" VerticalOptions="Center">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEssential}" Color="#4F46E5" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Chi tiêu thiết yếu (Quy tắc 50/30/20 Needs)"
                                   VerticalOptions="Center"
                                   FontSize="13" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light='#334155', Dark='#CBD5E1'}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <CheckBox Grid.Column="0" IsChecked="{Binding RememberRules}" Color="#4F46E5" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Ghi nhớ quy tắc phân loại tự động cho món hàng này lần sau"
                                   VerticalOptions="Center"
                                   FontSize="13" LineBreakMode="WordWrap"
                                   TextColor="#4F46E5"
                                   FontAttributes="Bold" />
                        </Grid>

                        <!-- Note -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ghi chú chi tiêu:" FontSize="12" TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                            <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,2"
                                    BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                                <Entry Text="{Binding Note}" FontSize="13" Placeholder="Ghi chú thêm..." />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Confirm Button -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                BackgroundColor="#10B981"
                                HeightRequest="50"
                                Margin="0,10,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ConfirmReceiptCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Grid.Column="0" Source="ic_check.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Xác Nhận Lưu Vào Sổ Cái &amp; Trừ Tiền Ví" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
