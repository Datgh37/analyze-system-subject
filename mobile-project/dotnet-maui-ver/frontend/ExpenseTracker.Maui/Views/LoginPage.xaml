<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             x:Class="ExpenseTracker.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="24,50,24,36" MaximumWidthRequest="460">
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        WidthRequest="68"
                        HeightRequest="68"
                        HorizontalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" 
                                Offset="0,6" Radius="14" Opacity="0.3" />
                    </Border.Shadow>
                    <Image Source="ic_diamond.svg" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="DuoNoPro Finance" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="Quản Lý Chi Tiêu &amp; Hoạch Định Tài Chính" 
                       FontSize="13" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource FintechCard}" Padding="16,14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                WidthRequest="32" HeightRequest="32"
                                StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral800}}"
                                VerticalOptions="Center">
                            <Image Source="ic_shield.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding ModeTitle}" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Border BackgroundColor="{Binding ModeBadgeColor}"
                                        Padding="8,2"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding ModeBadgeText}" FontSize="9" FontAttributes="Bold" TextColor="#FFFFFF" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="{Binding ServerUrlSummary}" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Switch Grid.Column="2" IsToggled="{Binding IsLiveApiMode}"
                                OnColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" 
                                ThumbColor="#FFFFFF"
                                VerticalOptions="Center" />
                    </Grid>

                    <Button Text="{Binding ServerConfigButtonText}"
                            Command="{Binding ToggleShowServerConfigCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                            FontSize="11"
                            FontAttributes="Bold"
                            Padding="0"
                            HeightRequest="26"
                            HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowServerConfig}">
                        <Border Stroke="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral800}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource CardBgDark}}">
                            <Entry Text="{Binding ServerUrl}"
                                   Placeholder="http://localhost:5018 hoặc https://..."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>

                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                            <Button Grid.Column="0"
                                    Text="Localhost"
                                    Command="{Binding UseLocalhostCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource Neutral800}}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    FontSize="11"
                                    FontAttributes="Bold" />

                            <Button Grid.Column="1"
                                    Text="Tunnel"
                                    Command="{Binding UseTunnelCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral800}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    FontSize="11"
                                    FontAttributes="Bold" />

                            <Button Grid.Column="2"
                                    Text="Kiểm tra"
                                    Command="{Binding PingServerCommand}"
                                    BackgroundColor="{StaticResource Emerald500}"
                                    TextColor="#FFFFFF"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Padding="12,0" />
                        </Grid>

                        <Label Text="{Binding PingResult}"
                               IsVisible="{Binding PingResult, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                               FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Emerald500}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}" Padding="22">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Đăng Nhập Tài Khoản" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                    <Border BackgroundColor="#FEF2F2"
                            Stroke="#FECACA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                            <Label Text="{Binding ErrorMessage}" 
                                   TextColor="#B91C1C" 
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Địa chỉ Email" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Border Stroke="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral800}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource CardBgDark}}">
                            <Entry Placeholder="name@example.com"
                                   Keyboard="Email"
                                   Text="{Binding Email}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mật khẩu" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Border Stroke="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral800}}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource CardBgDark}}">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Entry Grid.Column="0"
                                       Placeholder="••••••••"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       FontSize="14"
                                       Text="{Binding Password}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="1"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Neutral100}, Dark={StaticResource Neutral800}}"
                                        Padding="0"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="{Binding PasswordToggleIcon}"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Quên mật khẩu?"
                            Command="{Binding ForgotPasswordCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            Padding="0"
                            HeightRequest="28" />

                    <Button Text="Đăng Nhập" 
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource FintechButtonPrimary}"
                            HeightRequest="46"
                            Margin="0,4,0,0" />

                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,4">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral800}}" VerticalOptions="Center" Grid.Column="0" />
                        <Label Text="hoặc tiếp tục với" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" Margin="12,0" Grid.Column="1" VerticalOptions="Center" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral800}}" VerticalOptions="Center" Grid.Column="2" />
                    </Grid>

                    <Border StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral800}}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                            HeightRequest="46">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoogleLoginCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Grid.Column="0" Source="ic_google.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Tiếp tục với Google" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                       IsVisible="{Binding IsBusy}" 
                                       Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Chưa có tài khoản? Đăng Ký Ngay" 
                    Command="{Binding NavigateToRegisterCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                    FontSize="13"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    HeightRequest="36" />

            <Border Stroke="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral800}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource Neutral900}}"
                    Padding="14,10"
                    StrokeShape="RoundRectangle 10"
                    HorizontalOptions="Center">
                <VerticalStackLayout Spacing="2">
                    <Button Text="Trải nghiệm ngoại tuyến (Demo Mode)"
                            Command="{Binding SkipToWalletsCommand}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center" />
                    <Label Text="Khám phá sổ tài chính với dữ liệu mô phỏng"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>