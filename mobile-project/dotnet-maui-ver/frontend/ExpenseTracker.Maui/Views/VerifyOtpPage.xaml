<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             x:Class="ExpenseTracker.Maui.Views.VerifyOtpPage"
             x:DataType="vm:VerifyOtpViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="24,50,24,36" MaximumWidthRequest="460">
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="64"
                        HeightRequest="64"
                        HorizontalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" 
                                Offset="0,6" Radius="14" Opacity="0.3" />
                    </Border.Shadow>
                    <Image Source="ic_diamond.svg" WidthRequest="34" HeightRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Xác Thực Bảo Mật" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="Nhập mã 6 chữ số để kích hoạt tài khoản" 
                       FontSize="13" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource FintechCard}" Padding="22">
                <VerticalStackLayout Spacing="18">
                    <Label Text="Mã OTP Xác Thực" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource Neutral800}}"
                            Stroke="{AppThemeBinding Light={StaticResource Neutral200}, Dark={StaticResource Neutral700}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Mã xác thực đã được gửi tới địa chỉ:" 
                                   FontSize="11" 
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="{Binding Email}" 
                                   FontAttributes="Bold" 
                                   FontSize="13" 
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#FEF2F2"
                            Stroke="#FECACA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                            <Label Text="{Binding ErrorMessage}" 
                                   TextColor="#B91C1C" 
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="#F0FDF4"
                            Stroke="#BBF7D0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            IsVisible="{Binding InfoMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#16A34A" VerticalOptions="Center" />
                            <Label Text="{Binding InfoMessage}" 
                                   TextColor="#15803D" 
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nhập mã 6 số bí mật" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Border Stroke="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 12"
                                Padding="16,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource CardBgDark}}">
                            <Entry Placeholder="• • • • • •"
                                   Text="{Binding OtpCode}"
                                   Keyboard="Numeric"
                                   MaxLength="6"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   CharacterSpacing="14"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Xác Thực Ngay" 
                            Command="{Binding VerifyOtpCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource FintechButtonPrimary}"
                            HeightRequest="46"
                            Margin="0,4,0,0" />

                    <Button Text="{Binding ResendButtonText}" 
                            Command="{Binding ResendOtpCommand}"
                            IsEnabled="{Binding CanResend}"
                            BackgroundColor="Transparent"
                            TextColor="{Binding ResendTextColor}"
                            FontSize="12"
                            FontAttributes="Bold"
                            HeightRequest="36"
                            HorizontalOptions="Center" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                       IsVisible="{Binding IsBusy}" 
                                       Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Quay lại Đăng Nhập" 
                    Command="{Binding NavigateToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                    FontSize="13"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    HeightRequest="36" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>