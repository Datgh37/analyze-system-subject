<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Budgets"
             x:Class="ExpenseTracker.Maui.Views.BudgetsPage"
             x:DataType="vm:BudgetsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Error Banner -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="#DC2626"
                   FontAttributes="Bold"
                   IsVisible="{Binding HasError}" />

            <!-- Success / Info Status Banner -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="#059669"
                   FontAttributes="Bold"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <!-- TOP ACTION BAR: Refresh & New Budget Buttons -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="+ Lập Ngân Sách Mới (UC-05.01)"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        Command="{Binding NavigateToCreateBudgetCommand}" />

                <Button Grid.Column="1"
                        Text="Tải lại"
                        BackgroundColor="#E5E7EB"
                        TextColor="#374151"
                        Command="{Binding LoadActiveBudgetProgressCommand}" />
            </Grid>

            <!-- EMPTY STATE: When No Active Budget Exists -->
            <Border IsVisible="{Binding HasActiveBudget, Converter={StaticResource InvertedBoolConverter}}"
                    Stroke="#CBD5E1"
                    BackgroundColor="#F8FAFC"
                    Padding="20"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="📋 Chưa có kế hoạch ngân sách nào đang hoạt động"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#475569"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Hãy thiết lập kế hoạch ngân sách theo phương pháp 50/30/20, Zero-Based Budgeting (ZBB) hoặc Kakeibo để kích hoạt động cơ hạn mức chi tiêu mỗi ngày DSA thích ứng."
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Bắt đầu thiết lập ngân sách ngay"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            FontAttributes="Bold"
                            Command="{Binding NavigateToCreateBudgetCommand}"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- ACTIVE BUDGET SECTION -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding HasActiveBudget}">

                <!-- 1. OVERALL BUDGET HEADER CARD -->
                <Border Stroke="#3B82F6" BackgroundColor="#EFF6FF" Padding="16" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding ActiveBudget.Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1E3A8A" />
                            <Border Grid.Column="1"
                                    BackgroundColor="#DBEAFE"
                                    Padding="8,4"
                                    StrokeShape="RoundRectangle 6"
                                    Stroke="Transparent">
                                <Label Text="{Binding ActiveBudget.MethodName}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#1D4ED8" />
                            </Border>
                        </Grid>

                        <Label Text="{Binding ActiveBudget.PeriodSummary}"
                               FontSize="12"
                               TextColor="#3B82F6" />

                        <BoxView HeightRequest="1" Color="#BFDBFE" Margin="0,4" />

                        <!-- Key Metrics Grid -->
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0" Text="Tổng hạn mức" FontSize="11" TextColor="#6B7280" />
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding ActiveBudget.TotalAllocatedAmount, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#111827" />

                            <Label Grid.Row="0" Grid.Column="1" Text="Đã chi tiêu" FontSize="11" TextColor="#6B7280" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ActiveBudget.TotalSpentAmount, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#DC2626" />

                            <Label Grid.Row="0" Grid.Column="2" Text="Còn lại" FontSize="11" TextColor="#6B7280" />
                            <Label Grid.Row="1" Grid.Column="2"
                                   Text="{Binding ActiveBudget.TotalRemainingAmount, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#059669" />
                        </Grid>

                        <!-- Overall Progress Bar -->
                        <VerticalStackLayout Spacing="3" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding DaysPassed, StringFormat='Tiến độ chu kỳ: Ngày {0}'}"
                                       FontSize="11" TextColor="#4B5563" />
                                <Label Grid.Column="1"
                                       Text="{Binding ActiveBudget.OverallSpentPercent, StringFormat='Đã giải ngân: {0:F1}%'}"
                                       FontSize="11" FontAttributes="Bold" TextColor="#1E3A8A" />
                            </Grid>
                            <ProgressBar Progress="{Binding ActiveBudget.ProgressFraction}"
                                         ProgressColor="#2563EB"
                                         HeightRequest="8" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. ADAPTIVE DSA WIDGET (UC-05.05) -->
                <Border Stroke="{Binding DsaStatus.DsaColor}"
                        BackgroundColor="#FFFFFF"
                        Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Shadow="{Shadow Brush=Black, Offset='0,2', Radius=4, Opacity=0.08}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="⚡ HẠN MỨC CHI TIÊU HÔM NAY (ADAPTIVE DSA)"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#6B7280" />
                                <Label Text="{Binding DsaStatus.DailyAllowance, StringFormat='{0:N0} đ'}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{Binding DsaStatus.DsaColor}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    BackgroundColor="#F3F4F6"
                                    Padding="10,6"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="Transparent"
                                    VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Khả dụng hôm nay" FontSize="10" TextColor="#6B7280" HorizontalOptions="Center" />
                                    <Label Text="{Binding DsaStatus.RemainingToday, StringFormat='{0:N0} đ'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{Binding DsaStatus.DsaColor}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,2" />

                        <!-- Today details and explanation -->
                        <Grid ColumnDefinitions="*,*">
                            <Label Grid.Column="0"
                                   Text="{Binding DsaStatus.TodaySpent, StringFormat='Đã chi hôm nay: {0:N0} đ'}"
                                   FontSize="12"
                                   TextColor="#4B5563" />
                            <Label Grid.Column="1"
                                   Text="{Binding DsaStatus.RemainingDays, StringFormat='Số ngày còn lại: {0} ngày'}"
                                   FontSize="12"
                                   HorizontalTextAlignment="End"
                                   TextColor="#4B5563" />
                        </Grid>

                        <Label Text="{Binding DsaStatus.Note}"
                               FontSize="11"
                               TextColor="#475569"
                               FontAttributes="Italic" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. SPENDING VELOCITY & OUT-OF-MONEY FORECAST CARD (UC-05.06) -->
                <Border Stroke="{Binding VelocityStatus.VelocityColor}"
                        BackgroundColor="#FFFFFF"
                        Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Shadow="{Shadow Brush=Black, Offset='0,2', Radius=4, Opacity=0.08}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="⏱ TỐC ĐỘ TIÊU TIỀN (SPENDING VELOCITY)"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#6B7280" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding VelocityStatus.VelocityIndex, StringFormat='{0:F2}x'}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{Binding VelocityStatus.VelocityColor}" />
                                    <Label Text="{Binding VelocityStatus.StatusText}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{Binding VelocityStatus.VelocityColor}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label Grid.Column="1"
                                   Text="{Binding VelocityStatus.BurnRateDescription}"
                                   FontSize="12"
                                   TextColor="#4B5563"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Velocity Comparison -->
                        <Grid ColumnDefinitions="*,*">
                            <Label Grid.Column="0"
                                   Text="{Binding VelocityStatus.ActualDailyBurnRate, StringFormat='Thực tế: {0:N0} đ/ngày'}"
                                   FontSize="12"
                                   TextColor="#DC2626" />
                            <Label Grid.Column="1"
                                   Text="{Binding VelocityStatus.TargetDailyBurnRate, StringFormat='Mục tiêu: {0:N0} đ/ngày'}"
                                   FontSize="12"
                                   HorizontalTextAlignment="End"
                                   TextColor="#059669" />
                        </Grid>

                        <!-- CRITICAL ALERT: Out-of-Money Date Forecast if Burn Rate is dangerous -->
                        <Border IsVisible="{Binding VelocityStatus.IsCritical}"
                                Stroke="#DC2626"
                                BackgroundColor="#FEF2F2"
                                Padding="12"
                                StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="🚨 CẢNH BÁO NGUY CƠ CHÁY TÚI SỚM!"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#991B1B" />
                                <Label Text="{Binding VelocityStatus.ForecastMessage}"
                                       FontSize="12"
                                       TextColor="#B91C1C" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. CATEGORY ALLOCATIONS & ERGONOMIC 3-BAND PROGRESS (UC-05.02, UC-05.04) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tiến Độ Chi Tiêu Từng Danh Mục (UC-05.02)"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#111827" />

                    <CollectionView ItemsSource="{Binding Allocations}">
                        <CollectionView.EmptyView>
                            <Label Text="Chưa có danh mục nào được phân bổ trong kế hoạch này."
                                   TextColor="Gray"
                                   HorizontalOptions="Center"
                                   Margin="0,16" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:BudgetAllocationModel">
                                <Border Stroke="#E5E7EB"
                                        BackgroundColor="#FFFFFF"
                                        Padding="14"
                                        Margin="0,4"
                                        StrokeShape="RoundRectangle 10"
                                        Shadow="{Shadow Brush=Black, Offset='0,1', Radius=2, Opacity=0.04}">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                                <Label Text="{Binding CategoryIcon}" FontSize="14" VerticalOptions="Center" IsVisible="{Binding CategoryIcon, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />
                                                <Label Text="{Binding CategoryName}" FontSize="14" FontAttributes="Bold" TextColor="#1F2937" VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <!-- Micro-Alert Badge (UC-05.04) -->
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding IsAlertTriggered}"
                                                    BackgroundColor="#FEE2E2"
                                                    Padding="6,2"
                                                    StrokeShape="RoundRectangle 4"
                                                    Stroke="Transparent">
                                                <Label Text="⚠️ Cảnh báo &gt;=80%"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="#DC2626" />
                                            </Border>
                                        </Grid>

                                        <!-- Amounts Summary -->
                                        <Grid ColumnDefinitions="*,*,*">
                                            <Label Grid.Column="0"
                                                   Text="{Binding AllocatedAmount, StringFormat='Hạn mức: {0:N0} đ'}"
                                                   FontSize="11" TextColor="#6B7280" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding CurrentSpent, StringFormat='Đã tiêu: {0:N0} đ'}"
                                                   FontSize="11" TextColor="#DC2626" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding RemainingAmount, StringFormat='Còn lại: {0:N0} đ'}"
                                                   FontSize="11" TextColor="#059669" HorizontalTextAlignment="End" />
                                        </Grid>

                                        <!-- Ergonomic 3-band Color Progress Bar -->
                                        <ProgressBar Progress="{Binding ProgressFraction}"
                                                     ProgressColor="{Binding ProgressBarColor}"
                                                     HeightRequest="8" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding RuleName}"
                                                   FontSize="10" TextColor="#9CA3AF" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding SpentPercent, StringFormat='{0:F1}%'}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{Binding ProgressBarColor}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 5. DANGER ZONE: Close Budget Action -->
                <Border Stroke="#FCA5A5" BackgroundColor="#FEF2F2" Padding="14" StrokeShape="RoundRectangle 8" Margin="0,8,0,16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Đóng Kế Hoạch Ngân Sách Hiện Tại"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#991B1B" />
                        <Label Text="Khi đóng kế hoạch, hệ thống sẽ lưu trữ và hoàn tất chu kỳ ngân sách này. Bạn có thể tạo kế hoạch mới bất cứ lúc nào."
                               FontSize="12"
                               TextColor="#7F1D1D" />
                        <Button Text="Đóng Ngân Sách Này"
                                BackgroundColor="#EF4444"
                                TextColor="White"
                                FontAttributes="Bold"
                                Command="{Binding CloseActiveBudgetCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
