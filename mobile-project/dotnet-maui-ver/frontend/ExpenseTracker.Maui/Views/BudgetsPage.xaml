<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Budgets"
             xmlns:components="clr-namespace:ExpenseTracker.Maui.Views.Components"
             x:Class="ExpenseTracker.Maui.Views.BudgetsPage"
             x:DataType="vm:BudgetsViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <Grid RowDefinitions="*, Auto">
        <!-- VÙNG CUỘN NỘI DUNG CHÍNH -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12,16,28" Spacing="16" MaximumWidthRequest="640">

                <!-- 1. BẢNG THÔNG BÁO LỖI HOẶC THÀNH CÔNG -->
                <Border BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                        Stroke="#FECACA" StrokeShape="RoundRectangle 12" Padding="14,10"
                        IsVisible="{Binding HasError}">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#EF4444" VerticalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                        Stroke="#A7F3D0" StrokeShape="RoundRectangle 12" Padding="14,10"
                        IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#10B981" VerticalOptions="Center" />
                        <Label Text="{Binding StatusMessage}" TextColor="#065F46" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- NÚT TÁC VỤ ĐẦU TRANG -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="+ Lập Kế Hoạch Ngân Sách Mới"
                            Style="{StaticResource FintechPrimaryBtnStyle}"
                            HeightRequest="46"
                            Command="{Binding NavigateToCreateBudgetCommand}" />

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                            HeightRequest="46"
                            Padding="14,0"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadActiveBudgetProgressCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Image Source="ic_refresh.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Text="Tải lại"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- TRẠNG THÁI CHƯA CÓ NGÂN SÁCH -->
                <Border IsVisible="{Binding HasActiveBudget, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource FintechCardStyle}"
                        Padding="28,24">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                        <Border WidthRequest="64" HeightRequest="64"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Image Source="ic_budget.svg" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Chưa có kế hoạch ngân sách đang hoạt động"
                               Style="{StaticResource FintechCardTitleStyle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Thiết lập kế hoạch theo phương pháp 50/30/20, Zero-Based hoặc Kakeibo để kiểm soát chi tiêu mỗi ngày và nhận cảnh báo sớm tốc độ tiêu tiền."
                               Style="{StaticResource FintechCaptionStyle}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Bắt đầu thiết lập ngay"
                                Style="{StaticResource FintechPrimaryBtnStyle}"
                                HeightRequest="44"
                                Command="{Binding NavigateToCreateBudgetCommand}"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. KHI ĐÃ CÓ NGÂN SÁCH ĐANG HOẠT ĐỘNG -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding HasActiveBudget}">

                    <!-- HERO BUDGET CARD -->
                    <Border Stroke="{AppThemeBinding Light=#4338CA, Dark=#6366F1}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 24"
                            Padding="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0F172A" Offset="0.0" />
                                <GradientStop Color="#1E1B4B" Offset="0.5" />
                                <GradientStop Color="#312E81" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#312E81" Offset="0,6" Radius="20" Opacity="0.35" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="{Binding ActiveBudget.Name}"
                                       FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />
                                <Border Grid.Column="1" BackgroundColor="#4338CA" Padding="10,4" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Label Text="{Binding ActiveBudget.MethodName}" FontSize="11" FontAttributes="Bold" TextColor="#E0E7FF" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding ActiveBudget.PeriodSummary}" FontSize="12" TextColor="#A5B4FC" />

                            <BoxView HeightRequest="1" Color="#4338CA" Margin="0,2" />

                            <!-- 3 CỘT: HẠN MỨC, ĐÃ TIÊU, CÒN LẠI -->
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                <Label Grid.Row="0" Grid.Column="0" Text="TỔNG HẠN MỨC" FontSize="10" FontAttributes="Bold" TextColor="#A5B4FC" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding ActiveBudget.TotalAllocatedAmount, StringFormat='{0:N0} đ'}"
                                       FontSize="14" FontAttributes="Bold" TextColor="#FFFFFF" />

                                <Label Grid.Row="0" Grid.Column="1" Text="ĐÃ CHI TIÊU" FontSize="10" FontAttributes="Bold" TextColor="#FCA5A5" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding ActiveBudget.TotalSpentAmount, StringFormat='{0:N0} đ'}"
                                       FontSize="14" FontAttributes="Bold" TextColor="#FDA4AF" />

                                <Label Grid.Row="0" Grid.Column="2" Text="CÒN LẠI" FontSize="10" FontAttributes="Bold" TextColor="#86EFAC" />
                                <Label Grid.Row="1" Grid.Column="2"
                                       Text="{Binding ActiveBudget.TotalRemainingAmount, StringFormat='{0:N0} đ'}"
                                       FontSize="14" FontAttributes="Bold" TextColor="#6EE7B7" />
                            </Grid>

                            <VerticalStackLayout Spacing="6" Margin="0,6,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding DaysPassed, StringFormat='Tiến độ chu kỳ: Ngày {0}'}" FontSize="11" TextColor="#C7D2FE" />
                                    <Label Grid.Column="1" Text="{Binding ActiveBudget.OverallSpentPercent, StringFormat='Đã giải ngân: {0:F1}%'}" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF" />
                                </Grid>
                                <ProgressBar Progress="{Binding ActiveBudget.ProgressFraction}" ProgressColor="#38BDF8" HeightRequest="8" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- HẠN MỨC CHI TIÊU AN TOÀN HÔM NAY (DSA CARD) -->
                    <Border Stroke="{Binding DsaStatus.DsaColor}"
                            StrokeThickness="1.5"
                            Style="{StaticResource FintechCardStyle}"
                            Padding="18">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{Binding DsaStatus.DsaColor}" VerticalOptions="Center" />
                                        <Label Text="HẠN MỨC CHI TIÊU AN TOÀN HÔM NAY"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource FintechTextMuted}, Dark={StaticResource FintechTextMuted}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding DsaStatus.DailyAllowance, StringFormat='{0:N0} đ'}"
                                           FontSize="24" FontAttributes="Bold" TextColor="{Binding DsaStatus.DsaColor}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                        Padding="12,8" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="Khả dụng hôm nay" FontSize="10" TextColor="{StaticResource FintechTextMuted}" HorizontalOptions="Center" />
                                        <Label Text="{Binding DsaStatus.RemainingToday, StringFormat='{0:N0} đ'}"
                                               FontSize="15" FontAttributes="Bold" TextColor="{Binding DsaStatus.DsaColor}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}" Margin="0,2" />

                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="{Binding DsaStatus.TodaySpent, StringFormat='Đã chi hôm nay: {0:N0} đ'}" Style="{StaticResource FintechCaptionStyle}" />
                                <Label Grid.Column="1" Text="{Binding DsaStatus.RemainingDays, StringFormat='Số ngày còn lại: {0} ngày'}" Style="{StaticResource FintechCaptionStyle}" HorizontalTextAlignment="End" />
                            </Grid>

                            <Label Text="{Binding DsaStatus.Note}" FontSize="11" TextColor="{StaticResource FintechTextMuted}" FontAttributes="Italic" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- TỐC ĐỘ TIÊU TIỀN (SPENDING VELOCITY) -->
                    <Border Stroke="{Binding VelocityStatus.VelocityColor}"
                            StrokeThickness="1.5"
                            Style="{StaticResource FintechCardStyle}"
                            Padding="18">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{Binding VelocityStatus.VelocityColor}" VerticalOptions="Center" />
                                        <Label Text="TỐC ĐỘ TIÊU TIỀN BÌNH QUÂN"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource FintechTextMuted}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="{Binding VelocityStatus.VelocityIndex, StringFormat='{0:F2}x'}"
                                               FontSize="22" FontAttributes="Bold" TextColor="{Binding VelocityStatus.VelocityColor}" />
                                        <Label Text="{Binding VelocityStatus.StatusText}"
                                               FontSize="13" FontAttributes="Bold" TextColor="{Binding VelocityStatus.VelocityColor}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Grid.Column="1" Text="{Binding VelocityStatus.BurnRateDescription}" Style="{StaticResource FintechCaptionStyle}" VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="{Binding VelocityStatus.ActualDailyBurnRate, StringFormat='Thực tế: {0:N0} đ/ngày'}"
                                       FontSize="12" TextColor="{StaticResource FintechExpense}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding VelocityStatus.TargetDailyBurnRate, StringFormat='Mục tiêu: {0:N0} đ/ngày'}"
                                       FontSize="12" HorizontalTextAlignment="End" TextColor="{StaticResource FintechIncome}" FontAttributes="Bold" />
                            </Grid>

                            <Border IsVisible="{Binding VelocityStatus.IsCritical}"
                                    Stroke="{StaticResource FintechExpense}"
                                    BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                                    Padding="12" StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="CẢNH BÁO NGUY CƠ CẠN HẠN MỨC SỚM" FontSize="12" FontAttributes="Bold" TextColor="#991B1B" />
                                    <Label Text="{Binding VelocityStatus.ForecastMessage}" FontSize="12" TextColor="#B91C1C" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- TIẾN ĐỘ TỪNG DANH MỤC -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="TIẾN ĐỘ THEO TỪNG DANH MỤC" Style="{StaticResource FintechSectionTitleStyle}" />
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}" Padding="10,4" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                <Label Text="Thời gian thực" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FintechPrimary}" />
                            </Border>
                        </Grid>

                        <CollectionView ItemsSource="{Binding Allocations}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="Chưa có danh mục nào được phân bổ trong kế hoạch này."
                                       Style="{StaticResource FintechCaptionStyle}"
                                       HorizontalOptions="Center" Margin="0,16" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:BudgetAllocationModel">
                                    <Border Style="{StaticResource FintechCardStyle}" Padding="14" Margin="0,0,0,8">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                    <Border WidthRequest="32" HeightRequest="32"
                                                            StrokeShape="RoundRectangle 8"
                                                            BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                                            StrokeThickness="0"
                                                            VerticalOptions="Center">
                                                        <Image Source="ic_category.svg" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                    <Label Text="{Binding CategoryName}"
                                                           Style="{StaticResource FintechCardTitleStyle}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>

                                                <Border Grid.Column="1"
                                                        IsVisible="{Binding IsAlertTriggered}"
                                                        BackgroundColor="#FEE2E2" Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                                    <Label Text="Cảnh báo ≥80%" FontSize="10" FontAttributes="Bold" TextColor="#DC2626" />
                                                </Border>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,*,*">
                                                <Label Grid.Column="0" Text="{Binding AllocatedAmount, StringFormat='Hạn mức: {0:N0} đ'}" Style="{StaticResource FintechCaptionStyle}" />
                                                <Label Grid.Column="1" Text="{Binding CurrentSpent, StringFormat='Đã tiêu: {0:N0} đ'}" FontSize="11" TextColor="{StaticResource FintechExpense}" FontAttributes="Bold" />
                                                <Label Grid.Column="2" Text="{Binding RemainingAmount, StringFormat='Còn lại: {0:N0} đ'}" FontSize="11" TextColor="{StaticResource FintechIncome}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                            </Grid>

                                            <ProgressBar Progress="{Binding ProgressFraction}" ProgressColor="{Binding ProgressBarColor}" HeightRequest="8" />

                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0" Text="{Binding RuleName}" Style="{StaticResource FintechCaptionStyle}" />
                                                <Label Grid.Column="1" Text="{Binding SpentPercent, StringFormat='{0:F1}%'}" FontSize="11" FontAttributes="Bold" TextColor="{Binding ProgressBarColor}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- NÚT ĐÓNG KẾ HOẠCH NGÂN SÁCH -->
                    <Border Stroke="#FCA5A5" BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                            Padding="16" StrokeShape="RoundRectangle 14" Margin="0,8,0,16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Đóng Kế Hoạch Ngân Sách Hiện Tại" FontAttributes="Bold" FontSize="13" TextColor="#991B1B" />
                            <Label Text="Khi đóng kế hoạch, hệ thống sẽ lưu trữ và hoàn tất chu kỳ ngân sách này. Bạn có thể tạo kế hoạch mới bất cứ lúc nào."
                                   FontSize="12" TextColor="{AppThemeBinding Light=#7F1D1D, Dark=#FCA5A5}" />
                            <Button Text="Đóng Ngân Sách Này"
                                    BackgroundColor="#EF4444" TextColor="White"
                                    FontAttributes="Bold" FontSize="13" CornerRadius="10" HeightRequest="44"
                                    Command="{Binding CloseActiveBudgetCommand}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DUY NHẤT 1 THANH BOTTOM BAR BỒNG BỀNH -->
        <components:BottomNavDockView Grid.Row="1" ActiveTab="Budgets" />
    </Grid>
</ContentPage>