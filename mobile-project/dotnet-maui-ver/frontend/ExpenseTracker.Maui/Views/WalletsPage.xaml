<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Wallets"
             xmlns:viewsAuto="clr-namespace:ExpenseTracker.Maui.Views.Autonomous"
             xmlns:components="clr-namespace:ExpenseTracker.Maui.Views.Components"
             x:Class="ExpenseTracker.Maui.Views.WalletsPage"
             x:DataType="vm:WalletsViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <Grid RowDefinitions="*, Auto">
        <!-- 1. VÙNG CUỘN NỘI DUNG CHÍNH (MAIN SCROLLABLE CONTENT) -->
        <RefreshView Grid.Row="0" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadWalletsCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="18" Padding="16,12,16,100" MaximumWidthRequest="640">

                    <!-- TOP HEADER BAR TÍCH HỢP (AVATAR, LỜI CHÀO & CHUÔNG THÔNG BÁO) -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                            <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="#4F46E5">
                                <Image Source="ic_user.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Chào mừng trở lại" Style="{StaticResource FintechCaptionStyle}" />
                                <Label Text="Tài chính hôm nay an toàn" Style="{StaticResource FintechCardTitleStyle}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <!-- Realtime Badge nhỏ gọn -->
                            <Border BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" StrokeShape="RoundRectangle 10" Padding="8,5" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="3.5" Color="{Binding RealtimeDotColor}" VerticalOptions="Center" />
                                    <Label Text="Realtime" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#065F46, Dark=#6EE7B7}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Nút Thông Báo có Badge -->
                            <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                                    Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                    Padding="0" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNotificationsClicked" />
                                </Border.GestureRecognizers>
                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="ic_bell.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <BoxView WidthRequest="7" HeightRequest="7" CornerRadius="3.5" Color="#EF4444" 
                                             HorizontalOptions="End" VerticalOptions="Start" Margin="0,-2,-2,0" />
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- DÒNG TRẠNG THÁI THÔNG BÁO TỨC THÌ (NẾU CÓ) -->
                    <Border Stroke="{StaticResource FintechIncome}" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" 
                            Padding="12,8"
                            IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource FintechIncomeDark}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding StatusMessage}" 
                                   TextColor="{AppThemeBinding Light=#065F46, Dark=#A7F3D0}" 
                                   FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- TOTAL BALANCE HERO CARD (MIDNIGHT TITANIUM BLACK CARD) -->
                    <Border Stroke="{AppThemeBinding Light=#312E81, Dark=#4338CA}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 24"
                            Padding="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0F172A" Offset="0.0" />
                                <GradientStop Color="#1E1B4B" Offset="0.5" />
                                <GradientStop Color="#312E81" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#312E81" Offset="0,6" Radius="20" Opacity="0.35" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Image Source="ic_shield.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                    <Label Text="TỔNG TÀI SẢN KHẢ DỤNG" FontSize="11" FontAttributes="Bold" TextColor="#A5B4FC" CharacterSpacing="1" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#064E3B" StrokeShape="RoundRectangle 8" Padding="8,3" VerticalOptions="Center">
                                    <Label Text="ĐA VÍ AN TOÀN" FontSize="10" FontAttributes="Bold" TextColor="#6EE7B7" />
                                </Border>
                            </Grid>

                            <!-- Số dư 34pt siêu lớn và sắc sảo -->
                            <Label Text="{Binding FormattedTotalBalance}" FontSize="34" FontAttributes="Bold" TextColor="#FFFFFF" />

                            <BoxView HeightRequest="1" Color="#334155" Margin="0,2,0,2" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Số tài khoản ví" FontSize="11" TextColor="#94A3B8" />
                                    <Label Text="{Binding Wallets.Count, StringFormat='{0} nguồn tiền'}" FontSize="13" FontAttributes="Bold" TextColor="#F8FAFC" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                    <Label Text="Trạng thái dòng tiền" FontSize="11" TextColor="#94A3B8" HorizontalTextAlignment="End" />
                                    <Label Text="Sẵn sàng chi tiêu" FontSize="13" FontAttributes="Bold" TextColor="#10B981" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ACTION INBOX (THẺ BIẾN ĐỘNG SỐ DƯ TỰ ĐỘNG THÔNG MINH) -->
                    <viewsAuto:ActionInboxView BindingContext="{Binding ActionInbox}" />

                    <!-- QUICK ACTION PILLS (4 THAO TÁC NHANH CAPSULE SANG TRỌNG) -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <!-- Thêm Chi -->
                        <Border Grid.Column="0" Style="{StaticResource FintechCardStyle}" Padding="6,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnQuickExpenseClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#FFE4E6">
                                    <Image Source="ic_expense.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Thêm chi" FontSize="11" FontAttributes="Bold" Style="{StaticResource FintechBodyStyle}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Thêm Thu -->
                        <Border Grid.Column="1" Style="{StaticResource FintechCardStyle}" Padding="6,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnQuickIncomeClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#DCFCE7">
                                    <Image Source="ic_income.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Thêm thu" FontSize="11" FontAttributes="Bold" Style="{StaticResource FintechBodyStyle}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Quét Hóa Đơn AI -->
                        <Border Grid.Column="2" Style="{StaticResource FintechCardStyle}" Padding="6,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnQuickOcrClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#EDE9FE">
                                    <Image Source="ic_ocr.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Quét ảnh" FontSize="11" FontAttributes="Bold" Style="{StaticResource FintechBodyStyle}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Ngân Sách -->
                        <Border Grid.Column="3" Style="{StaticResource FintechCardStyle}" Padding="6,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnQuickBudgetClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 14" StrokeThickness="0" BackgroundColor="#E0F2FE">
                                    <Image Source="ic_budget.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Ngân sách" FontSize="11" FontAttributes="Bold" Style="{StaticResource FintechBodyStyle}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- BANK CARD CAROUSEL (THẺ ATM NGÂN HÀNG LƯỚT NGANG - ĐÚNG CHUẨN WIREFRAME) -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="THẺ VÍ TÀI CHÍNH" Style="{StaticResource FintechSectionTitleStyle}" VerticalOptions="Center" />
                            
                            <!-- Nút Thêm Ví Mới Trực Tiếp -->
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                    Stroke="{StaticResource FintechPrimary}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="10,5" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAddWalletClicked" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="+" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FintechPrimary}" VerticalOptions="Center" />
                                    <Label Text="Thêm ví" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FintechPrimary}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Nút Quản Lý Ví (Xem chi tiết, Sửa, Cân chỉnh, Xóa) -->
                            <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="10,5" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnManageWalletsClicked" />
                                </Border.GestureRecognizers>
                                <Label Text="Quản lý →" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <CollectionView ItemsSource="{Binding Wallets}" SelectionMode="None" HeightRequest="170">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Border Style="{StaticResource FintechCardStyle}" WidthRequest="280" HeightRequest="155" Padding="16">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image Source="ic_wallet.svg" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />
                                        <Label Text="Bạn chưa có ví nào. Hãy bấm thêm ví!" Style="{StaticResource FintechCaptionStyle}" HorizontalTextAlignment="Center" />
                                        <Button Text="+ Thêm ví ngay" Clicked="OnAddWalletClicked" Style="{StaticResource FintechButtonPrimary}" HeightRequest="36" FontSize="12" Padding="12,0" />
                                    </VerticalStackLayout>
                                </Border>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:WalletModel">
                                    <!-- THẺ ATM CHUẨN TỶ LỆ VÀNG 280 x 155 -->
                                    <Border WidthRequest="280" HeightRequest="155"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                            Padding="16">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnManageWalletsClicked" />
                                        </Border.GestureRecognizers>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{Binding ColorHex}" Offset="0.0" />
                                                <GradientStop Color="#0F172A" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Shadow>
                                            <Shadow Brush="#000000" Offset="0,4" Radius="14" Opacity="0.25" />
                                        </Border.Shadow>

                                        <Grid RowDefinitions="Auto,*,Auto">
                                            <!-- Top: Bank / Wallet Type + Chip -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="{Binding WalletTypeName}" FontSize="10" FontAttributes="Bold" TextColor="#CBD5E1" />
                                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#FFFFFF" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <!-- Chip kim loại vàng thẻ ATM -->
                                                <Border Grid.Column="1" WidthRequest="28" HeightRequest="20" StrokeShape="RoundRectangle 4" BackgroundColor="#EAB308" StrokeThickness="0" Padding="3">
                                                    <BoxView Color="#CA8A04" HeightRequest="1.5" VerticalOptions="Center" />
                                                </Border>
                                            </Grid>

                                            <!-- Middle: Số thẻ che bảo mật -->
                                            <HorizontalStackLayout Grid.Row="1" Spacing="6" VerticalOptions="Center">
                                                <Label Text="••••" FontSize="13" FontAttributes="Bold" TextColor="#94A3B8" />
                                                <Label Text="••••" FontSize="13" FontAttributes="Bold" TextColor="#94A3B8" />
                                                <Label Text="{Binding SubtitleInfo}" FontSize="12" FontAttributes="Bold" TextColor="#E2E8F0" />
                                            </HorizontalStackLayout>

                                            <!-- Bottom: Số dư và Vector Icon -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalOptions="End">
                                                <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="SỐ DƯ KHẢ DỤNG" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" />
                                                    <Label Text="{Binding FormattedBalance}" FontSize="16" FontAttributes="Bold" TextColor="#FFFFFF" />
                                                </VerticalStackLayout>
                                                <Image Grid.Column="1" Source="ic_card.svg" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- KHUNG ĐIỀU CHUYỂN TIỀN NỘI BỘ GIỮA 2 VÍ (INTER-WALLET TRANSFER SHEET) -->
                    <Border Style="{StaticResource FintechCardStyle}" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Image Source="ic_rules.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                    <Label Text="CHUYỂN TIỀN NỘI BỘ GIỮA 2 VÍ" Style="{StaticResource FintechCardTitleStyle}" />
                                </HorizontalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}" StrokeShape="RoundRectangle 8" Padding="6,2">
                                    <Label Text="0ms ACID" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource FintechPrimary}" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <!-- Ví Nguồn -->
                                <Border Grid.Column="0" Style="{StaticResource FintechInput}" Padding="8,4">
                                    <Picker Title="Ví chuyển" ItemsSource="{Binding Wallets}" ItemDisplayBinding="{Binding Name}"
                                            SelectedIndex="0" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                                </Border>

                                <!-- Mũi tên chuyển -->
                                <Border Grid.Column="1" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{StaticResource FintechPrimary}" StrokeThickness="0" VerticalOptions="Center">
                                    <Label Text="→" FontSize="16" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <!-- Ví Nhận -->
                                <Border Grid.Column="2" Style="{StaticResource FintechInput}" Padding="8,4">
                                    <Picker Title="Ví nhận" ItemsSource="{Binding Wallets}" ItemDisplayBinding="{Binding Name}"
                                            SelectedIndex="1" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Border Grid.Column="0" Style="{StaticResource FintechInput}" Padding="10,2">
                                    <Entry x:Name="TransferAmountEntry" Placeholder="Số tiền chuyển (đ)..." Keyboard="Numeric"
                                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                                </Border>
                                <Button Grid.Column="1" Text="Chuyển ngay" Clicked="OnQuickTransferClicked"
                                        Style="{StaticResource FintechButtonPrimary}" HeightRequest="40" Padding="14,0" FontSize="12" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- 2. DUY NHẤT 1 THANH BOTTOM DOCK BỒNG BỀNH CÓ NÚT MICRO VOICE AI -->
        <components:BottomNavDockView Grid.Row="1" ActiveTab="Wallets" />
    </Grid>
</ContentPage>
