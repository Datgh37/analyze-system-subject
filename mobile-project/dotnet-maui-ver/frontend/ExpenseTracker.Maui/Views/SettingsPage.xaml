<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             x:Class="ExpenseTracker.Maui.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- BANNER TIÊU ĐỀ & CHẾ ĐỘ -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Image Source="ic_settings.png" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Trung Tâm Điều Khiển Hạ Tầng" FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Label Text="Cấu hình nguồn dữ liệu &amp; công cụ kiểm thử demo" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,6" />

                    <!-- Trạng Thái Hiện Tại -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Text="Trạng thái kết nối:" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border Grid.Column="1" Padding="10,4" StrokeShape="RoundRectangle 8"
                                BackgroundColor="#3B82F6">
                            <Label Text="{Binding ConnectionStatusText}" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- CARD 1: CÔNG TẮC NGUỒN DỮ LIỆU -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="1. Lựa Chọn Nguồn Dữ Liệu (Data Source)" FontSize="15" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />

                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Chế độ Backend Web API Thật" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Label Text="Bật để gọi API thật từ máy chủ (Render/Cloudflare Tunnel)" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsLiveApiMode}"
                                OnColor="#4F46E5" ThumbColor="#FFFFFF" />
                    </Grid>

                    <Label Text="* Lưu ý: Khi tắt công tắc, ứng dụng lập tức chuyển sang Chế độ Demo Ngoại Tuyến (Offline Mock Mode 0ms) với đầy đủ dữ liệu mẫu cho 20 màn hình mà không cần máy chủ."
                           FontSize="11" FontAttributes="Italic" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                </VerticalStackLayout>
            </Border>

            <!-- CARD 2: CẤU HÌNH SERVER URL -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="2. Địa Chỉ Máy Chủ (Server Base URL)" FontSize="15" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />

                    <Label Text="Nhập URL Cloudflare Tunnel (https://...trycloudflare.com) hoặc IP LAN Hotspot:"
                           FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

                    <Border Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,4"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">
                        <Entry Text="{Binding ServerUrl}"
                               Placeholder="http://10.0.2.2:5018 hoặc https://..."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                    </Border>

                    <!-- Các nút chọn nhanh máy chủ 1-chạm -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Chọn Localhost"
                                Command="{Binding UseLocalhostCommand}"
                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                TextColor="{AppThemeBinding Light=#4338CA, Dark=#C7D2FE}"
                                CornerRadius="8"
                                HeightRequest="38"
                                FontSize="12"
                                FontAttributes="Bold" />

                        <Button Grid.Column="1"
                                Text="Chọn Tunnel (Live)"
                                Command="{Binding UseTunnelCommand}"
                                BackgroundColor="{AppThemeBinding Light=#FAF5FF, Dark=#3B0764}"
                                TextColor="{AppThemeBinding Light=#7E22CE, Dark=#E9D5FF}"
                                CornerRadius="8"
                                HeightRequest="38"
                                FontSize="12"
                                FontAttributes="Bold" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Lưu URL"
                                Command="{Binding SaveServerUrlCommand}"
                                BackgroundColor="#3B82F6"
                                TextColor="#FFFFFF"
                                CornerRadius="10"
                                HeightRequest="44"
                                FontAttributes="Bold" />

                        <Button Grid.Column="1"
                                Text="Ping Server"
                                Command="{Binding PingServerCommand}"
                                BackgroundColor="#10B981"
                                TextColor="#FFFFFF"
                                CornerRadius="10"
                                HeightRequest="44"
                                FontAttributes="Bold" />
                    </Grid>

                    <!-- Kết Quả Ping -->
                    <Label Text="{Binding PingResult}"
                           IsVisible="{Binding PingResult, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                           FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#059669, Dark=#34D399}" />

                    <Border StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            HeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetDefaultsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Grid.Column="0" Source="ic_refresh.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Khôi Phục Mặc Định" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="12" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- CARD 3: KIỂM CHỨNG BANK NOTIFICATION DETECTION (KILLED STATE) -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="3. Kiểm Chứng Bóc Tách Thông Báo Ngân Hàng" FontSize="15" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />

                    <Label Text="Bấm nút bên dưới để mô phỏng tức thì một thông báo trừ tiền từ Ví MoMo (-75.000đ tại Highlands Coffee) để kiểm tra luồng bóc tách tự động và đẩy Native Heads-Up Notification:"
                           FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

                    <Button Text="Giả Lập Biến Động MoMo (-75.000đ)"
                            Command="{Binding SimulateBankNotificationCommand}"
                            BackgroundColor="#8B5CF6"
                            TextColor="#FFFFFF"
                            CornerRadius="10"
                            HeightRequest="46"
                            FontAttributes="Bold" />

                    <Label Text="{Binding SimulationStatus}"
                           IsVisible="{Binding SimulationStatus, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                           FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#8B5CF6" />
                </VerticalStackLayout>
            </Border>

            <!-- CARD 4: KIỂM CHỨNG BÁO THỨC ĐÁNH THỨC KHI APP BỊ ĐÓNG HOÀN TOÀN (KILLED STATE) -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Image Source="ic_bell.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Text="4. Kiểm Thử Thông Báo Khi Đã Tắt App (Killed State)" FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="Kịch bản Demo trực tiếp không cần máy tính: Bấm nút bên dưới để hẹn giờ qua Android AlarmManager, sau đó bạn vuốt tắt app hoàn toàn khỏi đa nhiệm. Sau đúng 10 giây, Android OS sẽ tự động rung chuông và đẩy thông báo nhắc nhở 21:00 lên màn hình!"
                           FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

                    <Button Text="Hẹn Giờ 10 Giây &amp; Vuốt Tắt App (Demo)"
                            Command="{Binding ScheduleTestReminderCommand}"
                            BackgroundColor="#F59E0B"
                            TextColor="#FFFFFF"
                            CornerRadius="10"
                            HeightRequest="46"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
