<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:components="clr-namespace:ExpenseTracker.Maui.Views.Components"
             x:Class="ExpenseTracker.Maui.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12,16,28" Spacing="16" MaximumWidthRequest="640">

                <!-- 1. HERO CARD: TRUNG TÂM CÀI ĐẶT & BẢO MẬT -->
                <Border Stroke="{AppThemeBinding Light=#4338CA, Dark=#6366F1}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 24"
                        Padding="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0.0" />
                            <GradientStop Color="#1E1B4B" Offset="0.5" />
                            <GradientStop Color="#312E81" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#312E81" Offset="0,6" Radius="20" Opacity="0.35" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Image Source="ic_settings.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                <Label Text="TRUNG TÂM CÀI ĐẶT" FontSize="11" FontAttributes="Bold" TextColor="#A5B4FC" CharacterSpacing="1" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#064E3B" Padding="8,3" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                <Label Text="AES-256 GCM" FontSize="10" FontAttributes="Bold" TextColor="#6EE7B7" />
                            </Border>
                        </Grid>

                        <Label Text="Thiết Lập Ứng Dụng &amp; Hạ Tầng" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />

                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Margin="0,4,0,0">
                            <Label Grid.Column="0" Text="Trạng thái máy chủ:" FontSize="12" TextColor="#C7D2FE" VerticalOptions="Center" />
                            <Border Grid.Column="1" Padding="10,4" StrokeShape="RoundRectangle 8" BackgroundColor="#4F46E5" StrokeThickness="0">
                                <Label Text="{Binding ConnectionStatusText}" FontSize="11" FontAttributes="Bold" TextColor="#FFFFFF" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. BẢO MẬT SINH TRẮC HỌC (BIOMETRICS) -->
                <Border Style="{StaticResource FintechCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Image Source="ic_shield.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                <Label Text="BẢO MẬT SINH TRẮC HỌC" Style="{StaticResource FintechCardTitleStyle}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" Padding="8,3" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                <Label Text="Vân tay / Khuôn mặt" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource FintechIncome}" />
                            </Border>
                        </Grid>

                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Đăng nhập nhanh bằng Sinh trắc học" FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                                    <Label Text="Mở khóa app bằng vân tay hoặc nhận diện khuôn mặt" FontSize="11" TextColor="{StaticResource FintechTextMuted}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsBiometricQuickLoginEnabled}"
                                        IsEnabled="{Binding IsBiometricSupported}" OnColor="{StaticResource FintechPrimary}" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Label Text="{Binding BiometricHardwareStatusText}"
                               FontSize="11" FontAttributes="Italic" TextColor="{StaticResource FintechPrimary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. CẤU HÌNH KẾT NỐI MÁY CHỦ & ĐỒNG BỘ -->
                <Border Style="{StaticResource FintechCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="KẾT NỐI MÁY CHỦ &amp; API" Style="{StaticResource FintechCardTitleStyle}" />

                        <!-- LIVE API TOGGLE -->
                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                                StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Chế độ Trực tuyến (Live API Server)" FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                                    <Label Text="Tắt để chuyển sang chế độ Ngoại Tuyến (Offline Demo)" FontSize="11" TextColor="{StaticResource FintechTextMuted}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsLiveApiMode}" OnColor="{StaticResource FintechPrimary}" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- SERVER URL ENTRY -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Địa chỉ máy chủ (Base URL)" Style="{StaticResource FintechCaptionStyle}" />
                            <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                    Padding="14,4">
                                <Entry Text="{Binding ServerUrl}"
                                       Placeholder="http://10.0.2.2:5018 hoặc https://..."
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- PRESET BUTTONS -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Máy Ảo (10.0.2.2)"
                                    Command="{Binding UseLocalhostCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                    TextColor="{StaticResource FintechPrimary}"
                                    CornerRadius="10" HeightRequest="38" FontSize="12" FontAttributes="Bold" />

                            <Button Grid.Column="1" Text="Đường Hầm (Cloudflare)"
                                    Command="{Binding UseTunnelCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#FAF5FF, Dark=#3B0764}"
                                    TextColor="#9333EA"
                                    CornerRadius="10" HeightRequest="38" FontSize="12" FontAttributes="Bold" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Lưu Địa Chỉ"
                                    Command="{Binding SaveServerUrlCommand}"
                                    Style="{StaticResource FintechPrimaryBtnStyle}"
                                    HeightRequest="44" />

                            <Button Grid.Column="1" Text="Kiểm Tra Kết Nối"
                                    Command="{Binding PingServerCommand}"
                                    BackgroundColor="{StaticResource FintechIncome}" TextColor="#FFFFFF"
                                    CornerRadius="12" HeightRequest="44" FontAttributes="Bold" />
                        </Grid>

                        <Label Text="{Binding PingResult}"
                               IsVisible="{Binding PingResult, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                               FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               TextColor="{StaticResource FintechIncome}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 4. KHU VỰC THỬ NGHIỆM HỆ THỐNG -->
                <Border Style="{StaticResource FintechCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="CÔNG CỤ KIỂM THỬ HỆ THỐNG" Style="{StaticResource FintechCardTitleStyle}" />

                        <Button Text="🔔 Mô Phỏng Thông Báo Biến Động Số Dư"
                                Command="{Binding SimulateBankNotificationCommand}"
                                BackgroundColor="#8B5CF6" TextColor="#FFFFFF"
                                CornerRadius="12" HeightRequest="44" FontAttributes="Bold" />

                        <Label Text="{Binding SimulationStatus}"
                               IsVisible="{Binding SimulationStatus, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                               FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#8B5CF6" />

                        <Button Text="⏰ Hẹn Giờ Thông Báo Ngầm (10 Giây)"
                                Command="{Binding ScheduleTestReminderCommand}"
                                BackgroundColor="#F59E0B" TextColor="#FFFFFF"
                                CornerRadius="12" HeightRequest="44" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- 5. VÙNG NGUY HIỂM: ĐĂNG XUẤT TÀI KHOẢN -->
                <Border Stroke="{StaticResource FintechExpense}" StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                        StrokeShape="RoundRectangle 16" Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="VÙNG QUẢN TRỊ TÀI KHOẢN" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource FintechExpense}" />
                        <Label Text="Đăng xuất sẽ xóa sạch phiên làm việc trên thiết bị này và yêu cầu đăng nhập lại bằng mật khẩu."
                               FontSize="12" TextColor="{AppThemeBinding Light=#7F1D1D, Dark=#FCA5A5}" />

                        <Button Text="Đăng Xuất Khỏi Thiết Bị"
                                Command="{Binding LogoutCommand}"
                                BackgroundColor="{StaticResource FintechExpense}" TextColor="#FFFFFF"
                                CornerRadius="12" HeightRequest="46" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DUY NHẤT 1 THANH BOTTOM BAR BỒNG BỀNH -->
        <components:BottomNavDockView Grid.Row="1" ActiveTab="Home" />
    </Grid>
</ContentPage>