<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.SavingsGoals"
             x:Class="ExpenseTracker.Maui.Views.SavingsGoalsPage"
             x:DataType="vm:SavingsGoalsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Error Banner -->
            <Border IsVisible="{Binding HasError}"
                    Stroke="#FCA5A5"
                    BackgroundColor="#FEF2F2"
                    Padding="12"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#DC2626"
                       FontAttributes="Bold"
                       FontSize="13" />
            </Border>

            <!-- Success / Info Status Banner -->
            <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                    Stroke="#A7F3D0"
                    BackgroundColor="#ECFDF5"
                    Padding="12"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding StatusMessage}"
                       TextColor="#059669"
                       FontAttributes="Bold"
                       FontSize="13" />
            </Border>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#2563EB" />

            <!-- TOP ACTION BAR: New Goal & Refresh Buttons -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="+ Mục Tiêu Tích Lũy Mới"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Command="{Binding NavigateToCreateGoalCommand}" />

                <Button Grid.Column="1"
                        Text="Tải lại"
                        BackgroundColor="#E5E7EB"
                        TextColor="#374151"
                        CornerRadius="8"
                        Command="{Binding LoadGoalsAndJarsCommand}" />
            </Grid>

            <!-- HERO CARD: Total Savings Balance Overview -->
            <Border Stroke="#3B82F6"
                    BackgroundColor="#1E3A8A"
                    Padding="20"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="TỔNG TÀI SẢN TÍCH LŨY"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#93C5FD" />
                        <Label Grid.Column="1"
                               Text="🐷 Heo đất thông minh"
                               FontSize="12"
                               TextColor="#BFDBFE" />
                    </Grid>

                    <Label Text="{Binding TotalSavingsBalance, StringFormat='{0:N0} đ'}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <BoxView HeightRequest="1" Color="#3B82F6" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Đang thực hiện"
                                   FontSize="11"
                                   TextColor="#BFDBFE" />
                            <Label Text="{Binding ActiveGoalsCount, StringFormat='{0} mục tiêu'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Đã hoàn thành"
                                   FontSize="11"
                                   TextColor="#BFDBFE" />
                            <Label Text="{Binding CompletedGoalsCount, StringFormat='{0} mục tiêu'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#34D399" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- KAKEIBO JARS WIDGET SECTION -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="🏺 Hũ Tài Chính Kakeibo (4 Hũ Cốt Lõi)"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />
                    <Label Grid.Column="1"
                           Text="Tỷ lệ khuyến nghị"
                           FontSize="11"
                           TextColor="#64748B" />
                </Grid>

                <CollectionView ItemsSource="{Binding Jars}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:JarItemModel">
                            <Border Stroke="#E2E8F0"
                                    BackgroundColor="#F8FAFC"
                                    Padding="12"
                                    StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{Binding ColorHex}" />
                                    <Label Text="{Binding FormattedTotalAmount}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="{Binding FormattedPercentages}"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                    <ProgressBar Progress="{Binding ActualPercentage, Converter={StaticResource InvertedBoolConverter}}"
                                                 ProgressColor="{Binding ColorHex}"
                                                 HeightRequest="4" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- SAVINGS GOALS LIST SECTION -->
            <VerticalStackLayout Spacing="10">
                <Label Text="🎯 Danh Sách Mục Tiêu Tích Lũy"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#1E293B" />

                <!-- Empty State -->
                <Border IsVisible="{Binding Goals.Count, Converter={StaticResource InvertedBoolConverter}}"
                        Stroke="#CBD5E1"
                        BackgroundColor="#F8FAFC"
                        Padding="24"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="🌱 Chưa có mục tiêu tích lũy nào"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#475569"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Hãy đặt ra mục tiêu đầu tiên (ví dụ: Quỹ khẩn cấp 3 tháng lương, Mua xe mới, Du lịch...) để bắt đầu hành trình tự do tài chính!"
                               FontSize="13"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Goal Items -->
                <CollectionView ItemsSource="{Binding Goals}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SavingsGoalSummaryModel">
                            <Border Stroke="#E2E8F0"
                                    BackgroundColor="White"
                                    Margin="0,0,0,12"
                                    Padding="16"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="10">
                                    
                                    <!-- Header: Name, Badge Emergency / Type -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#1E293B" />
                                            <Label Text="{Binding TargetDate, StringFormat='Hạn chót: {0:dd/MM/yyyy}'}"
                                                   FontSize="12"
                                                   TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                Stroke="{Binding ColorHex}"
                                                BackgroundColor="{Binding ColorHex}"
                                                Padding="8,4"
                                                StrokeShape="RoundRectangle 6">
                                            <Label Text="{Binding FormattedProgressPercent}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="White" />
                                        </Border>
                                    </Grid>

                                    <!-- Progress Bar -->
                                    <ProgressBar Progress="{Binding NormalizedProgress}"
                                                 ProgressColor="{Binding ColorHex}"
                                                 HeightRequest="8" />

                                    <!-- Amounts: Current vs Target -->
                                    <Grid ColumnDefinitions="*,*">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="Hiện có"
                                                   FontSize="11"
                                                   TextColor="#64748B" />
                                            <Label Text="{Binding FormattedCurrentAmount}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#059669" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                            <Label Text="Mục tiêu"
                                                   FontSize="11"
                                                   TextColor="#64748B"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding FormattedTargetAmount}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#1E293B"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Monthly Required Info Pill -->
                                    <Border BackgroundColor="#F1F5F9"
                                            Stroke="#CBD5E1"
                                            Padding="10,6"
                                            StrokeShape="RoundRectangle 6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="Cần nạp mỗi tháng dự kiến:"
                                                   FontSize="12"
                                                   TextColor="#475569" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding MonthlyDepositRequired, StringFormat='{0:N0} đ/tháng'}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#2563EB" />
                                        </Grid>
                                    </Border>

                                    <!-- Actions: Deposit, Withdraw (Thaler Nudge), Feasibility, Delete -->
                                    <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="6" Margin="0,4,0,0">
                                        <Button Grid.Column="0"
                                                Text="Nạp tiền"
                                                BackgroundColor="#10B981"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                HeightRequest="36"
                                                CornerRadius="6"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SavingsGoalsViewModel}}, Path=DepositToGoalCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Grid.Column="1"
                                                Text="Rút tiền"
                                                BackgroundColor="#F59E0B"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                HeightRequest="36"
                                                CornerRadius="6"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SavingsGoalsViewModel}}, Path=WithdrawFromGoalCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Grid.Column="2"
                                                Text="💡 Khả thi"
                                                BackgroundColor="#E0E7FF"
                                                TextColor="#4338CA"
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                HeightRequest="36"
                                                CornerRadius="6"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SavingsGoalsViewModel}}, Path=CheckFeasibilityCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Grid.Column="3"
                                                Text="🗑️"
                                                BackgroundColor="#FEE2E2"
                                                TextColor="#DC2626"
                                                FontSize="12"
                                                HeightRequest="36"
                                                WidthRequest="36"
                                                CornerRadius="6"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SavingsGoalsViewModel}}, Path=DeleteGoalCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
