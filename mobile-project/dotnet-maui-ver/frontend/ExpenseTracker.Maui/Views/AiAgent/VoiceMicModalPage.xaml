<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels.AiAgent"
             x:Class="ExpenseTracker.Maui.Views.AiAgent.VoiceMicModalPage"
             x:DataType="vm:VoiceFloatingMicViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=#070B14}">

    <ScrollView>
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" Padding="20" MaximumWidthRequest="560" HorizontalOptions="Center">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,14">
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Image Source="ic_mic.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                    <Label Text="Trợ Lý Giọng Nói Tài Chính" TextColor="#38BDF8" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button Grid.Column="1" Text="Đóng"
                        Clicked="OnCloseClicked"
                        BackgroundColor="#1E293B"
                        TextColor="#94A3B8"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="36"
                        Padding="14,0"
                        CornerRadius="10" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Margin="0,8">
                <Border WidthRequest="110" HeightRequest="110"
                        Stroke="#38BDF8" StrokeThickness="2"
                        StrokeShape="RoundRectangle 55"
                        Padding="0" HorizontalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0284C7" Offset="0.0" />
                            <GradientStop Color="#4F46E5" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Image Source="ic_mic.svg" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="{Binding FeedbackMessage}"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="#E0F2FE"
                       HorizontalTextAlignment="Center"
                       Margin="12,0"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Border Grid.Row="2" Margin="0,10,0,16" Padding="16"
                    BackgroundColor="#1E293B"
                    Stroke="#334155" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nội dung khẩu lệnh đã nhận diện:" FontSize="11" TextColor="#94A3B8" FontAttributes="Bold" />
                    <Label Text="{Binding Transcript, FallbackValue='(Chạm BẮT ĐẦU NÓI hoặc nhập lệnh bên dưới...)'}"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="#F8FAFC"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,0,0,16">
                <Button Grid.Column="0" Text="BẮT ĐẦU NÓI"
                        Command="{Binding StartListeningCommand}"
                        BackgroundColor="#0284C7"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="48"
                        CornerRadius="14" />

                <Button Grid.Column="1" Text="DỪNG LẠI"
                        Command="{Binding StopListeningCommand}"
                        BackgroundColor="#E11D48"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="48"
                        CornerRadius="14" />
            </Grid>

            <Border Grid.Row="4" Margin="0,0,0,16" Padding="14,12"
                    BackgroundColor="#1E293B"
                    Stroke="#334155" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Entry Grid.Column="0"
                           Placeholder="Hoặc gõ khẩu lệnh (VD: Trả nợ thẻ 2 triệu)..."
                           PlaceholderColor="#64748B"
                           Text="{Binding DirectTextInput}"
                           TextColor="#F8FAFC"
                           FontSize="13"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="Gửi"
                            Command="{Binding SendDirectTextInputCommand}"
                            BackgroundColor="#10B981"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="38"
                            Padding="14,0"
                            CornerRadius="10"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="5" Margin="0,0,0,12" Padding="14"
                    StrokeThickness="1" Stroke="#334155" StrokeShape="RoundRectangle 16"
                    BackgroundColor="#1E293B">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="#F59E0B" VerticalOptions="Center" />
                        <Label Text="KHẨU LỆNH MẪU (CHẠM ĐỂ THỬ)" FontSize="11" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <Button Text="Chi 50k ăn trưa Highland"
                                Command="{Binding ProcessTranscriptCommand}"
                                CommandParameter="Chi 50k ăn trưa Highland"
                                BackgroundColor="#0F172A"
                                TextColor="#F8FAFC"
                                BorderColor="#38BDF8"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="36"
                                Padding="12,0"
                                Margin="0,0,8,8" />

                        <Button Text="Trả nợ 2 triệu thẻ tín dụng"
                                Command="{Binding ProcessTranscriptCommand}"
                                CommandParameter="Trả nợ 2 triệu thẻ tín dụng"
                                BackgroundColor="#0F172A"
                                TextColor="#F8FAFC"
                                BorderColor="#38BDF8"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="36"
                                Padding="12,0"
                                Margin="0,0,8,8" />

                        <Button Text="Xem quỹ khẩn cấp"
                                Command="{Binding ProcessTranscriptCommand}"
                                CommandParameter="Xem quỹ khẩn cấp"
                                BackgroundColor="#0F172A"
                                TextColor="#F8FAFC"
                                BorderColor="#A855F7"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="36"
                                Padding="12,0"
                                Margin="0,0,8,8" />

                        <Button Text="Quét bẫy thuê bao định kỳ"
                                Command="{Binding ProcessTranscriptCommand}"
                                CommandParameter="Quét bẫy thuê bao"
                                BackgroundColor="#0F172A"
                                TextColor="#F8FAFC"
                                BorderColor="#F59E0B"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="36"
                                Padding="12,0"
                                Margin="0,0,8,8" />

                        <Button Text="Mô phỏng mua xe 30 triệu"
                                Command="{Binding ProcessTranscriptCommand}"
                                CommandParameter="Mô phỏng mua xe máy 30 triệu"
                                BackgroundColor="#0F172A"
                                TextColor="#F8FAFC"
                                BorderColor="#10B981"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="36"
                                Padding="12,0"
                                Margin="0,0,8,8" />

                        <Button Text="Quét hóa đơn mua sắm"
                                Command="{Binding ProcessTranscriptCommand}"
                                CommandParameter="Quét hóa đơn mua sắm"
                                BackgroundColor="#0F172A"
                                TextColor="#F8FAFC"
                                BorderColor="#EC4899"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="36"
                                Padding="12,0"
                                Margin="0,0,8,8" />

                        <Button Text="Xem báo cáo tài chính"
                                Command="{Binding ProcessTranscriptCommand}"
                                CommandParameter="Xem báo cáo tài chính"
                                BackgroundColor="#0F172A"
                                TextColor="#F8FAFC"
                                BorderColor="#818CF8"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="18"
                                HeightRequest="36"
                                Padding="12,0"
                                Margin="0,0,8,8" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>

</ContentPage>