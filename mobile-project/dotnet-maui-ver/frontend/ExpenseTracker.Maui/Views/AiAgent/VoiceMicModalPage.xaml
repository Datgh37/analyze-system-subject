<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels.AiAgent"
             x:Class="ExpenseTracker.Maui.Views.AiAgent.VoiceMicModalPage"
             x:DataType="vm:VoiceFloatingMicViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=#070B14}">

    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto, Auto" Padding="24" MaximumWidthRequest="560" HorizontalOptions="Center">

        <!-- 1. Close Button Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,8,0,16">
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                <Label Text="✨" FontSize="16" VerticalOptions="Center" />
                <Label Text="Trợ Lý Giọng Nói AI" TextColor="#38BDF8" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Grid.Column="1" Text="✕ Đóng"
                    Clicked="OnCloseClicked"
                    BackgroundColor="#1E293B"
                    TextColor="#94A3B8"
                    FontAttributes="Bold"
                    FontSize="12"
                    HeightRequest="36"
                    Padding="14,0"
                    CornerRadius="10" />
        </Grid>

        <!-- 2. Animated Mic Circle & Visual Pulse Ring -->
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
            <!-- Pulsing Mic Visual Ring -->
            <Border WidthRequest="130" HeightRequest="130"
                    Stroke="#38BDF8" StrokeThickness="2"
                    StrokeShape="RoundRectangle 65"
                    Padding="0" HorizontalOptions="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0284C7" Offset="0.0" />
                        <GradientStop Color="#4F46E5" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#38BDF8" Offset="0,0" Radius="28" Opacity="0.4" />
                </Border.Shadow>

                <Label Text="🎙️" FontSize="52" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Dynamic Feedback / Assistant Prompt -->
            <Label Text="{Binding FeedbackMessage}"
                   FontSize="15" FontAttributes="Bold"
                   TextColor="#E0F2FE"
                   HorizontalTextAlignment="Center"
                   Margin="16,0"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <!-- 3. Recognized Transcript Box -->
        <Border Grid.Row="2" Margin="0,16,0,20" Padding="18"
                BackgroundColor="#1E293B"
                Stroke="#334155" StrokeThickness="1"
                StrokeShape="RoundRectangle 16">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.3" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="6">
                <Label Text="Nội dung đã nhận diện:" FontSize="11" TextColor="#94A3B8" FontAttributes="Bold" />
                <Label Text="{Binding Transcript, FallbackValue='(Chưa có giọng nói...)'}"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="#F8FAFC"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>

        <!-- 4. Microphone Action Controls -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,0,0,20">
            <Button Grid.Column="0" Text="🎙️ NÓI"
                    Command="{Binding StartListeningCommand}"
                    BackgroundColor="#0284C7"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="52"
                    CornerRadius="16">
                <Button.Shadow>
                    <Shadow Brush="#0284C7" Offset="0,4" Radius="10" Opacity="0.3" />
                </Button.Shadow>
            </Button>

            <Button Grid.Column="1" Text="⏹️ DỪNG"
                    Command="{Binding StopListeningCommand}"
                    BackgroundColor="#E11D48"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="52"
                    CornerRadius="16">
                <Button.Shadow>
                    <Shadow Brush="#E11D48" Offset="0,4" Radius="10" Opacity="0.3" />
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- 5. Sample Voice Prompts Pill Bar -->
        <Border Grid.Row="4" Margin="0,0,0,8" Padding="14,10"
                StrokeThickness="0" StrokeShape="RoundRectangle 12"
                BackgroundColor="#1E293B">
            <VerticalStackLayout Spacing="4">
                <Label Text="💡 Gợi ý câu lệnh mẫu:" FontSize="11" FontAttributes="Bold" TextColor="#38BDF8" />
                <Label Text="• &quot;Tiêu 45k cà phê Highland&quot; (Tự ghi nhận chi tiêu)&#x0a;• &quot;Tạo danh mục Nuôi mèo&quot; (Mở form danh mục)&#x0a;• &quot;Xem báo cáo tháng này&quot; (Mở trang phân tích)"
                       FontSize="11" TextColor="#94A3B8" LineHeight="1.3" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
