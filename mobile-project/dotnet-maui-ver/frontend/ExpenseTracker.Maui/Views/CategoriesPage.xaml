<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Categories"
             x:Class="ExpenseTracker.Maui.Views.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Title Header -->
            <Label Text="Cây Danh Mục Thu / Chi (Wireframe)" FontSize="20" FontAttributes="Bold" />

            <!-- Error Banner -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding HasError}" />

            <!-- Dual-type Filter Tabs (UC-04.02 Basic Flow 3) -->
            <HorizontalStackLayout Spacing="8">
                <Button Text="Thu Nhập"
                        Command="{Binding SwitchTypeFilterCommand}"
                        CommandParameter="1" />
                <Button Text="Chi Tiêu"
                        Command="{Binding SwitchTypeFilterCommand}"
                        CommandParameter="2" />
            </HorizontalStackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <!-- Add Category Wireframe Form (UC-04.01 & UC-04.05) -->
            <Border Stroke="Gray" Padding="14" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Thêm Danh Mục Mới" FontAttributes="Bold" FontSize="16" />
                    
                    <Label Text="Tên danh mục:" FontSize="13" />
                    <Entry Placeholder="Ví dụ: Cà phê, Lương cứng..."
                           Text="{Binding NewCategoryName}" />

                    <Label Text="Danh mục cha (Tùy chọn - Cây phân cấp):" FontSize="13" />
                    <Picker Title="-- Không có (Danh mục gốc cấp 1) --"
                            ItemsSource="{Binding AvailableParentCategories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedParentCategory}" />

                    <Button Text="+ Lưu Danh Mục"
                            Command="{Binding CreateCategoryCommand}"
                            Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Hierarchical Tree Rendering (UC-04.02 Basic Flow 4) -->
            <Label Text="Cấu Trúc Cây Phân Nhánh (Cha - Con)" FontAttributes="Bold" Margin="0,8,0,0" />

            <CollectionView ItemsSource="{Binding Categories}">
                <CollectionView.EmptyView>
                    <Label Text="Chưa có danh mục nào trong nhóm này."
                           HorizontalOptions="Center"
                           Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryModel">
                        <Border Stroke="Gray" Padding="12" Margin="0,6" StrokeShape="RoundRectangle 6">
                            <VerticalStackLayout Spacing="8">

                                <!-- Root Category Level 1 -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Name, StringFormat='📁 {0}'}" FontAttributes="Bold" FontSize="16" />
                                        <Label Text="{Binding IsSystem, StringFormat='Loại: {0}'}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="2"
                                            Text="Xóa"
                                            TextColor="Red"
                                            IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBoolConverter}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                                <!-- Child Branches Level 2 (Subcategories Indented) -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SubCategories}"
                                                     Spacing="4"
                                                     Margin="20,4,0,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CategoryModel">
                                            <Border Stroke="LightGray" Padding="8" StrokeShape="RoundRectangle 4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Name, StringFormat='└─ 📄 {0}'}"
                                                           FontSize="14" />
                                                    <Button Grid.Column="1"
                                                            Text="Xóa"
                                                            TextColor="Red"
                                                            FontSize="11"
                                                            IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBoolConverter}}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
