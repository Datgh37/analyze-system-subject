<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Categories"
             xmlns:components="clr-namespace:ExpenseTracker.Maui.Views.Components"
             x:Class="ExpenseTracker.Maui.Views.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12,16,28" Spacing="16" MaximumWidthRequest="640">

                <!-- 1. HERO CARD: CÂY PHÂN CẤP DANH MỤC THU CHI -->
                <Border Stroke="{AppThemeBinding Light=#4338CA, Dark=#6366F1}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 24"
                        Padding="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0.0" />
                            <GradientStop Color="#1E1B4B" Offset="0.5" />
                            <GradientStop Color="#312E81" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#312E81" Offset="0,6" Radius="20" Opacity="0.35" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Image Source="ic_category.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                <Label Text="CƠ CẤU DANH MỤC THU CHI" FontSize="11" FontAttributes="Bold" TextColor="#A5B4FC" CharacterSpacing="1" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#4338CA" Padding="8,3" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                <Label Text="PHÂN CẤP 2 TẦNG" FontSize="10" FontAttributes="Bold" TextColor="#E0E7FF" />
                            </Border>
                        </Grid>

                        <Label Text="Phân Loại Dòng Tiền Đa Chiều" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />
                        <Label Text="Tổ chức danh mục Thu &amp; Chi thành cấu trúc phân nhánh Cha - Con, giúp quản lý chi tiêu và ngân sách chính xác đến từng đồng."
                               FontSize="12" TextColor="#C7D2FE" />
                    </VerticalStackLayout>
                </Border>

                <!-- THÔNG BÁO LỖI (NẾU CÓ) -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                        Stroke="#FECACA" StrokeShape="RoundRectangle 12" Padding="14,10">
                    <HorizontalStackLayout Spacing="10">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- 2. NÚT CHUYỂN TAB THU / CHI HIỆN ĐẠI -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="Danh Mục Thu Nhập"
                            Command="{Binding SwitchTypeFilterCommand}"
                            CommandParameter="1"
                            BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                            TextColor="{StaticResource FintechIncome}"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="14"
                            HeightRequest="46" />

                    <Button Grid.Column="1"
                            Text="Danh Mục Chi Tiêu"
                            Command="{Binding SwitchTypeFilterCommand}"
                            CommandParameter="2"
                            BackgroundColor="{AppThemeBinding Light=#FFF1F2, Dark=#4C0519}"
                            TextColor="{StaticResource FintechExpense}"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="14"
                            HeightRequest="46" />
                </Grid>

                <!-- 3. FORM THÊM DANH MỤC MỚI -->
                <Border Style="{StaticResource FintechCardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="THÊM DANH MỤC MỚI" Style="{StaticResource FintechCardTitleStyle}" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Tên danh mục (*)" Style="{StaticResource FintechCaptionStyle}" />
                            <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                    Padding="14,4">
                                <Entry Placeholder="Ví dụ: Cà phê, Lương cứng, Du lịch..."
                                       Text="{Binding NewCategoryName}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Danh mục cha (Tùy chọn - Phân nhánh)" Style="{StaticResource FintechCaptionStyle}" />
                            <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                    Padding="10,2">
                                <Picker Title="-- Không có (Danh mục gốc cấp 1) --"
                                        ItemsSource="{Binding AvailableParentCategories}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedParentCategory}"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="+ Lưu Danh Mục Mới"
                                Command="{Binding CreateCategoryCommand}"
                                Style="{StaticResource FintechPrimaryBtnStyle}"
                                HeightRequest="48"
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- 4. DANH SÁCH DANH MỤC PHÂN NHÁNH -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,6,2,0" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="CẤU TRÚC PHÂN CẤP DANH MỤC" Style="{StaticResource FintechSectionTitleStyle}" />
                    <Label Grid.Column="1" Text="Theo loại" FontSize="11" TextColor="{StaticResource FintechTextMuted}" VerticalOptions="Center" />
                </Grid>

                <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border Style="{StaticResource FintechCardStyle}" Padding="24">
                            <Label Text="Chưa có danh mục nào trong nhóm này."
                                   HorizontalOptions="Center"
                                   Style="{StaticResource FintechCaptionStyle}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryModel">
                            <Border Style="{StaticResource FintechCardStyle}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   Style="{StaticResource FintechCardTitleStyle}" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Border IsVisible="{Binding IsSystem}"
                                                        BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                                        Padding="8,2" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                                    <Label Text="Hệ thống mặc định" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource FintechPrimary}" />
                                                </Border>
                                                <Border IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBoolConverter}}"
                                                        BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                                                        Padding="8,2" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                                    <Label Text="Người dùng tạo" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource FintechIncome}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="Xóa"
                                                TextColor="#EF4444"
                                                BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#450A0A}"
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                HeightRequest="32"
                                                CornerRadius="8"
                                                IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBoolConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <!-- DANH MỤC CON (SUB-CATEGORIES) -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SubCategories}"
                                                         Spacing="6" Margin="14,4,0,0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:CategoryModel">
                                                <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                                        Padding="12,8" StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}">
                                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding Name, StringFormat='↳ {0}'}"
                                                               FontSize="13"
                                                               TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                                               VerticalOptions="Center" />
                                                        <Button Grid.Column="1"
                                                                Text="Xóa"
                                                                TextColor="#EF4444"
                                                                BackgroundColor="Transparent"
                                                                FontSize="11"
                                                                FontAttributes="Bold"
                                                                HeightRequest="28"
                                                                IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBoolConverter}}"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                                                CommandParameter="{Binding .}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DUY NHẤT 1 THANH BOTTOM BAR BỒNG BỀNH -->
        <components:BottomNavDockView Grid.Row="1" ActiveTab="Home" />
    </Grid>
</ContentPage>