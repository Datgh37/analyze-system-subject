<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Categories"
             x:Class="ExpenseTracker.Maui.Views.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="18" MaximumWidthRequest="720">

            <!-- ========================================== -->
            <!-- 1. HERO BANNER: CATEGORY TREE              -->
            <!-- ========================================== -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="22"
                    Shadow="{Shadow Brush='#4F46E5', Offset='0,10', Radius=20, Opacity=0.25}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E1B4B" Offset="0.0" />
                        <GradientStop Color="#312E81" Offset="0.5" />
                        <GradientStop Color="#4338CA" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="🗂️" FontSize="18" VerticalOptions="Center" />
                            <Label Text="HIERARCHICAL TAXONOMY"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#A5B4FC"
                                   CharacterSpacing="1.2"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#3730A3"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent">
                            <Label Text="TAXONOMY"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#E0E7FF" />
                        </Border>
                    </Grid>

                    <Label Text="Cây Phân Cấp Danh Mục"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />

                    <Label Text="Tổ chức danh mục Thu &amp; Chi thành cấu trúc cây 2 cấp (Cha - Con), hỗ trợ phân rã chi tiêu vi mô và đối soát dòng tiền chính xác."
                           FontSize="12"
                           TextColor="#C7D2FE"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- Error Banner -->
            <Border IsVisible="{Binding HasError}"
                    BackgroundColor="#FEF2F2"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="❌" FontSize="14" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#B91C1C"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Dual-type Filter Tabs -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Danh Mục Thu Nhập"
                        Command="{Binding SwitchTypeFilterCommand}"
                        CommandParameter="1"
                        BackgroundColor="{AppThemeBinding Light='#ECFDF5', Dark='#064E3B'}"
                        TextColor="#059669"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="10"
                        HeightRequest="42" />

                <Button Grid.Column="1"
                        Text="Danh Mục Chi Tiêu"
                        Command="{Binding SwitchTypeFilterCommand}"
                        CommandParameter="2"
                        BackgroundColor="{AppThemeBinding Light='#FFF1F2', Dark='#4C0519'}"
                        TextColor="#E11D48"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="10"
                        HeightRequest="42" />
            </Grid>

            <!-- Loading Indicator -->
            <Border Style="{StaticResource ModernCard}"
                    Padding="14"
                    IsVisible="{Binding IsBusy}">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#4F46E5" />
                    <Label Text="Đang cập nhật danh mục..."
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#4F46E5"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- ========================================== -->
            <!-- 2. ADD CATEGORY FORM                       -->
            <!-- ========================================== -->
            <Border Style="{StaticResource ModernCard}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Thêm Danh Mục Mới"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" />
                    
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tên danh mục (*):" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,2"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Entry Placeholder="Ví dụ: Cà phê, Lương cứng, Du lịch..."
                                   Text="{Binding NewCategoryName}"
                                   FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Danh mục cha (Tùy chọn - Cây phân cấp):" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,0"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Picker Title="-- Không có (Danh mục gốc cấp 1) --"
                                    ItemsSource="{Binding AvailableParentCategories}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedParentCategory}"
                                    FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="+ Lưu Danh Mục"
                            Command="{Binding CreateCategoryCommand}"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="10"
                            HeightRequest="44"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- ========================================== -->
            <!-- 3. HIERARCHICAL TREE RENDERING             -->
            <!-- ========================================== -->
            <Label Text="Cấu Trúc Cây Phân Nhánh (Cha - Con)"
                   FontAttributes="Bold"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}"
                   Margin="0,6,0,0" />

            <CollectionView ItemsSource="{Binding Categories}">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource ModernCard}" Padding="20">
                        <Label Text="Chưa có danh mục nào trong nhóm này."
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryModel">
                        <Border Style="{StaticResource ModernCard}"
                                Padding="14"
                                Margin="0,4">
                            <VerticalStackLayout Spacing="8">

                                <!-- Root Category Level 1 -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Name, StringFormat='📁 {0}'}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" />
                                        <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                            <Border IsVisible="{Binding IsSystem}"
                                                    BackgroundColor="{AppThemeBinding Light='#EEF2FF', Dark='#1E1B4B'}"
                                                    Stroke="{AppThemeBinding Light='#C7D2FE', Dark='#3730A3'}"
                                                    StrokeThickness="1"
                                                    Padding="6,2"
                                                    StrokeShape="RoundRectangle 6"
                                                    HorizontalOptions="Start">
                                                <Label Text="🔒 Mặc định hệ thống"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light='#4338CA', Dark='#A5B4FC'}" />
                                            </Border>
                                            <Border IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBoolConverter}}"
                                                    BackgroundColor="{AppThemeBinding Light='#F0FDF4', Dark='#052E16'}"
                                                    Stroke="{AppThemeBinding Light='#BBF7D0', Dark='#14532D'}"
                                                    StrokeThickness="1"
                                                    Padding="6,2"
                                                    StrokeShape="RoundRectangle 6"
                                                    HorizontalOptions="Start">
                                                <Label Text="👤 Tùy chỉnh cá nhân"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light='#15803D', Dark='#86EFAC'}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="Xóa"
                                            TextColor="#EF4444"
                                            BackgroundColor="{AppThemeBinding Light='#FEE2E2', Dark='#450A0A'}"
                                            FontAttributes="Bold"
                                            FontSize="11"
                                            HeightRequest="32"
                                            CornerRadius="6"
                                            IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBoolConverter}}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                                <!-- Child Branches Level 2 (Subcategories Indented) -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SubCategories}"
                                                     Spacing="4"
                                                     Margin="16,4,0,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CategoryModel">
                                            <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                                    Padding="10,6"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light='#F1F5F9', Dark='#1E293B'}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Name, StringFormat='└─ 📄 {0}'}"
                                                           FontSize="13"
                                                           TextColor="{AppThemeBinding Light='#1E293B', Dark='#E2E8F0'}"
                                                           VerticalOptions="Center" />
                                                    <Button Grid.Column="1"
                                                            Text="Xóa"
                                                            TextColor="#EF4444"
                                                            BackgroundColor="Transparent"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            HeightRequest="28"
                                                            IsVisible="{Binding IsSystem, Converter={StaticResource InvertedBoolConverter}}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
