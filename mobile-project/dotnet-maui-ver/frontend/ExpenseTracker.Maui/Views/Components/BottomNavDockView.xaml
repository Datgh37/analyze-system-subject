<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseTracker.Maui.Views.Components.BottomNavDockView"
             x:Name="ThisNavDock">

    <!-- Root layout container allowing floating FAB to overflow dock border without clipping -->
    <Grid HeightRequest="80" VerticalOptions="End">

        <!-- 1. Dock Bar Background & Tabs Container -->
        <Border HeightRequest="66"
                VerticalOptions="End"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24,24,0,0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}"
                Padding="8,2,8,6"
                Margin="0">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Radius="16" Opacity="{AppThemeBinding Light=0.08, Dark=0.35}" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*, *, 64, *, *" VerticalOptions="Center">

                <!-- 1. TAB VÍ & TỔNG QUAN -->
                <Grid Grid.Column="0" HorizontalOptions="Fill" VerticalOptions="Fill" HeightRequest="60">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWalletsTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="ic_wallet.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                        <Label Text="Ví" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{Binding Source={x:Reference ThisNavDock}, Path=WalletsTabColor}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- 2. TAB CHI TIÊU & GIAO DỊCH -->
                <Grid Grid.Column="1" HorizontalOptions="Fill" VerticalOptions="Fill" HeightRequest="60">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExpensesTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="ic_expense.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                        <Label Text="Chi Tiêu" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{Binding Source={x:Reference ThisNavDock}, Path=ExpensesTabColor}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Column 2 left empty for center floating FAB overlay -->

                <!-- TAB NGÂN SÁCH -->
                <Grid Grid.Column="3" HorizontalOptions="Fill" VerticalOptions="Fill" HeightRequest="60">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBudgetsTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="ic_budget.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                        <Label Text="Ngân Sách" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{Binding Source={x:Reference ThisNavDock}, Path=BudgetsTabColor}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- 5. TAB BÁO CÁO TÀI CHÍNH -->
                <Grid Grid.Column="4" HorizontalOptions="Fill" VerticalOptions="Fill" HeightRequest="60">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReportsTapped" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="ic_reports.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                        <Label Text="Báo Cáo" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{Binding Source={x:Reference ThisNavDock}, Path=ReportsTabColor}" />
                    </VerticalStackLayout>
                </Grid>

            </Grid>
        </Border>

        <!-- 2. CENTER FLOATING MICROPHONE BUTTON (Full Circle, Elevated Cradle Ring) -->
        <Border WidthRequest="60" HeightRequest="60"
                StrokeShape="RoundRectangle 30"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}"
                HorizontalOptions="Center"
                VerticalOptions="Start">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#4F46E5, Dark=#38BDF8}" Offset="0,4" Radius="12" Opacity="{AppThemeBinding Light=0.25, Dark=0.4}" />
            </Border.Shadow>

            <Border WidthRequest="52" HeightRequest="52"
                    StrokeShape="RoundRectangle 26"
                    StrokeThickness="1.5"
                    Stroke="#38BDF8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0.0" />
                        <GradientStop Color="#0284C7" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVoiceMicTapped" />
                </Border.GestureRecognizers>

                <Image Source="ic_mic.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Border>

    </Grid>

</ContentView>
