<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Forecasting"
             x:Class="ExpenseTracker.Maui.Views.ForecastingPage"
             x:DataType="vm:ForecastingViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,36" Spacing="16" MaximumWidthRequest="640">

            <Border Style="{StaticResource FintechHeroCard}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Image Source="ic_forecast.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Text="RADAR RỦI RO"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#A5B4FC"
                                   CharacterSpacing="1.2"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#3730A3"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent">
                            <Label Text="DỰ BÁO DÒNG TIỀN"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#E0E7FF" />
                        </Border>
                    </Grid>

                    <Label Text="Dự Báo &amp; Thử Nghiệm Chi Tiêu"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />

                    <Label Text="Phân tích tốc độ tiêu tiền, dự báo nguy cơ thâm hụt trước ngày nhận lương và thử nghiệm các quyết định mua sắm lớn trước khi thực hiện."
                           FontSize="12"
                           TextColor="#C7D2FE"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0"
                       Text="{Binding StatusMessage, FallbackValue='Dữ liệu phân tích đã sẵn sàng'}"
                       Style="{StaticResource FintechLabelCaption}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        HeightRequest="42"
                        Padding="14,0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoadForecastDataCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Image Source="ic_refresh.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Text="Làm Mới"
                               Style="{StaticResource FintechLabelCaption}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10"
                    IsVisible="{Binding HasError}">
                <HorizontalStackLayout Spacing="10">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#B91C1C"
                           FontAttributes="Bold"
                           FontSize="13"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}"
                    Padding="14"
                    IsVisible="{Binding IsBusy}">
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryLight}" WidthRequest="20" HeightRequest="20" />
                    <Label Text="Đang phân tích dữ liệu dự báo..."
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryLight}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="1. Dự Báo Tổng Chi Cuối Kỳ" Style="{StaticResource FintechLabelSubtitle}" />
                        <Border Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                Padding="8,3"
                                StrokeShape="RoundRectangle 6"
                                Stroke="Transparent">
                            <Label Text="{Binding Forecast.RiskLevel, StringFormat='Rủi ro: {0}'}"
                                   FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryLight}" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding Forecast.EstimatedTotalSpent, StringFormat='{0:N0} đ'}"
                           FontSize="28" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Tốc độ ngày thường:" Style="{StaticResource FintechLabelCaption}" />
                            <Label Text="{Binding Forecast.WeekdayDailyVelocity, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Nguy cơ thâm hụt:" Style="{StaticResource FintechLabelCaption}" />
                            <Label Text="{Binding Forecast.ProjectedOverspendAmount, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#EF4444" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding Forecast.AdvisoryMessage}"
                           Style="{StaticResource FintechLabelCaption}"
                           FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="2. Khảo Sát Thử Nghiệm Mua Sắm" Style="{StaticResource FintechLabelSubtitle}" />
                        <Border Grid.Column="1"
                                BackgroundColor="#DCFCE7"
                                Padding="8,3"
                                StrokeShape="RoundRectangle 6"
                                Stroke="Transparent">
                            <Label Text="Thử nghiệm 0ms" FontSize="10" FontAttributes="Bold" TextColor="#15803D" />
                        </Border>
                    </Grid>

                    <Label Text="Chọn kịch bản bạn muốn thử nghiệm:" Style="{StaticResource FintechLabelCaption}" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Text="Mua Sắm" Command="{Binding SelectScenarioCommand}" CommandParameter="LumpSum"
                                Style="{StaticResource FintechButtonSecondary}" FontSize="10" HeightRequest="36" Padding="2,0" />
                        <Button Grid.Column="1" Text="Trả Góp" Command="{Binding SelectScenarioCommand}" CommandParameter="Installment"
                                Style="{StaticResource FintechButtonSecondary}" FontSize="10" HeightRequest="36" Padding="2,0" />
                        <Button Grid.Column="2" Text="Giảm Thu" Command="{Binding SelectScenarioCommand}" CommandParameter="IncomeReduction"
                                Style="{StaticResource FintechButtonSecondary}" FontSize="10" HeightRequest="36" Padding="2,0" />
                        <Button Grid.Column="3" Text="Biến Cố" Command="{Binding SelectScenarioCommand}" CommandParameter="EmergencyShock"
                                Style="{StaticResource FintechButtonSecondary}" FontSize="10" HeightRequest="36" Padding="2,0" />
                    </Grid>

                    <VerticalStackLayout Spacing="6" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Số tiền dự kiến chi:" Style="{StaticResource FintechLabelCaption}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding LumpSumAmount, StringFormat='{0:N0} đ'}"
                                   FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryLight}" />
                        </Grid>

                        <Slider Minimum="1000000" Maximum="20000000" Value="{Binding LumpSumAmount}"
                                MinimumTrackColor="{StaticResource PrimaryLight}"
                                MaximumTrackColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                ThumbColor="{StaticResource PrimaryLight}" />

                        <Button Text="Chạy Thử Nghiệm Tác Động"
                                Command="{Binding RunWhatIfSimulationCommand}"
                                Style="{StaticResource FintechButtonPrimary}"
                                HeightRequest="44"
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                            Padding="14"
                            Margin="0,6,0,0">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding WhatIfResult.ScenarioDescription, FallbackValue='Kết quả đối chiếu Trước vs Sau khi chi'}"
                                   Style="{StaticResource FintechLabelBody}" FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Grid.Column="0" Padding="8" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Hạn Mức Ngày" Style="{StaticResource FintechLabelCaption}" FontSize="10" />
                                        <Label Text="{Binding WhatIfResult.DsaAfter, StringFormat='→ {0:N0} đ'}"
                                               FontSize="11" FontAttributes="Bold" TextColor="#EF4444" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1" Padding="8" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Tỷ Lệ Nợ/Thu" Style="{StaticResource FintechLabelCaption}" FontSize="10" />
                                        <Label Text="{Binding WhatIfResult.DtiAfter, StringFormat='→ {0}%'}"
                                               FontSize="11" FontAttributes="Bold" TextColor="#F59E0B" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="2" Padding="8" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Tài Sản Ròng" Style="{StaticResource FintechLabelCaption}" FontSize="10" />
                                        <Label Text="{Binding WhatIfResult.NetWorthAfter, StringFormat='→ {0:N0} đ'}"
                                               FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryLight}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Border BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                    Padding="10" StrokeShape="RoundRectangle 8" Stroke="Transparent">
                                <Label Text="{Binding WhatIfResult.ImpactSummaryMessage}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark=#A5B4FC}" />
                            </Border>

                            <Border BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                                    Stroke="#A7F3D0" StrokeShape="RoundRectangle 10" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Lời khuyên: Hãy lập mục tiêu tích lũy thay vì chi tiêu ngay!"
                                           FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#065F46, Dark=#6EE7B7}" />
                                    <Button Text="Chuyển Thành Mục Tiêu Tích Lũy"
                                            Command="{Binding ConvertToSavingsGoalCommand}"
                                            Style="{StaticResource FintechButtonSecondary}"
                                            HeightRequest="36" FontSize="11" />
                                    <Label Text="{Binding ConversionFeedbackMessage}"
                                           FontSize="11" TextColor="{AppThemeBinding Light=#047857, Dark=#A7F3D0}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>