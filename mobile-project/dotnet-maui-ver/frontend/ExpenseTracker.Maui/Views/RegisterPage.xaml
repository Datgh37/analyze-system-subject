<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             x:Class="ExpenseTracker.Maui.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="24,40,24,40" MaximumWidthRequest="460">
            <!-- Header -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="64"
                        HeightRequest="64"
                        HorizontalOptions="Center"
                        Shadow="{Shadow Brush='#4F46E5', Offset='0,8', Radius=16, Opacity=0.3}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4F46E5" Offset="0.0" />
                            <GradientStop Color="#7C3AED" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image Source="ic_diamond.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Tạo Tài Khoản Mới" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                <Label Text="Bắt đầu hành trình quản lý tài chính cá nhân thông minh" 
                       FontSize="13" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Card Container -->
            <Border Style="{StaticResource ModernCard}"
                    Padding="24"
                    Shadow="{Shadow Brush='#000000', Offset='0,4', Radius=12, Opacity=0.08}">
                <VerticalStackLayout Spacing="16">
                    <!-- Error Alert -->
                    <Border BackgroundColor="#FEF2F2"
                            Stroke="#FECACA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                            <Label Text="{Binding ErrorMessage}" 
                                   TextColor="#B91C1C" 
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Full Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Họ và Tên" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Entry Placeholder="Nguyễn Văn A"
                                   Text="{Binding FullName}"
                                   FontSize="14"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Địa chỉ Email" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Entry Placeholder="name@example.com"
                                   Keyboard="Email"
                                   Text="{Binding Email}"
                                   FontSize="14"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mật khẩu" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Entry Placeholder="Tối thiểu 6 ký tự"
                                   IsPassword="True"
                                   FontSize="14"
                                   Text="{Binding Password}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Xác nhận mật khẩu" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,2"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Entry Placeholder="Nhập lại mật khẩu"
                                   IsPassword="True"
                                   FontSize="14"
                                   Text="{Binding ConfirmPassword}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Base Currency -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Đơn vị tiền tệ cơ sở" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="8,0"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Picker SelectedItem="{Binding BaseCurrency}">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>VND</x:String>
                                        <x:String>USD</x:String>
                                        <x:String>EUR</x:String>
                                        <x:String>JPY</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Submit Button -->
                    <Button Text="Tạo Tài Khoản" 
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="#4F46E5"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="10"
                            HeightRequest="48"
                            Margin="0,8,0,0" />

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                       IsVisible="{Binding IsBusy}" 
                                       Color="#4F46E5"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Switch to Login -->
            <Button Text="Đã có tài khoản? Đăng Nhập" 
                    Command="{Binding NavigateToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#4F46E5"
                    FontSize="13"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

