<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Transactions"
             xmlns:components="clr-namespace:ExpenseTracker.Maui.Views.Components"
             x:Class="ExpenseTracker.Maui.Views.IncomesPage"
             x:DataType="vm:IncomesViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <Grid RowDefinitions="*, Auto">
        <!-- VÙNG CUỘN NỘI DUNG CHÍNH -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12,16,28" Spacing="16" MaximumWidthRequest="640">

                <!-- 1. HERO INCOMES CARD: TỔNG THU NHẬP & NÚT QUÉT BẢNG LƯƠNG AI -->
                <Border Stroke="{AppThemeBinding Light=#34D399, Dark=#059669}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 24"
                        Padding="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#064E3B" Offset="0.0" />
                            <GradientStop Color="#047857" Offset="0.5" />
                            <GradientStop Color="#059669" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#059669" Offset="0,6" Radius="20" Opacity="0.35" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Image Source="ic_income.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                <Label Text="TỔNG THU NHẬP THÁNG NÀY" FontSize="11" FontAttributes="Bold" TextColor="#A7F3D0" CharacterSpacing="1" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#065F46" StrokeShape="RoundRectangle 8" Padding="8,3" VerticalOptions="Center">
                                <Label Text="TIỀN VÀO TÚI" FontSize="10" FontAttributes="Bold" TextColor="#D1FAE5" />
                            </Border>
                        </Grid>

                        <!-- Số tiền thu nhập lớn 32pt -->
                        <Label Text="{Binding FormattedMonthlyTotal}"
                               FontSize="32" FontAttributes="Bold" TextColor="#FFFFFF" />

                        <!-- Nút 1-Chạm Quét Bảng Lương AI OCR Ngay Trên Header -->
                        <Border BackgroundColor="#FFFFFF"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,10"
                                Margin="0,4,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnQuickScanPayslipClicked" />
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,3" Radius="8" Opacity="0.2" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 10" BackgroundColor="#D1FAE5" StrokeThickness="0">
                                    <Image Source="ic_ocr.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Quét Bảng Lương Bằng AI" FontSize="13" FontAttributes="Bold" TextColor="#065F46" />
                                    <Label Text="Tự động bóc tách thực lĩnh, BHXH &amp; thuế TNCN" FontSize="11" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="Quét ngay →" FontSize="12" FontAttributes="Bold" TextColor="#059669" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- THÔNG BÁO LỖI (NẾU CÓ) -->
                <Border Stroke="#FCA5A5" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                        Padding="14" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#EF4444" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ErrorMessage}"
                               TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                               FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- 2. FORM NHẬP KHOẢN THU NHẬP MỚI (BIG AMOUNT ENTRY) -->
                <Border Style="{StaticResource FintechCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="GHI CHÉP NGUỒN THU MỚI" Style="{StaticResource FintechCardTitleStyle}" />
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" StrokeShape="RoundRectangle 8" Padding="8,3">
                                <Label Text="0ms Cộng Số Dư" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource FintechIncome}" />
                            </Border>
                        </Grid>

                        <!-- Ô NHẬP SỐ TIỀN CỰC LỚN 34pt CÓ TIỀN TỐ CỘNG XANH EMERALD -->
                        <Border Stroke="{AppThemeBinding Light=#A7F3D0, Dark=#065F46}"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#0F291E}"
                                Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="+" FontSize="34" FontAttributes="Bold" TextColor="{StaticResource FintechIncome}" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding AmountInput}"
                                       Placeholder="0"
                                       Keyboard="Numeric"
                                       FontSize="34"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource FintechIncome}"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="VND" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource FintechIncome}" VerticalOptions="Center" Opacity="0.8" />
                            </Grid>
                        </Border>

                        <!-- NỘI DUNG NGUỒN THU -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nội dung nguồn thu" Style="{StaticResource FintechCaptionStyle}" />
                            <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                    Padding="14,4">
                                <Entry Text="{Binding Note}"
                                       Placeholder="Ví dụ: Lương tháng, Thưởng dự án, Cổ tức..."
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- VÍ NHẬN TIỀN & DANH MỤC THU -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Cộng vào ví" Style="{StaticResource FintechCaptionStyle}" />
                                <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                        Padding="10,2">
                                    <Picker ItemsSource="{Binding Wallets}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding SelectedWallet}"
                                            Title="-- Chọn ví --"
                                            FontSize="13"
                                            TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Xếp vào nguồn" Style="{StaticResource FintechCaptionStyle}" />
                                <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                        Padding="10,2">
                                    <Picker ItemsSource="{Binding IncomeCategories}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding SelectedCategory}"
                                            Title="-- Chọn nhóm --"
                                            FontSize="13"
                                            TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- BẬT/TẮT THU NHẬP BẤT THƯỜNG (WINDFALL) -->
                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Khoản thu bất thường (Windfall)" FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                                    <Label Text="Không tính vào thu nhập cố định hàng tháng" FontSize="11" TextColor="{StaticResource FintechTextMuted}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsWindfall}" OnColor="{StaticResource FintechIncome}" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- NÚT GHI NHẬN THU NHẬP -->
                        <Button Text="✓ Xác Nhận Thu Nhập"
                                Command="{Binding CreateIncomeCommand}"
                                BackgroundColor="{StaticResource FintechIncome}"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="15"
                                CornerRadius="14"
                                HeightRequest="50"
                                Margin="0,4,0,0">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource FintechIncome}" Offset="0,4" Radius="12" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. LỊCH SỬ THU NHẬP GẦN ĐÂY -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,8,2,0" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="LỊCH SỬ THU NHẬP GẦN ĐÂY" Style="{StaticResource FintechSectionTitleStyle}" />
                    <Label Grid.Column="1" Text="Theo thời gian thực" FontSize="11" TextColor="{StaticResource FintechTextMuted}" VerticalOptions="Center" />
                </Grid>

                <CollectionView ItemsSource="{Binding Incomes}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border Style="{StaticResource FintechCardStyle}" Padding="28">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Image Source="ic_income.svg" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" />
                                <Label Text="Chưa có khoản thu nhập nào trong tháng này." Style="{StaticResource FintechBodyStyle}" HorizontalTextAlignment="Center" />
                                <Label Text="Nhấn xác nhận thu nhập ở trên hoặc quét bảng lương để ghi nhận." FontSize="12" TextColor="{StaticResource FintechTextMuted}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TransactionModel">
                            <Border Style="{StaticResource FintechCardStyle}" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <Border Grid.Column="0"
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                                            VerticalOptions="Center">
                                        <Image Source="ic_income.svg"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding CategoryName}"
                                               Style="{StaticResource FintechCardTitleStyle}"
                                               LineBreakMode="TailTruncation" />

                                        <Label Text="{Binding Note}"
                                               Style="{StaticResource FintechCaptionStyle}"
                                               LineBreakMode="TailTruncation"
                                               IsVisible="{Binding Note, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding WalletName}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource FintechIncome}" />
                                            <Label Text="•" FontSize="11" TextColor="{StaticResource FintechTextMuted}" />
                                            <Label Text="{Binding TransactionDate, StringFormat='{0:dd/MM/yyyy}'}"
                                                   Style="{StaticResource FintechCaptionStyle}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding Amount, StringFormat='+{0:N0} đ'}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource FintechIncome}"
                                               HorizontalOptions="End" />

                                        <ImageButton Source="ic_trash.svg"
                                                     BackgroundColor="Transparent"
                                                     HeightRequest="30"
                                                     WidthRequest="30"
                                                     Padding="6"
                                                     Aspect="AspectFit"
                                                     HorizontalOptions="End"
                                                     ToolTipProperties.Text="Xóa thu nhập"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncomesViewModel}}, Path=DeleteIncomeCommand}"
                                                     CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DUY NHẤT 1 THANH BOTTOM BAR BỒNG BỀNH -->
        <components:BottomNavDockView Grid.Row="1" ActiveTab="Home" />
    </Grid>
</ContentPage>