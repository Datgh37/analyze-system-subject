<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             x:Class="ExpenseTracker.Maui.Views.PayslipOcrPage"
             x:DataType="vm:PayslipOcrViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Title & Introduction -->
            <Label Text="Bóc Tách Phiếu Lương AI Vision OCR (Wireframe UC-02.08)" FontSize="18" FontAttributes="Bold" />
            <Label Text="Hỗ trợ tải tệp ảnh (JPEG/PNG) hoặc tài liệu PDF phiếu lương. AI sẽ bóc tách cấu trúc lương Gross, Net, bảo hiểm và tự động kiểm toán công thức."
                   FontSize="12" TextColor="Gray" />

            <!-- File Upload Action Button -->
            <Button Text="📷 Chọn Tệp Ảnh / PDF Phiếu Lương"
                    Command="{Binding PickAndParsePayslipCommand}"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold" />

            <Label Text="{Binding SelectedFileName, StringFormat='Tệp đã chọn: {0}'}"
                   FontSize="12"
                   IsVisible="{Binding SelectedFileName, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <!-- Status Banner -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="Green"
                   FontAttributes="Bold"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

            <!-- Error / Discrepancy Banner (UC-02.08 E2) -->
            <Border Stroke="#F59E0B" BackgroundColor="#FEF3C7" Padding="12" StrokeShape="RoundRectangle 6"
                    IsVisible="{Binding HasDiscrepancy}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="⚠️ CẢNH BÁO SAI LỆCH SỐ HỌC (UC-02.08 E2)"
                           FontAttributes="Bold"
                           TextColor="#B45309"
                           FontSize="13" />
                    <Label Text="{Binding DiscrepancyAmount, StringFormat='Phát hiện chênh lệch {0:N0} VND giữa Net và công thức khấu trừ (Gross - Khấu trừ + Phụ cấp). Vui lòng kiểm tra lại số liệu trước khi xác nhận lưu.'}"
                           TextColor="#92400E"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding HasError}" />

            <!-- Payslip Preview Breakdown (UC-02.08 Step 7) -->
            <Border Stroke="Gray" Padding="14" StrokeShape="RoundRectangle 8"
                    IsVisible="{Binding HasParsedData}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Bảng Phân Tích Cơ Cấu Lương (Payslip Preview)" FontAttributes="Bold" FontSize="16" />

                    <!-- Employer & Period -->
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Đơn vị chi trả:" FontSize="12" TextColor="Gray" />
                            <Entry Text="{Binding EmployerName}" FontSize="13" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Kỳ lương:" FontSize="12" TextColor="Gray" />
                            <Entry Text="{Binding PayPeriod}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Gross Salary -->
                    <Label Text="Lương tổng (Gross Salary):" FontSize="12" TextColor="Gray" />
                    <Entry Text="{Binding GrossSalary}" Keyboard="Numeric" FontAttributes="Bold" />

                    <!-- Deductions -->
                    <Label Text="Các khoản trích theo lương &amp; Thuế:" FontAttributes="Bold" FontSize="13" Margin="0,4,0,0" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                            <Label Text="BHXH (8%):" FontSize="11" TextColor="Gray" />
                            <Entry Text="{Binding SocialInsurance}" Keyboard="Numeric" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                            <Label Text="BHYT (1.5%):" FontSize="11" TextColor="Gray" />
                            <Entry Text="{Binding HealthInsurance}" Keyboard="Numeric" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                            <Label Text="BHTN (1%):" FontSize="11" TextColor="Gray" />
                            <Entry Text="{Binding UnemploymentInsurance}" Keyboard="Numeric" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Thuế TNCN:" FontSize="11" TextColor="Gray" />
                            <Entry Text="{Binding PersonalIncomeTax}" Keyboard="Numeric" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Additions -->
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Phụ cấp:" FontSize="11" TextColor="Gray" />
                            <Entry Text="{Binding Allowances}" Keyboard="Numeric" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Thưởng hiệu quả:" FontSize="11" TextColor="Gray" />
                            <Entry Text="{Binding Bonus}" Keyboard="Numeric" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Net Salary (Highlighted) -->
                    <Border Stroke="#059669" BackgroundColor="#ECFDF5" Padding="12" StrokeShape="RoundRectangle 6">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="LƯƠNG THỰC NHẬN VÀO TÀI KHOẢN (NET SALARY):" FontSize="12" TextColor="#065F46" FontAttributes="Bold" />
                            <Entry Text="{Binding NetSalary}" Keyboard="Numeric" FontSize="20" FontAttributes="Bold" TextColor="#047857" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Ledger Destination Options -->
                    <Label Text="Thiết Lập Tiếp Nhận Tiền Lương:" FontAttributes="Bold" FontSize="14" Margin="0,8,0,0" />

                    <!-- Wallet -->
                    <Label Text="Ví nhận tiền lương thực tế:" FontSize="12" />
                    <Picker Title="-- Chọn ví --"
                            ItemsSource="{Binding Wallets}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedWallet}" />

                    <!-- Category -->
                    <Label Text="Danh mục thu nhập:" FontSize="12" />
                    <Picker Title="-- Chọn danh mục --"
                            ItemsSource="{Binding IncomeCategories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}" />

                    <!-- Update Recurring Schedule (UC-02.08 A1) -->
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding UpdateRecurringIncome}" />
                        <Label Text="Cập nhật mức lương này cho lịch thu định kỳ hàng tháng (UC-02.08 A1)"
                               VerticalOptions="Center"
                               FontSize="12" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding UpdateRecurringIncome}">
                        <Label Text="Chọn nguồn thu định kỳ cần cập nhật:" FontSize="12" TextColor="Gray" />
                        <Picker Title="-- Chọn nguồn thu định kỳ --"
                                ItemsSource="{Binding RecurringIncomes}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedRecurringIncome}" />
                    </VerticalStackLayout>

                    <!-- Confirm Button -->
                    <Button Text="💾 Xác Nhận Lưu Thu Nhập Lương Vào Sổ Cái"
                            Command="{Binding ConfirmPayslipCommand}"
                            BackgroundColor="#059669"
                            TextColor="White"
                            FontAttributes="Bold"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
