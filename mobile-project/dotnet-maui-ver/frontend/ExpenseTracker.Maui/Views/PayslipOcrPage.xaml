<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             x:Class="ExpenseTracker.Maui.Views.PayslipOcrPage"
             x:DataType="vm:PayslipOcrViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,100" Spacing="16" MaximumWidthRequest="720">

            <Border Style="{StaticResource FintechHeroCard}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Image Source="ic_income.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Text="BÓC TÁCH PHIẾU LƯƠNG"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#A7F3D0"
                                   CharacterSpacing="1.2"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#047857"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent">
                            <Label Text="ĐỐI SOÁT TỰ ĐỘNG"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#ECFDF5" />
                        </Border>
                    </Grid>

                    <Label Text="Bóc Tách Phiếu Lương Định Kỳ"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />

                    <Label Text="Tải ảnh hoặc tài liệu PDF phiếu lương hàng tháng. Trí tuệ nhân tạo sẽ tự động bóc tách lương tổng (Gross), các khoản trích bảo hiểm (BHXH, BHYT, BHTN), thuế và lương thực lĩnh (Net) vào ví."
                           FontSize="12"
                           TextColor="#D1FAE5"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Tải Lên Phiếu Lương Hàng Tháng"
                                   Style="{StaticResource FintechLabelSubtitle}" />
                            <Label Text="Tài liệu sẽ được xử lý bảo mật trên thiết bị và gửi tới hệ thống phân tích"
                                   Style="{StaticResource FintechLabelCaption}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="ic_camera.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                    </Grid>

                    <Button Text="Chọn Tệp Ảnh / PDF Phiếu Lương"
                            Command="{Binding PickAndParsePayslipCommand}"
                            Style="{StaticResource FintechButtonPrimary}"
                            BackgroundColor="#10B981"
                            HeightRequest="46" />

                    <Border BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E293B}"
                            Stroke="#BFDBFE"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,8"
                            IsVisible="{Binding SelectedFileName, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                        <HorizontalStackLayout Spacing="8">
                            <Image Source="ic_category.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Text="{Binding SelectedFileName, StringFormat='Tệp đã chọn: {0}'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#1D4ED8"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}"
                    Padding="16"
                    IsVisible="{Binding IsBusy}">
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#10B981" />
                    <Label Text="Đang bóc tách cơ cấu lương &amp; đối soát bảo hiểm..."
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#10B981"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                    Stroke="#A7F3D0"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#059669" VerticalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           TextColor="{AppThemeBinding Light=#065F46, Dark=#86EFAC}"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Stroke="#F59E0B"
                    StrokeThickness="1.5"
                    BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}"
                    Padding="16"
                    StrokeShape="RoundRectangle 12"
                    IsVisible="{Binding HasDiscrepancy}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#D97706" VerticalOptions="Center" />
                            <Label Text="CẢNH BÁO SAI LỆCH SỐ HỌC"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#FDE68A}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#FDE68A"
                                Padding="6,2"
                                StrokeShape="RoundRectangle 4"
                                Stroke="Transparent">
                            <Label Text="ĐỐI SOÁT" FontSize="10" FontAttributes="Bold" TextColor="#92400E" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding DiscrepancyAmount, StringFormat='Phát hiện chênh lệch {0:N0} đ giữa lương thực nhận và công thức khấu trừ (Lương tổng - Khấu trừ + Phụ cấp). Vui lòng kiểm tra lại số liệu trước khi xác nhận lưu.'}"
                           TextColor="{AppThemeBinding Light=#92400E, Dark=#FEF3C7}"
                           FontSize="12"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    IsVisible="{Binding HasError}">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#B91C1C"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}"
                    Padding="18"
                    IsVisible="{Binding HasParsedData}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Bảng Phân Tích Cơ Cấu Lương" 
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Xem lại chi tiết từng khoản trước khi ghi nhận vào ví"
                                   Style="{StaticResource FintechLabelCaption}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 6"
                                Stroke="Transparent"
                                VerticalOptions="Center">
                            <Label Text="XEM TRƯỚC" FontSize="10" FontAttributes="Bold" TextColor="#10B981" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Đơn vị chi trả:" FontSize="12" FontAttributes="Bold" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Entry Text="{Binding EmployerName}" FontSize="13" FontAttributes="Bold" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Kỳ lương:" FontSize="12" FontAttributes="Bold" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Entry Text="{Binding PayPeriod}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Lương tổng (Gross):" FontSize="12" FontAttributes="Bold" Style="{StaticResource FintechLabelCaption}" />
                        <Border Style="{StaticResource FintechInput}">
                            <Entry Text="{Binding GrossSalary}" Keyboard="Numeric" FontAttributes="Bold" FontSize="15" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Các khoản trích theo lương &amp; Thuế:"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="BHXH (8%):" FontSize="11" Style="{StaticResource FintechLabelCaption}" />
                                <Border Style="{StaticResource FintechInput}">
                                    <Entry Text="{Binding SocialInsurance}" Keyboard="Numeric" FontSize="12" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                <Label Text="BHYT (1.5%):" FontSize="11" Style="{StaticResource FintechLabelCaption}" />
                                <Border Style="{StaticResource FintechInput}">
                                    <Entry Text="{Binding HealthInsurance}" Keyboard="Numeric" FontSize="12" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                <Label Text="BHTN (1%):" FontSize="11" Style="{StaticResource FintechLabelCaption}" />
                                <Border Style="{StaticResource FintechInput}">
                                    <Entry Text="{Binding UnemploymentInsurance}" Keyboard="Numeric" FontSize="12" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                <Label Text="Thuế TNCN:" FontSize="11" Style="{StaticResource FintechLabelCaption}" />
                                <Border Style="{StaticResource FintechInput}">
                                    <Entry Text="{Binding PersonalIncomeTax}" Keyboard="Numeric" FontSize="12" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Phụ cấp:" FontSize="11" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Entry Text="{Binding Allowances}" Keyboard="Numeric" FontSize="12" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Thưởng hiệu quả:" FontSize="11" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Entry Text="{Binding Bonus}" Keyboard="Numeric" FontSize="12" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Border Stroke="#10B981"
                            StrokeThickness="1.5"
                            BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                            Padding="16"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="LƯƠNG THỰC NHẬN VÀO TÀI KHOẢN (NET):"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#065F46, Dark=#A7F3D0}"
                                   FontAttributes="Bold" />
                            <Entry Text="{Binding NetSalary}"
                                   Keyboard="Numeric"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#047857, Dark=#34D399}" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Thiết Lập Tiếp Nhận Tiền Lương"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ví nhận tiền lương thực tế:" FontSize="12" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Picker Title="-- Chọn ví --"
                                        ItemsSource="{Binding Wallets}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedWallet}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Danh mục thu nhập:" FontSize="12" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Picker Title="-- Chọn danh mục --"
                                        ItemsSource="{Binding IncomeCategories}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedCategory}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center" Margin="0,4,0,0">
                            <CheckBox Grid.Column="0" IsChecked="{Binding UpdateRecurringIncome}" Color="#10B981" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Cập nhật mức lương này cho lịch thu định kỳ hàng tháng"
                                   VerticalOptions="Center"
                                   FontSize="12" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Grid>

                        <VerticalStackLayout IsVisible="{Binding UpdateRecurringIncome}" Spacing="4">
                            <Label Text="Chọn nguồn thu định kỳ cần cập nhật:" FontSize="12" Style="{StaticResource FintechLabelCaption}" />
                            <Border Style="{StaticResource FintechInput}">
                                <Picker Title="-- Chọn nguồn thu định kỳ --"
                                        ItemsSource="{Binding RecurringIncomes}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedRecurringIncome}" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Xác Nhận Lưu Thu Nhập Lương Vào Ví"
                                Command="{Binding ConfirmPayslipCommand}"
                                Style="{StaticResource FintechButtonPrimary}"
                                BackgroundColor="#10B981"
                                HeightRequest="48"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>