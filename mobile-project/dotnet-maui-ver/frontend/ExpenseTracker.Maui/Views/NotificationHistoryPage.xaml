<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Notifications"
             xmlns:components="clr-namespace:ExpenseTracker.Maui.Views.Components"
             x:Class="ExpenseTracker.Maui.Views.NotificationHistoryPage"
             x:DataType="vm:NotificationHistoryViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- 1. TOP HEADER BAR TÍCH HỢP -->
        <Border Grid.Row="0" Margin="16,12,16,8" Padding="18"
                Style="{StaticResource FintechCardStyle}">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Trung Tâm Thông Báo" Style="{StaticResource FintechCardTitleStyle}" />
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A8A}"
                                Padding="8,2"
                                IsVisible="{Binding UnreadCount, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                            <Label Text="{Binding UnreadCount, StringFormat='{0} mới'}"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource FintechPrimary}" />
                        </Border>
                    </HorizontalStackLayout>
                    <Label Text="{Binding StatusMessage, FallbackValue='Cập nhật thông báo biến động tài chính tức thì'}"
                           Style="{StaticResource FintechCaptionStyle}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Đọc tất cả"
                        Command="{Binding MarkAllAsReadCommand}"
                        BackgroundColor="{StaticResource FintechPrimary}"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="36"
                        FontSize="12"
                        Padding="14,0" />
            </Grid>
        </Border>

        <!-- 2. BỘ LỌC THÔNG BÁO DẠNG PILLS LƯỚT NGANG -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="16,0,16,10">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Tất cả"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="All"
                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                        TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                        FontAttributes="Bold" HeightRequest="36" Padding="14,0" CornerRadius="10" FontSize="12" />

                <Button Text="Chưa đọc"
                        Command="{Binding SetFilterCommand}"
                        CommandParameter="Unread"
                        BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A8A}"
                        TextColor="{StaticResource FintechPrimary}"
                        FontAttributes="Bold" HeightRequest="36" Padding="14,0" CornerRadius="10" FontSize="12" />

                <Button Text="🔔 Test Cảnh báo"
                        Command="{Binding SendTestNotificationCommand}"
                        CommandParameter="budget"
                        BackgroundColor="{AppThemeBinding Light=#FFFBEB, Dark=#451A03}"
                        TextColor="{AppThemeBinding Light=#B45309, Dark=#FBBF24}"
                        FontAttributes="Bold" HeightRequest="36" Padding="12,0" CornerRadius="10" FontSize="11" />

                <Button Text="💰 Test Số dư"
                        Command="{Binding SendTestNotificationCommand}"
                        CommandParameter="balance"
                        BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                        TextColor="{StaticResource FintechIncome}"
                        FontAttributes="Bold" HeightRequest="36" Padding="12,0" CornerRadius="10" FontSize="11" />

                <Button Text="⏰ Nhắc nhở 21:00"
                        Command="{Binding ScheduleDailyReminderCommand}"
                        BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#78350F}"
                        TextColor="{AppThemeBinding Light=#B45309, Dark=#FDE68A}"
                        FontAttributes="Bold" HeightRequest="36" Padding="12,0" CornerRadius="10" FontSize="11" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 3. DANH SÁCH THÔNG BÁO THEO THỜI GIAN THỰC -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadNotificationsCommand}">
            <CollectionView ItemsSource="{Binding Notifications}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource FintechCardStyle}" Padding="32" Margin="16,10">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Image Source="ic_bell.svg" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" />
                            <Label Text="Không có thông báo nào" Style="{StaticResource FintechCardTitleStyle}" HorizontalOptions="Center" />
                            <Label Text="Mọi biến động số dư, cảnh báo hạn mức ngân sách và nhắc nhở chi tiêu sẽ xuất hiện tại đây."
                                   Style="{StaticResource FintechCaptionStyle}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InAppNotificationModel">
                        <Border Margin="16,0,16,10" Padding="16,14"
                                Style="{StaticResource FintechCardStyle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationHistoryViewModel}}, Path=OpenNotificationDetailCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                        VerticalOptions="Center">
                                    <Image Source="{Binding TypeSvgIcon}" WidthRequest="22" HeightRequest="22"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           Style="{StaticResource FintechCardTitleStyle}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Message}"
                                           Style="{StaticResource FintechCaptionStyle}"
                                           LineBreakMode="WordWrap" MaxLines="2" />
                                    <Label Text="{Binding FormattedCreatedAt}"
                                           FontSize="10" TextColor="{StaticResource FintechTextMuted}" />
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="Chi Tiết"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationHistoryViewModel}}, Path=OpenNotificationDetailCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                        TextColor="{StaticResource FintechPrimary}"
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        HeightRequest="32"
                                        Padding="12,0"
                                        CornerRadius="8"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- 4. THÔNG BÁO LỖI (NẾU CÓ) -->
        <Border Grid.Row="3" Margin="16,6" Padding="14"
                Stroke="#FCA5A5" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                   FontSize="12" FontAttributes="Bold" />
        </Border>

        <!-- 5. DUY NHẤT 1 THANH BOTTOM BAR BỒNG BỀNH -->
        <components:BottomNavDockView Grid.Row="4" ActiveTab="Home" />
    </Grid>
</ContentPage>