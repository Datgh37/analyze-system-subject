<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             x:Class="ExpenseTracker.Maui.Views.CreateBudgetPage"
             x:DataType="vm:CreateBudgetViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="18" MaximumWidthRequest="720">

            <!-- ========================================== -->
            <!-- 1. HERO BANNER: BUDGET CREATION            -->
            <!-- ========================================== -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="22"
                    Shadow="{Shadow Brush='#4F46E5', Offset='0,10', Radius=20, Opacity=0.25}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E1B4B" Offset="0.0" />
                        <GradientStop Color="#312E81" Offset="0.5" />
                        <GradientStop Color="#4338CA" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="📊" FontSize="18" VerticalOptions="Center" />
                            <Label Text="BUDGETING ENGINE"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#A5B4FC"
                                   CharacterSpacing="1.2"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#3730A3"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent">
                            <Label Text="MULTI-METHOD"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#E0E7FF" />
                        </Border>
                    </Grid>

                    <Label Text="Lập Kế Hoạch Ngân Sách Mới"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />

                    <Label Text="Áp dụng phương pháp 50/30/20, Zero-Based Budgeting (ZBB) hoặc Kakeibo để kiểm soát dòng tiền và kích hoạt động cơ hạn mức DSA hàng ngày."
                           FontSize="12"
                           TextColor="#C7D2FE"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- Error Banner -->
            <Border BackgroundColor="#FEF2F2"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    IsVisible="{Binding HasError}">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="❌" FontSize="14" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#B91C1C"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Success Status Banner -->
            <Border BackgroundColor="#ECFDF5"
                    Stroke="#A7F3D0"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="✅" FontSize="14" VerticalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           TextColor="#065F46"
                           FontAttributes="Bold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Loading Indicator -->
            <Border Style="{StaticResource ModernCard}"
                    Padding="14"
                    IsVisible="{Binding IsBusy}">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#4F46E5" />
                    <Label Text="Đang xử lý kế hoạch ngân sách..."
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#4F46E5"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- ========================================== -->
            <!-- 2. GENERAL BUDGET CONFIGURATION            -->
            <!-- ========================================== -->
            <Border Style="{StaticResource ModernCard}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Thông Tin Kế Hoạch Ngân Sách"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" />

                    <!-- Budget Name -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tên kế hoạch:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,2"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Entry Placeholder="Ví dụ: Ngân sách Tháng 10/2026..."
                                   Text="{Binding BudgetName}"
                                   FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Total Amount -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tổng số tiền ngân sách chu kỳ (VND):" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,2"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Entry Placeholder="Ví dụ: 15000000"
                                   Text="{Binding TotalAmount}"
                                   Keyboard="Numeric"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Period Type -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Chu kỳ ngân sách:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,0"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Picker Title="-- Chọn chu kỳ --"
                                    ItemsSource="{Binding PeriodOptions}"
                                    SelectedIndex="{Binding SelectedPeriodIndex}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Start & End Date -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Ngày bắt đầu:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                            <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,2"
                                    BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                                <DatePicker Date="{Binding StartDate}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Ngày kết thúc:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                            <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,2"
                                    BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                                <DatePicker Date="{Binding EndDate}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Budgeting Methodology -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Phương pháp hoạch định ngân sách:" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}" />
                        <Border Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,0"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                            <Picker Title="-- Chọn phương pháp --"
                                    ItemsSource="{Binding MethodOptions}"
                                    SelectedIndex="{Binding SelectedMethodIndex}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================== -->
            <!-- 3. ALLOCATION SUMMARY & ZBB INVARIANT CARD -->
            <!-- ========================================== -->
            <Border Stroke="{AppThemeBinding Light='#BFDBFE', Dark='#1E3A8A'}"
                    BackgroundColor="{AppThemeBinding Light='#EFF6FF', Dark='#172554'}"
                    Padding="16"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Tổng Quan Phân Bổ Hạn Mức" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light='#1E40AF', Dark='#93C5FD'}" />
                        <Border Grid.Column="1" BackgroundColor="#DBEAFE" Padding="6,2" StrokeShape="RoundRectangle 4" Stroke="Transparent">
                            <Label Text="ZBB INVARIANT" FontSize="9" FontAttributes="Bold" TextColor="#1D4ED8" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Tổng ngân sách" FontSize="11" TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                            <Label Text="{Binding TotalAmount, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Đã phân bổ (Σ)" FontSize="11" TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                            <Label Text="{Binding TotalAllocatedSum, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#4F46E5" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Chưa phân bổ" FontSize="11" TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                            <Label Text="{Binding RemainingToAllocate, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#10B981" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="💡 Lưu ý với ZBB (Zero-Based Budgeting): Số tiền 'Chưa phân bổ' phải bằng đúng 0 đ (mọi đồng tiền đều có mục đích)."
                           FontSize="11"
                           TextColor="{AppThemeBinding Light='#1D4ED8', Dark='#93C5FD'}"
                           FontAttributes="Italic"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- ========================================== -->
            <!-- 4. CATEGORY ALLOCATIONS LIST               -->
            <!-- ========================================== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Phân Bổ Cho Từng Danh Mục Chi Tiêu"
                       FontAttributes="Bold"
                       FontSize="15"
                       TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" />

                <CollectionView ItemsSource="{Binding CategoryInputs}">
                    <CollectionView.EmptyView>
                        <Label Text="Đang tải danh mục chi tiêu..."
                               TextColor="Gray"
                               HorizontalOptions="Center"
                               Margin="0,16" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryAllocationInputItem">
                            <Border Style="{StaticResource ModernCard}"
                                    Padding="14"
                                    Margin="0,3">
                                <Grid ColumnDefinitions="*,140" ColumnSpacing="12" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding DisplayCategoryIcon}" FontSize="14" VerticalOptions="Center" />
                                            <Label Text="{Binding CategoryName}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding RuleName}" FontSize="11" TextColor="{AppThemeBinding Light='#4F46E5', Dark='#A5B4FC'}" FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <!-- Allocated Amount Input -->
                                    <Border Grid.Column="1"
                                            Stroke="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,2"
                                            BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}">
                                        <Entry Placeholder="Số tiền (đ)"
                                               Text="{Binding AllocatedAmount}"
                                               Keyboard="Numeric"
                                               HorizontalTextAlignment="End"
                                               FontSize="13"
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- ========================================== -->
            <!-- 5. SUBMIT ACTION BUTTON                    -->
            <!-- ========================================== -->
            <Button Text="💾 Hoàn Tất &amp; Kích Hoạt Kế Hoạch Ngân Sách"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="12"
                    HeightRequest="50"
                    Command="{Binding CreateBudgetCommand}"
                    Margin="0,8,0,24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

