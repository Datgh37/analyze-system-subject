<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             x:Class="ExpenseTracker.Maui.Views.CreateBudgetPage"
             x:DataType="vm:CreateBudgetViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource NeutralLight100}, Dark={StaticResource NeutralDark900}}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="16" MaximumWidthRequest="720">

            <Border Style="{StaticResource FintechHeroCard}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Image Source="ic_budget.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Text="HOẠCH ĐỊNH TÀI CHÍNH"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#A5B4FC"
                                   CharacterSpacing="1.2"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#3730A3"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 8"
                                Stroke="Transparent">
                            <Label Text="ĐA PHƯƠNG PHÁP"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#E0E7FF" />
                        </Border>
                    </Grid>

                    <Label Text="Lập Kế Hoạch Ngân Sách Mới"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF" />

                    <Label Text="Áp dụng phương pháp 50/30/20, ngân sách số dư bằng không hoặc Kakeibo để kiểm soát dòng tiền và kích hoạt hạn mức chi tiêu mỗi ngày."
                           FontSize="12"
                           TextColor="#C7D2FE"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                    Stroke="#FECACA"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10"
                    IsVisible="{Binding HasError}">
                <HorizontalStackLayout Spacing="10">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#DC2626" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#B91C1C"
                           FontAttributes="Bold"
                           FontSize="13"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                    Stroke="#A7F3D0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10"
                    IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                <HorizontalStackLayout Spacing="10">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#059669" VerticalOptions="Center" />
                    <Label Text="{Binding StatusMessage}"
                           TextColor="#065F46"
                           FontAttributes="Bold"
                           FontSize="13"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}"
                    Padding="14"
                    IsVisible="{Binding IsBusy}">
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryLight}" WidthRequest="20" HeightRequest="20" />
                    <Label Text="Đang xử lý kế hoạch ngân sách..."
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryLight}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Style="{StaticResource FintechCard}" Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Thông Tin Kế Hoạch Ngân Sách"
                           Style="{StaticResource FintechLabelSubtitle}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tên kế hoạch:"
                               Style="{StaticResource FintechLabelCaption}"
                               FontAttributes="Bold" />
                        <Border Style="{StaticResource FintechInput}">
                            <Entry Placeholder="Ví dụ: Ngân sách Tháng 11/2026..."
                                   Text="{Binding BudgetName}"
                                   FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tổng số tiền ngân sách chu kỳ (VND):"
                               Style="{StaticResource FintechLabelCaption}"
                               FontAttributes="Bold" />
                        <Border Style="{StaticResource FintechInput}">
                            <Entry Placeholder="Ví dụ: 15000000"
                                   Text="{Binding TotalAmount}"
                                   Keyboard="Numeric"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Chu kỳ ngân sách:"
                               Style="{StaticResource FintechLabelCaption}"
                               FontAttributes="Bold" />
                        <Border Style="{StaticResource FintechInput}">
                            <Picker Title="-- Chọn chu kỳ --"
                                    ItemsSource="{Binding PeriodOptions}"
                                    SelectedIndex="{Binding SelectedPeriodIndex}" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Ngày bắt đầu:"
                                   Style="{StaticResource FintechLabelCaption}"
                                   FontAttributes="Bold" />
                            <Border Style="{StaticResource FintechInput}">
                                <DatePicker Date="{Binding StartDate}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Ngày kết thúc:"
                                   Style="{StaticResource FintechLabelCaption}"
                                   FontAttributes="Bold" />
                            <Border Style="{StaticResource FintechInput}">
                                <DatePicker Date="{Binding EndDate}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Phương pháp hoạch định ngân sách:"
                               Style="{StaticResource FintechLabelCaption}"
                               FontAttributes="Bold" />
                        <Border Style="{StaticResource FintechInput}">
                            <Picker Title="-- Chọn phương pháp --"
                                    ItemsSource="{Binding MethodOptions}"
                                    SelectedIndex="{Binding SelectedMethodIndex}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1E3A8A}"
                    BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#172554}"
                    Padding="16"
                    StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Tổng Quan Phân Bổ Hạn Mức" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#1E40AF, Dark=#93C5FD}" />
                        <Border Grid.Column="1" BackgroundColor="#DBEAFE" Padding="8,3" StrokeShape="RoundRectangle 6" Stroke="Transparent">
                            <Label Text="QUY TẮC CÂN BẰNG" FontSize="10" FontAttributes="Bold" TextColor="#1D4ED8" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Tổng ngân sách" Style="{StaticResource FintechLabelCaption}" />
                            <Label Text="{Binding TotalAmount, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Đã phân bổ" Style="{StaticResource FintechLabelCaption}" />
                            <Label Text="{Binding TotalAllocatedSum, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PrimaryLight}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Chưa phân bổ" Style="{StaticResource FintechLabelCaption}" />
                            <Label Text="{Binding RemainingToAllocate, StringFormat='{0:N0} đ'}"
                                   FontSize="13" FontAttributes="Bold" TextColor="#10B981" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Lưu ý với ngân sách số không: Số tiền 'Chưa phân bổ' phải bằng đúng 0 đ để đảm bảo mọi khoản thu nhập đều có mục đích cụ thể."
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}"
                           FontAttributes="Italic"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="8">
                <Label Text="Phân Bổ Cho Từng Danh Mục Chi Tiêu"
                       Style="{StaticResource FintechLabelSubtitle}" />

                <CollectionView ItemsSource="{Binding CategoryInputs}">
                    <CollectionView.EmptyView>
                        <Label Text="Đang tải danh mục chi tiêu..."
                               Style="{StaticResource FintechLabelCaption}"
                               HorizontalOptions="Center"
                               Margin="0,16" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryAllocationInputItem">
                            <Border Style="{StaticResource FintechCard}"
                                    Padding="14"
                                    Margin="0,3">
                                <Grid ColumnDefinitions="*,140" ColumnSpacing="12" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Border WidthRequest="28" HeightRequest="28"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                                    Stroke="Transparent"
                                                    VerticalOptions="Center">
                                                <Image Source="ic_category.svg" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="{Binding CategoryName}"
                                                   Style="{StaticResource FintechLabelBody}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding RuleName}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark=#A5B4FC}"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource FintechInput}"
                                            Padding="8,2">
                                        <Entry Placeholder="Số tiền (đ)"
                                               Text="{Binding AllocatedAmount}"
                                               Keyboard="Numeric"
                                               HorizontalTextAlignment="End"
                                               FontSize="13"
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="#10B981"
                    HeightRequest="50"
                    Margin="0,8,0,24">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CreateBudgetCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Grid.Column="0" Source="ic_check.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Hoàn Tất &amp; Kích Hoạt Kế Hoạch Ngân Sách" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>