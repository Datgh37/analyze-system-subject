<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Behavioral"
             xmlns:components="clr-namespace:ExpenseTracker.Maui.Views.Components"
             x:Class="ExpenseTracker.Maui.Views.CoolingOffHubPage"
             x:DataType="vm:CoolingOffHubViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource FintechBackgroundLight}, Dark={StaticResource FintechBackgroundDark}}">

    <Grid>
        <Grid RowDefinitions="*, Auto">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="16,12,16,28" Spacing="16" MaximumWidthRequest="640">

                    <!-- 1. HERO CARD: KHOẢNG TRỄ MUA SẮM 24 GIỜ (THALER PSYCHOLOGY) -->
                    <Border Stroke="{AppThemeBinding Light=#0284C7, Dark=#0284C7}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 24"
                            Padding="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0F172A" Offset="0.0" />
                                <GradientStop Color="#0369A1" Offset="0.5" />
                                <GradientStop Color="#0284C7" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#0284C7" Offset="0,6" Radius="20" Opacity="0.35" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                    <Image Source="ic_cooling.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                    <Label Text="KHOẢNG TRỄ MUA SẮM 24H" FontSize="11" FontAttributes="Bold" TextColor="#BAE6FD" CharacterSpacing="1" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#075985" Padding="8,3" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Label Text="BẢO VỆ TÂM LÝ" FontSize="10" FontAttributes="Bold" TextColor="#E0F2FE" />
                                </Border>
                            </Grid>

                            <Label Text="Khoảng Trễ Mua Sắm Bốc Đồng" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" />
                            <Label Text="Hạ nhiệt chi tiêu cảm xúc bằng cách tạm giữ các khoản chi lớn trong 24 giờ, tính toán số giờ lao động tương đương trước khi thanh toán."
                                   FontSize="12" TextColor="#E0F2FE" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- THÔNG BÁO TRẠNG THÁI & LỖI -->
                    <Border Stroke="#86EFAC" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                            Padding="14"
                            IsVisible="{Binding StatusMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#10B981" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light=#047857, Dark=#A7F3D0}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Stroke="#FCA5A5" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}"
                            Padding="14" IsVisible="{Binding HasError}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#EF4444" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- 2. CARD THỬ NGHIỆM TÁC ĐỘNG KHOẢN CHI LỚN -->
                    <Border Style="{StaticResource FintechCardStyle}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="THỬ NGHIỆM TÁC ĐỘNG KHOẢN CHI LỚN" Style="{StaticResource FintechCardTitleStyle}" />
                                <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A8A}" Padding="8,3" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Label Text="Mô Phỏng 24h" FontSize="10" FontAttributes="Bold" TextColor="#38BDF8" />
                                </Border>
                            </Grid>

                            <Label Text="Nhập số tiền bạn đang phân vân muốn mua để hệ thống đo lường số giờ lao động thực tế và mức độ ảnh hưởng đến hạn mức sinh hoạt mỗi ngày."
                                   Style="{StaticResource FintechCaptionStyle}" />

                            <Grid ColumnDefinitions="2*,*" ColumnSpacing="10" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                                            Padding="12,2">
                                        <Entry Text="{Binding TestExpenseAmount}" Placeholder="0 đ" Keyboard="Numeric"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                               BackgroundColor="Transparent" HeightRequest="44" />
                                    </Border>
                                </VerticalStackLayout>

                                <Button Grid.Column="1" Text="Đánh Giá"
                                        Command="{Binding EvaluateTestExpenseCommand}"
                                        BackgroundColor="#0284C7" TextColor="#FFFFFF"
                                        FontAttributes="Bold" CornerRadius="12" HeightRequest="44" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. DANH SÁCH GIAO DỊCH ĐANG TRONG KHOẢNG TRỄ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="2,6,2,0" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="GIAO DỊCH ĐANG TRONG KHOẢNG TRỄ" Style="{StaticResource FintechSectionTitleStyle}" />
                        <Label Grid.Column="1" Text="Phong tỏa 24h" FontSize="11" TextColor="{StaticResource FintechTextMuted}" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding PendingTransactions}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border Style="{StaticResource FintechCardStyle}" Padding="32">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Image Source="ic_shield.svg" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                                    <Label Text="Hiện không có giao dịch nào bị phong tỏa." Style="{StaticResource FintechCardTitleStyle}" HorizontalOptions="Center" />
                                    <Label Text="Mọi khoản chi tiêu trên 3.000.000 đ sẽ được kích hoạt khoảng trễ bảo vệ tâm lý tại đây."
                                           Style="{StaticResource FintechCaptionStyle}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CoolingOffTransactionModel">
                                <Border Style="{StaticResource FintechCardStyle}" Margin="0,0,0,12">
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Description}" Style="{StaticResource FintechCardTitleStyle}" />
                                                <Label Text="{Binding CategoryName, StringFormat='Danh mục: {0}'}" Style="{StaticResource FintechCaptionStyle}" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="1" Stroke="#0284C7" StrokeThickness="1" StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="{AppThemeBinding Light=#F0F9FF, Dark=#082F49}" Padding="10,4" VerticalOptions="Center">
                                                <Label Text="{Binding RemainingTimeDisplay}" FontSize="12" FontAttributes="Bold" TextColor="#0284C7" />
                                            </Border>
                                        </Grid>

                                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}"
                                                StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="14">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="Số tiền phong tỏa:" FontSize="11" TextColor="{StaticResource FintechTextMuted}" />
                                                    <Label Text="{Binding Amount, StringFormat='{0:N0} đ'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource FintechExpense}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="Giờ làm việc quy đổi:" FontSize="11" TextColor="{StaticResource FintechTextMuted}" />
                                                    <Label Text="{Binding EquivalentWorkHours, StringFormat='{0:N1} giờ công'}" FontSize="15" FontAttributes="Bold" TextColor="#D97706" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>

                                        <Border BackgroundColor="{AppThemeBinding Light=#FFF1F2, Dark=#4C0519}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10,6">
                                            <Label Text="{Binding ProjectedDsaReduction, StringFormat='Nếu mua, hạn mức mỗi ngày còn lại sẽ giảm {0:N0} đ/ngày'}"
                                                   FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FintechExpense}" />
                                        </Border>

                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                            <Button Grid.Column="0" Text="Xác Nhận Mua"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoolingOffHubViewModel}}, Path=ConfirmPurchaseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#EA580C" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="10" HeightRequest="38" FontSize="12" />

                                            <Button Grid.Column="1" Text="Hủy (Giữ Tiền)"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoolingOffHubViewModel}}, Path=CancelPurchaseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource FintechIncome}" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="10" HeightRequest="38" FontSize="12" />

                                            <Button Grid.Column="2" Text="Khẩn Cấp"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoolingOffHubViewModel}}, Path=OpenBypassModalCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" TextColor="{StaticResource FintechExpense}" CornerRadius="10" HeightRequest="38" FontSize="11" Padding="12,0" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

            <!-- DUY NHẤT 1 THANH BOTTOM BAR BỒNG BỀNH -->
            <components:BottomNavDockView Grid.Row="1" ActiveTab="Home" />
        </Grid>

        <!-- EVALUATE MODAL -->
        <Border BackgroundColor="#99000000" IsVisible="{Binding IsEvaluateModalVisible}" ZIndex="98" Padding="20">
            <Border Stroke="#0284C7" StrokeThickness="1" StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                    Padding="22" VerticalOptions="Center" MaximumHeightRequest="520" MaximumWidthRequest="560">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Kết Quả Đánh Giá Ma Sát Tâm Lý" FontSize="16" FontAttributes="Bold" TextColor="#0284C7" />
                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseEvaluateModalCommand}"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                TextColor="{StaticResource FintechTextMuted}" FontSize="14" FontAttributes="Bold"
                                CornerRadius="18" WidthRequest="36" HeightRequest="36" Padding="0" />
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="14">
                        <Label Text="{Binding EvaluationResult.ImpactAnalysisMessage}" FontSize="13" LineHeight="1.3"
                               TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Hạn Mức Hôm Nay Hiện Tại:" FontSize="11" TextColor="{StaticResource FintechIncome}" />
                                <Label Text="{Binding EvaluationResult.CurrentDsa, StringFormat='{0:N0} đ'}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource FintechIncome}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12" BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#450A0A}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Hạn Mức Sau Khi Mua:" FontSize="11" TextColor="{StaticResource FintechExpense}" />
                                <Label Text="{Binding EvaluationResult.DsaAfter, StringFormat='{0:N0} đ'}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource FintechExpense}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button Text="Đã Rõ" Command="{Binding CloseEvaluateModalCommand}"
                            BackgroundColor="#0284C7" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="12" HeightRequest="44" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>
        </Border>

        <!-- BYPASS MODAL -->
        <Border BackgroundColor="#99000000" IsVisible="{Binding IsBypassModalVisible}" ZIndex="99" Padding="20">
            <Border Stroke="{StaticResource FintechExpense}" StrokeThickness="1" StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                    Padding="22" VerticalOptions="Center" MaximumWidthRequest="560">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Mở Khóa Khẩn Cấp Khoản Chi" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource FintechExpense}" />
                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseBypassModalCommand}"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                TextColor="{StaticResource FintechTextMuted}" FontSize="14" FontAttributes="Bold"
                                CornerRadius="18" WidthRequest="36" HeightRequest="36" Padding="0" />
                    </Grid>

                    <Label Text="Khoảng trễ tâm lý được thiết kế để bảo vệ bạn khỏi chi tiêu bốc đồng. Để mở khóa ngay lập tức và trừ tiền ví, bạn bắt buộc phải nhập lý do khẩn cấp chính đáng."
                           Style="{StaticResource FintechCaptionStyle}" />

                    <Label Text="{Binding SelectedItem.Description, StringFormat='Khoản chi: {0}'}" FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}" />

                    <Border Stroke="{AppThemeBinding Light={StaticResource FintechBorderLight}, Dark={StaticResource FintechBorderDark}}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource FintechSurfaceLight}, Dark={StaticResource FintechSurfaceDark}}"
                            Padding="12,6">
                        <Editor Text="{Binding BypassReason}" Placeholder="Nhập lý do khẩn cấp..."
                                TextColor="{AppThemeBinding Light={StaticResource FintechTextPrimaryLight}, Dark={StaticResource FintechTextPrimaryDark}}"
                                BackgroundColor="Transparent" HeightRequest="90" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                        <Button Grid.Column="0" Text="Hủy Bỏ" Command="{Binding CloseBypassModalCommand}"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                TextColor="{StaticResource FintechTextMuted}" CornerRadius="12" HeightRequest="44" />

                        <Button Grid.Column="1" Text="Xác Nhận Mở Khóa" Command="{Binding SubmitBypassCommand}"
                                BackgroundColor="{StaticResource FintechExpense}" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="12" HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Border>
    </Grid>
</ContentPage>