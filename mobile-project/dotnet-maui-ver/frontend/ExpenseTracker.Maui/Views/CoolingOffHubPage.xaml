<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Maui.Models.Behavioral"
             x:Class="ExpenseTracker.Maui.Views.CoolingOffHubPage"
             x:DataType="vm:CoolingOffHubViewModel"
             Title="{Binding Title}"
             BackgroundColor="#0F172A">

    <Grid>
        <!-- MAIN CONTENT SCROLLVIEW -->
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="16,12">

                <!-- HEADER & ACTION BAR -->
                <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 16" Stroke="#334155" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Khoảng Trễ Tâm Lý 24h (Cooling-Off)" TextColor="#F8FAFC" FontSize="18" FontAttributes="Bold" />
                            <Label Text="Ma sát tích cực, quy đổi giờ lao động &amp; chống mua sắm bốc đồng" TextColor="#94A3B8" FontSize="12" />
                        </VerticalStackLayout>
                        
                        <Button Grid.Column="1" 
                                Text="Làm Mới" 
                                Command="{Binding LoadPendingTransactionsCommand}"
                                BackgroundColor="#3B82F6" 
                                TextColor="White" 
                                FontAttributes="Bold"
                                CornerRadius="10" 
                                HeightRequest="36" 
                                Padding="12,0" 
                                FontSize="12" />
                    </Grid>
                </Border>

                <!-- ERROR NOTIFICATION -->
                <Border BackgroundColor="#7F1D1D" StrokeShape="RoundRectangle 12" Stroke="#DC2626" Padding="12,8"
                        IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="#FECACA" FontSize="12" />
                </Border>

                <!-- STATUS MESSAGE -->
                <Border BackgroundColor="#064E3B" StrokeShape="RoundRectangle 12" Stroke="#059669" Padding="12,8"
                        IsVisible="{Binding StatusMessage, Converter={x:Null}}">
                    <Label Text="{Binding StatusMessage}" TextColor="#A7F3D0" FontSize="12" />
                </Border>

                <!-- SECTION 1: SANDBOX THỬ NGHIỆM KHOẢN CHI LỚN -->
                <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 16" Stroke="#334155" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="⚡ Kiểm Tra Khoản Chi Sắp Mua (Đánh Giá Ma Sát)" TextColor="#38BDF8" FontSize="15" FontAttributes="Bold" />
                        <Label Text="Nhập số tiền bạn đang muốn mua để hệ thống đo lường số giờ lao động thực tế và mức độ ảnh hưởng đến hạn mức sinh hoạt ngày (DSA)." TextColor="#94A3B8" FontSize="12" />

                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Số tiền dự chi (VNĐ):" TextColor="#94A3B8" FontSize="11" />
                                <Entry Text="{Binding TestExpenseAmount}" Keyboard="Numeric" BackgroundColor="#0F172A" TextColor="#F8FAFC" HeightRequest="40" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Đánh Giá"
                                    Command="{Binding EvaluateTestExpenseCommand}"
                                    BackgroundColor="#0284C7"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="40"
                                    VerticalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- SECTION 2: PENDING COOLING-OFF TRANSACTIONS -->
                <Label Text="Giao Dịch Đang Trong Khoảng Trễ Hạ Nhiệt" TextColor="#F59E0B" FontSize="16" FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding PendingTransactions}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 16" Stroke="#334155" Padding="24">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="🛡️" FontSize="36" HorizontalOptions="Center" />
                                <Label Text="Hiện không có giao dịch nào bị phong tỏa." TextColor="#F8FAFC" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="Mọi khoản chi tiêu trên 3,000,000 đ sẽ được kích hoạt chế độ bảo vệ tâm lý tại đây." TextColor="#94A3B8" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CoolingOffTransactionModel">
                            <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 16" Stroke="#334155" Padding="16" Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="10">
                                    <!-- Title and Countdown -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Description}" TextColor="#F8FAFC" FontSize="15" FontAttributes="Bold" />
                                            <Label Text="{Binding CategoryName, StringFormat='Danh mục: {0}'}" TextColor="#94A3B8" FontSize="12" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1" BackgroundColor="#0F172A" Stroke="#00E5FF" StrokeShape="RoundRectangle 10" Padding="10,4">
                                            <Label Text="{Binding RemainingTimeDisplay}" TextColor="#00E5FF" FontSize="12" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>

                                    <!-- Price and Work Hours Equivalency Card -->
                                    <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 12" Padding="12">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="Số tiền phong tỏa:" TextColor="#94A3B8" FontSize="11" />
                                                <Label Text="{Binding Amount, StringFormat='{0:N0} đ'}" TextColor="#F87171" FontSize="16" FontAttributes="Bold" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="Giờ làm việc tương đương:" TextColor="#94A3B8" FontSize="11" />
                                                <Label Text="{Binding EquivalentWorkHours, StringFormat='⏳ {0:N1} giờ công'}" TextColor="#FCD34D" FontSize="14" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <!-- DSA Impact Notice -->
                                    <Label Text="{Binding ProjectedDsaReduction, StringFormat='⚠️ Nếu mua, hạn mức chi tiêu mỗi ngày còn lại sẽ giảm {0:N0} đ/ngày'}" TextColor="#FB7185" FontSize="11" />

                                    <!-- Action Buttons -->
                                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                        <!-- Confirm Purchase Button -->
                                        <Button Grid.Column="0"
                                                Text="Xác Nhận Mua"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoolingOffHubViewModel}}, Path=ConfirmPurchaseCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#EA580C"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                FontSize="12" />

                                        <!-- Cancel Purchase (Save money) Button -->
                                        <Button Grid.Column="1"
                                                Text="🎉 Hủy (Giữ Tiền)"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoolingOffHubViewModel}}, Path=CancelPurchaseCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#16A34A"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                FontSize="12" />

                                        <!-- Emergency Bypass Button -->
                                        <Button Grid.Column="2"
                                                Text="Khẩn Cấp"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoolingOffHubViewModel}}, Path=OpenBypassModalCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#334155"
                                                TextColor="#FCA5A5"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                FontSize="11" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- EVALUATION RESULT MODAL POPUP -->
        <Border BackgroundColor="#CC000000" IsVisible="{Binding IsEvaluateModalVisible}" ZIndex="98" Padding="20">
            <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 20" Stroke="#0284C7" Padding="20" VerticalOptions="Center" MaximumHeightRequest="520">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Kết Quả Đánh Giá Ma Sát Tâm Lý" TextColor="#38BDF8" FontSize="16" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseEvaluateModalCommand}" BackgroundColor="Transparent" TextColor="#94A3B8" FontSize="18" Padding="0" WidthRequest="32" HeightRequest="32" />
                    </Grid>

                    <Border BackgroundColor="#0F172A" StrokeShape="RoundRectangle 12" Padding="12">
                        <Label Text="{Binding EvaluationResult.ImpactAnalysisMessage}" TextColor="#E2E8F0" FontSize="13" LineHeight="1.3" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="#0F172A" StrokeShape="RoundRectangle 10" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Hạn Mức DSA Hiện Tại:" TextColor="#94A3B8" FontSize="11" />
                                <Label Text="{Binding EvaluationResult.CurrentDsa, StringFormat='{0:N0} đ'}" TextColor="#34D399" FontSize="14" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#0F172A" StrokeShape="RoundRectangle 10" Padding="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Hạn Mức Sau Khi Mua:" TextColor="#94A3B8" FontSize="11" />
                                <Label Text="{Binding EvaluationResult.DsaAfter, StringFormat='{0:N0} đ'}" TextColor="#F87171" FontSize="14" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button Text="Đã Rõ" Command="{Binding CloseEvaluateModalCommand}" BackgroundColor="#3B82F6" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="40" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>
        </Border>

        <!-- EMERGENCY BYPASS MODAL POPUP -->
        <Border BackgroundColor="#CC000000" IsVisible="{Binding IsBypassModalVisible}" ZIndex="99" Padding="20">
            <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 20" Stroke="#E11D48" Padding="20" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="🚨 Mở Khóa Khẩn Cấp Khoản Chi" TextColor="#FB7185" FontSize="16" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseBypassModalCommand}" BackgroundColor="Transparent" TextColor="#94A3B8" FontSize="18" Padding="0" WidthRequest="32" HeightRequest="32" />
                    </Grid>

                    <Label Text="Khoảng trễ tâm lý được thiết kế để bảo vệ bạn khỏi chi tiêu bốc đồng. Để mở khóa ngay lập tức và trừ tiền ví, bạn bắt buộc phải nhập lý do khẩn cấp chính đáng." TextColor="#CBD5E1" FontSize="12" />

                    <Label Text="{Binding SelectedItem.Description, StringFormat='Khoản chi: {0}'}" TextColor="#F8FAFC" FontSize="14" FontAttributes="Bold" />

                    <Editor Text="{Binding BypassReason}" Placeholder="Nhập lý do khẩn cấp (VD: Mua thuốc điều trị cấp tính, sửa xe hỏng giữa đường...)" TextColor="#F8FAFC" PlaceholderColor="#64748B" BackgroundColor="#0F172A" HeightRequest="90" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Grid.Column="0" Text="Hủy Bỏ" Command="{Binding CloseBypassModalCommand}" BackgroundColor="#334155" TextColor="#94A3B8" CornerRadius="10" HeightRequest="40" />
                        <Button Grid.Column="1" Text="Xác Nhận Mở Khóa" Command="{Binding SubmitBypassCommand}" BackgroundColor="#E11D48" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="40" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Border>
    </Grid>
</ContentPage>
