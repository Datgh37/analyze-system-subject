<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Core Brand & Theme Colors -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryDark">#6366F1</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#EEF2FF</Color>
    <Color x:Key="SecondaryDarkText">#C7D2FE</Color>
    <Color x:Key="Tertiary">#312E81</Color>

    <!-- Luxury Dark & Light Surfaces -->
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceLightElevated">#F8FAFC</Color>
    <Color x:Key="SurfaceDark">#0F172A</Color>
    <Color x:Key="SurfaceDarkElevated">#1E293B</Color>
    <Color x:Key="SurfaceDarkCard">#182234</Color>

    <!-- Semantic Financial Accents -->
    <Color x:Key="IncomeGreen">#10B981</Color>
    <Color x:Key="IncomeGreenLight">#ECFDF5</Color>
    <Color x:Key="IncomeGreenDark">#064E3B</Color>

    <Color x:Key="ExpenseRed">#F43F5E</Color>
    <Color x:Key="ExpenseRedLight">#FFF1F2</Color>
    <Color x:Key="ExpenseRedDark">#881337</Color>

    <Color x:Key="WarningAmber">#F59E0B</Color>
    <Color x:Key="WarningAmberLight">#FFFBEB</Color>
    <Color x:Key="WarningAmberDark">#78350F</Color>

    <Color x:Key="AiPurple">#8B5CF6</Color>
    <Color x:Key="AiPurpleLight">#F5F3FF</Color>
    <Color x:Key="AiPurpleDark">#4C1D95</Color>

    <!-- Base Neutrals -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0B0F19</Color>
    <Color x:Key="OffBlack">#111827</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <!-- Compatibility Token Aliases for Clean XAML Binding -->
    <Color x:Key="PrimaryLight">#4F46E5</Color>
    <Color x:Key="PrimarySoftLight">#EEF2FF</Color>

    <Color x:Key="PageBgLight">#F8FAFC</Color>
    <Color x:Key="PageBgDark">#0B0F17</Color>
    <Color x:Key="CardBgLight">#FFFFFF</Color>
    <Color x:Key="CardBgDark">#161F30</Color>

    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="BorderDark">#26354D</Color>

    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextPrimaryDark">#FFFFFF</Color>
    <Color x:Key="TextSecondaryLight">#475569</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>
    <Color x:Key="TextMutedLight">#94A3B8</Color>
    <Color x:Key="TextMutedDark">#64748B</Color>

    <Color x:Key="NeutralLight100">#F8FAFC</Color>
    <Color x:Key="NeutralDark900">#0B0F17</Color>
    <Color x:Key="Neutral100">#F1F5F9</Color>
    <Color x:Key="Neutral200">#E2E8F0</Color>
    <Color x:Key="Neutral700">#334155</Color>
    <Color x:Key="Neutral800">#1E293B</Color>
    <Color x:Key="Neutral900">#0F172A</Color>

    <Color x:Key="Emerald100">#ECFDF5</Color>
    <Color x:Key="Emerald500">#10B981</Color>
    <Color x:Key="Emerald700">#047857</Color>

    <Color x:Key="FintechBorder">#E2E8F0</Color>
    <Color x:Key="FintechSurfaceElevated">#F1F5F9</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="IncomeGreenBrush" Color="{StaticResource IncomeGreen}"/>
    <SolidColorBrush x:Key="ExpenseRedBrush" Color="{StaticResource ExpenseRed}"/>
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}"/>
    <SolidColorBrush x:Key="AiPurpleBrush" Color="{StaticResource AiPurple}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
