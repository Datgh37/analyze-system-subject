<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMaui>true</UseMaui>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Refit" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile ViewModels, Repositories, and Models directly for pure, cross-platform unit testing -->
    <Compile Include="..\..\ExpenseTracker.Maui\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\ExpenseTracker.Maui\Repositories\**\*.cs" Link="Repositories\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\BaseViewModel.cs" Link="ViewModels\BaseViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\WalletsViewModel.cs" Link="ViewModels\WalletsViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\ExpensesViewModel.cs" Link="ViewModels\ExpensesViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\BudgetsViewModel.cs" Link="ViewModels\BudgetsViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\NotificationHistoryViewModel.cs" Link="ViewModels\NotificationHistoryViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\ReportsViewModel.cs" Link="ViewModels\ReportsViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\ForecastingViewModel.cs" Link="ViewModels\ForecastingViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\NudgeFeedViewModel.cs" Link="ViewModels\NudgeFeedViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\CoolingOffHubViewModel.cs" Link="ViewModels\CoolingOffHubViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\ImportExport\ImportPreviewViewModel.cs" Link="ViewModels\ImportExport\ImportPreviewViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\AiAgent\VoiceFloatingMicViewModel.cs" Link="ViewModels\AiAgent\VoiceFloatingMicViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\Autonomous\ActionInboxViewModel.cs" Link="ViewModels\Autonomous\ActionInboxViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\Services\Realtime\Messages\RealtimeMessages.cs" Link="Services\Realtime\Messages\RealtimeMessages.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\Services\Api\IApiClients.cs" Link="Services\Api\IApiClients.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\Services\Security\SecureStorageTokenService.cs" Link="Services\Security\SecureStorageTokenService.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\Services\Auth\ClientAuthService.cs" Link="Services\Auth\ClientAuthService.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\VerifyOtpViewModel.cs" Link="ViewModels\VerifyOtpViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\LoginViewModel.cs" Link="ViewModels\LoginViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\ViewModels\RegisterViewModel.cs" Link="ViewModels\RegisterViewModel.cs" />
    <Compile Include="..\..\ExpenseTracker.Maui\Services\Notifications\INativeNotificationService.cs" Link="Services\Notifications\INativeNotificationService.cs" />
  </ItemGroup>

</Project>
